{
  "_version": "1.65.0",
  "sap.app": {
    "id": "com.rprincipees.registroavescombate",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:basic",
      "version": "1.17.1",
      "toolsId": "d0e8d886-1ff6-4ded-9c7c-02cfcc3e071a"
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "images/icons/adult-bird.svg",
      "favIcon": "images/icons/adult-bird.svg",
      "phone": "images/icons/adult-bird.svg",
      "phone@2": "images/icons/adult-bird.svg",
      "tablet": "images/icons/adult-bird.svg",
      "tablet@2": "images/icons/adult-bird.svg"
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": false,
    "dependencies": {
      "minUI5Version": "1.139.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.ui.layout": {},
        "sap.f": {},
        "sap.ui.unified": {},
        "sap.tnt": {},
        "sap.suite.ui.commons": {},
        "sap.ui.export": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "com.rprincipees.registroavescombate.i18n.i18n"
        }
      },
      "dashboard": {
				"type": "sap.ui.model.json.JSONModel",
				"preload": false
			}
    },
    "resources": {
      "css": [
        {
          "uri": "css/style.css"
        }
      ]
    },
    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "controlAggregation": "pages",
        "controlId": "app",
        "transition": "slide",
        "type": "View",
        "viewType": "XML",
        "path": "com.rprincipees.registroavescombate.view",
        "async": true,
        "viewPath": "com.rprincipees.registroavescombate.view"
      },
      "routes": [
        {
          "name": "RouteLogin",
          "pattern": "",
          "target": [
            "TargetLogin"
          ]
        },
        {
          "name": "RouteRegister",
          "pattern": "register",
          "target": [
            "TargetRegister"
          ]
        },
        {
          "name": "RouteWelcome",
          "pattern": "welcome",
          "target": [
            "TargetWelcome"
          ]
        },
        {
          "name": "RouteList",
          "pattern": "list",
          "target": [
            "TargetList"
          ]
        },
        {
          "name": "RouteAveCreate",
          "pattern": "aves/crear",
          "target": [
            "TargetAveCreate"
          ]
        },
        {
          "name": "RoutePollitos",
          "pattern": "pollitos",
          "target": [
            "TargetPollitos"
          ]
        },
        {
          "name": "RoutePollitoCreate",
          "pattern": "pollitos/crear",
          "target": [
            "TargetPollitoForm"
          ]
        },
        {
          "name": "RoutePollitoDetail",
          "pattern": "pollitos/{pollitoId}",
          "target": [
            "TargetPollitoDetail"
          ]
        },
        {
          "name": "RoutePollitoEdit",
          "pattern": "pollitos/{pollitoId}/editar",
          "target": [
            "TargetPollitoForm"
          ]
        },
        {
          "name": "RouteAveDetail",
          "pattern": "aves/{aveId}",
          "target": [
            "TargetAveDetail"
          ]
        },
        {
          "name": "RouteAveUpdate",
          "pattern": "aves/{aveId}/editar",
          "target": [
            "TargetAveUpdate"
          ]
        },
        {
          "pattern": "forgot-password",
          "name": "RouteForgotPassword",
          "target": [
            "TargetForgotPassword"
          ]
        },
        {
          "pattern": "reset-password/{token}",
          "name": "RouteResetPassword",
          "target": [
            "TargetResetPassword"
          ]
        },
        {
          "pattern": "incubaciones",
          "name": "RouteIncubacionList",
          "target": "TargetIncubacionList"
        },
        {
          "pattern": "incubaciones/create",
          "name": "RouteIncubacionCreate",
          "target": "TargetIncubacionForm"
        },
        {
          "pattern": "incubaciones/edit/{id}",
          "name": "RouteIncubacionEdit",
          "target": "TargetIncubacionForm"
        },
        {
          "pattern": "incubaciones/reprogramar/{id}",
          "name": "RouteIncubacionReprogramar",
          "target": "TargetIncubacionForm"
        },
        {
          "pattern": "incubaciones/detail/{id}",
          "name": "RouteIncubacionDetail",
          "target": "TargetIncubacionDetail"
        },
        {
          "pattern": "planes-cruce",
          "name": "RoutePlanesCruce",
          "target": "TargetPlanesCruce"
        },
        {
          "pattern": "reportes",
          "name": "RouteReportes",
          "target": "TargetReportes"
        },
        {
          "pattern": "combates",
          "name": "RouteCombates",
          "target": "TargetCombates"
        },
        {
          "pattern": "combates/create",
          "name": "RouteCombateCreate",
          "target": "TargetCombateForm"
        },
        {
          "pattern": "combates/edit/{id}",
          "name": "RouteCombateEdit",
          "target": "TargetCombateForm"
        },
        {
          "pattern": "combates/detail/{id}",
          "name": "RouteCombateDetail",
          "target": "TargetCombateDetail"
        },
        {
          "pattern": "suscripcion",
          "name": "RouteSuscripcion",
          "target": "TargetSuscripcion"
        },
        {
          "pattern": "cuenta",
          "name": "RouteAccountSettings",
          "target": "TargetAccountSettings"
        },
        {
          "pattern": "genealogia:?query:",
          "name": "RouteGenealogia",
          "target": "TargetGenealogia"
        },
        {
          "pattern": "lineas",
          "name": "RouteLineaGallos",
          "target": "TargetLineaGallos"
        },
        {
          "pattern": "lineas/create",
          "name": "RouteLineaGalloCreate",
          "target": "TargetLineaGalloForm"
        },
        {
          "pattern": "lineas/edit/{id}",
          "name": "RouteLineaGalloEdit",
          "target": "TargetLineaGalloForm"
        },
        {
          "pattern": "lineas/detail/{id}",
          "name": "RouteLineaGalloDetail",
          "target": "TargetLineaGalloDetail"
        },
        {
          "pattern": "lineas-gallos/{lineaId}/nuevo-cruce",
          "name": "RoutelineaGallosCruceCreate",
          "target": "TargetLineaGallosCruceCreate"
        },
        {
          "pattern": "lineas-gallos/{lineaId}/cruce/{planId}/edit",
          "name": "RouteLineaGallosCruceEdit",
          "target": "TargetLineaGallosCruceCreate"
        }
      ],
      "targets": {
        "TargetLogin": {
          "id": "Login",
          "name": "Login"
        },
        "TargetRegister": {
          "id": "Register",
          "name": "Register"
        },
        "TargetWelcome": {
          "id": "Welcome",
          "name": "Welcome"
        },
        "TargetList": {
          "id": "List",
          "name": "List"
        },
        "TargetAveCreate": {
          "id": "AveCreate",
          "name": "AveCreate"
        },
        "TargetPollitos": {
          "id": "Pollitos",
          "name": "Pollitos"
        },
        "TargetPollitoForm": {
          "id": "PollitoForm",
          "name": "PollitoForm"
        },
        "TargetPollitoDetail": {
          "id": "PollitoDetail",
          "name": "PollitoDetail"
        },
        "TargetAveDetail": {
          "id": "AveDetail",
          "name": "AveDetail"
        },
        "TargetAveUpdate": {
          "id": "AveUpdate",
          "name": "AveUpdate"
        },
        "TargetForgotPassword": {
          "id": "ForgotPassword",
          "name": "ForgotPassword"
        },
        "TargetResetPassword": {
          "id": "ResetPassword",
          "name": "ResetPassword"
        },
        "TargetIncubacionList": {
          "id": "IncubacionList",
          "name": "IncubacionList"
        },
        "TargetIncubacionForm": {
          "id": "IncubacionForm",
          "name": "IncubacionForm"
        },
        "TargetIncubacionDetail": {
          "id": "IncubacionDetail",
          "name": "IncubacionDetail"
        },
        "TargetPlanesCruce": {
          "id": "PlanesCruce",
          "viewName": "PlanesCruce"
        },
        "TargetReportes": {
          "id": "Reportes",
          "viewName": "Reportes"
        },
        "TargetCombates": {
          "id": "Combates",
          "name": "Combates"
        },
        "TargetCombateForm": {
          "id": "CombateForm",
          "name": "CombateForm"
        },
        "TargetCombateDetail": {
          "id": "CombateDetail",
          "name": "CombateDetail"
        },
        "TargetSuscripcion": {
          "id": "Suscripcion",
          "viewName": "Suscripcion"
        },
        "TargetAccountSettings": {
          "id": "AccountSettings",
          "viewName": "AccountSettings"
        },
        "TargetGenealogia": {
          "id": "Genealogia",
          "viewName": "Genealogia"
        },
        "TargetLineaGallos": {
          "id": "LineaGallos",
          "viewName": "LineaGallos"
        },
        "TargetLineaGalloForm": {
          "id": "LineaGalloForm",
          "viewName": "LineaGalloForm"
        },
        "TargetLineaGalloDetail": {
          "id": "LineaGalloDetail",
          "viewName": "LineaGalloDetail"
        },
        "TargetLineaGallosCruceCreate": {
          "id": "CruceCreate",
          "viewName": "CruceCreate"
        }
      }
    },
    "rootView": {
      "viewName": "com.rprincipees.registroavescombate.view.App",
      "type": "XML",
      "id": "App",
      "async": true
    }
  }
}
