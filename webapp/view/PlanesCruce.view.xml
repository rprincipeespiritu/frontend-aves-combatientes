<mvc:View
    controllerName="com.rprincipees.registroavescombate.controller.PlanesCruce"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:form="sap.f"
    xmlns:layout="sap.ui.layout.form">

    <Page
        title="Planes de Cruce"
        showNavButton="true"
        navButtonPress=".onNavBack">
        <headerContent>
            <Button icon="sap-icon://home" press="onNavWelcome" type="Emphasized" />
            <form:Avatar
                id="userAvatar"
                src="{user>/foto}"
                displaySize="XS"
                press="onUserMenuPress"
                class="sapUiTinyMarginBegin sapUiTinyMarginEnd" />
        </headerContent>

        <content>
            <VBox class="sapUiMediumMargin">
                <!-- Toolbar -->
                <VBox>
                    <Title text="Historial de Cruces" class="planesCruceHeaderTitle" />
                    <HBox class="planesCruceHeaderActions" wrap="Wrap" justifyContent="End">
                        <Button
                            text="{= ${device>/system/phone} ? '' : 'Guia' }"
                            icon="sap-icon://sys-help"
                            type="Transparent"
                            tooltip="Guia"
                            press=".onOpenLineageGuide" />
                        <Button
                            text="{= ${device>/system/phone} ? '' : 'Cruce abierto' }"
                            icon="sap-icon://chain-link"
                            type="Transparent"
                            tooltip="Cruce abierto"
                            press=".onNuevoCruceAbierto" />
                        <Button
                            text="{= ${device>/system/phone} ? '' : 'Nuevo Plan por Linaje' }"
                            icon="sap-icon://add"
                            type="Emphasized"
                            tooltip="Nuevo Plan por Linaje"
                            press=".onNuevoPlan" />
                    </HBox>
                </VBox>

                <Panel
                    headerText="Filtros"
                    expandable="true"
                    expanded="{= ${device>/system/phone} ? false : true}"
                    width="100%"
                    class="sapUiSmallMarginTop">
                    <layout:Form editable="true" class="sapUiSmallMargin">
                        <layout:layout>
                            <layout:ResponsiveGridLayout
                                labelSpanXL="3"
                                labelSpanL="3"
                                labelSpanM="4"
                                labelSpanS="12"
                                emptySpanXL="0"
                                emptySpanL="0"
                                emptySpanM="0"
                                emptySpanS="0"
                                columnsXL="2"
                                columnsL="2"
                                columnsM="1"
                                singleContainerFullSize="true" />
                        </layout:layout>
                        <layout:formContainers>
                            <layout:FormContainer>
                                <layout:formElements>
                                    <layout:FormElement label="Codigo">
                                        <layout:fields>
                                            <SearchField
                                                width="100%"
                                                placeholder="Buscar por codigo"
                                                value="{planes>/filtros/codigo}"
                                                liveChange=".onFiltrarPlanes"
                                                search=".onFiltrarPlanes" />
                                        </layout:fields>
                                    </layout:FormElement>
                                </layout:formElements>
                            </layout:FormContainer>
                            <layout:FormContainer>
                                <layout:formElements>
                                    <layout:FormElement label="Nombre de padres">
                                        <layout:fields>
                                            <SearchField
                                                width="100%"
                                                placeholder="Nombre o placa de macho/hembra"
                                                value="{planes>/filtros/padres}"
                                                liveChange=".onFiltrarPlanes"
                                                search=".onFiltrarPlanes" />
                                        </layout:fields>
                                    </layout:FormElement>
                                    <layout:FormElement>
                                        <layout:fields>
                                            <Button
                                                text="Limpiar filtros"
                                                icon="sap-icon://clear-filter"
                                                press=".onLimpiarFiltros" />
                                        </layout:fields>
                                    </layout:FormElement>
                                </layout:formElements>
                            </layout:FormContainer>
                        </layout:formContainers>
                    </layout:Form>
                </Panel>

                <!-- Tabla -->
                <ScrollContainer
                    width="100%"
                    vertical="true"
                    horizontal="true"
                    class="listadoTablaScroll sapUiMediumMarginTop">
                <Table
                    id="planesTable"
                    width="100%"
                    inset="false"
                    items="{planes>/data}"
                    sticky="ColumnHeaders,HeaderToolbar"
                    class="listadoTabla">

                    <headerToolbar>
                        <OverflowToolbar>
                            <Title text="Planes de Cruce ({= ${planes>/data}.length})" />
                            <ToolbarSpacer />
                            <Button
                                text="{= ${device>/system/phone} ? '' : 'Exportar Excel' }"
                                icon="sap-icon://excel-attachment"
                                type="Transparent"
                                tooltip="Exportar Excel"
                                press=".onExportarExcel" />
                        </OverflowToolbar>
                    </headerToolbar>

                    <columns>
                        <Column>
                            <Text text="Codigo" />
                        </Column>
                        <Column minScreenWidth="Tablet" demandPopin="true" popinDisplay="Inline">
                            <Text text="Tipo" />
                        </Column>
                        <Column minScreenWidth="Tablet" demandPopin="true" popinDisplay="Inline">
                            <Text text="Macho" />
                        </Column>
                        <Column minScreenWidth="Tablet" demandPopin="true" popinDisplay="Inline">
                            <Text text="Hembra" />
                        </Column>
                        <Column minScreenWidth="Desktop" demandPopin="true" popinDisplay="Inline">
                            <Text text="Parentesco" />
                        </Column>
                        <Column minScreenWidth="Tablet" demandPopin="true" popinDisplay="Inline">
                            <Text text="Riesgo" />
                        </Column>
                        <Column>
                            <Text text="Decision" />
                        </Column>
                        <Column minScreenWidth="Desktop" demandPopin="true" popinDisplay="Inline">
                            <Text text="Fecha" />
                        </Column>
                        <Column hAlign="End" width="7rem">
                            <Text text="Acciones" />
                        </Column>
                    </columns>

                    <items>
                        <ColumnListItem type="Navigation" press=".onSelectPlan">
                            <cells>
                                <Text text="{= ${planes>codigo} || 'Sin codigo' }" wrapping="true" />
                                <ObjectStatus
                                    text="{
                                        parts: [
                                            { path: 'planes>tipoCruce' },
                                            { path: 'planes>linea/nombre' }
                                        ],
                                        formatter: '.formatter.formatTipoFormacionCruceTexto'
                                    }"
                                    state="{
                                        parts: [
                                            { path: 'planes>tipoCruce' },
                                            { path: 'planes>linea/nombre' }
                                        ],
                                        formatter: '.formatter.formatTipoFormacionCruceState'
                                    }" />
                                <ObjectIdentifier
                                    title="{planes>macho/placa}"
                                    text="{
                                        parts: [
                                            { path: 'planes>macho/nombre' },
                                            { path: 'planes>macho/apodo' }
                                        ],
                                        formatter: '.formatter.formatAveNombre'
                                    }" />
                                <ObjectIdentifier
                                    title="{planes>hembra/placa}"
                                    text="{
                                        parts: [
                                            { path: 'planes>hembra/nombre' },
                                            { path: 'planes>hembra/apodo' }
                                        ],
                                        formatter: '.formatter.formatAveNombre'
                                    }" />
                                <Text
                                    text="{
                                    path: 'planes>tipoParentesco',
                                    formatter: '.formatearParentesco'
                                }" />
                                <ObjectStatus
                                    text="{ path: 'planes>nivelRiesgo', formatter: '.formatter.formatNivelRiesgoTexto' }"
                                    state="{ path: 'planes>nivelRiesgo', formatter: '.formatter.formatNivelRiesgoState' }" />
                                <ObjectStatus
                                    text="{ path: 'planes>decision', formatter: '.formatter.formatDecisionTexto' }"
                                    state="{ path: 'planes>decision', formatter: '.formatter.formatDecisionState' }" />
                                <Text text="{planes>fechaPropuesta}" />
                                <HBox justifyContent="End" wrap="Wrap">
                                    <Button
                                        icon="sap-icon://edit"
                                        type="Emphasized"
                                        tooltip="Editar plan"
                                        press=".onEditarPlan" />
                                    <Button
                                        icon="sap-icon://delete"
                                        type="Transparent"
                                        tooltip="Eliminar plan"
                                        press=".onEliminarPlan" />
                                </HBox>
                            </cells>
                        </ColumnListItem>
                    </items>

                </Table>
                </ScrollContainer>

            </VBox>
        </content>
        <footer>
            <Toolbar>
                <ToolbarSpacer />
                <Button text="Cancelar" press="onNavBack" />
            </Toolbar>
        </footer>
    </Page>
</mvc:View>
