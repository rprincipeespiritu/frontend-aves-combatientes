<mvc:View
    controllerName="com.rprincipees.registroavescombate.controller.PlanesCruce"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:form="sap.f">

    <Page
        title="Planes de Cruce"
        showNavButton="true"
        navButtonPress=".onNavBack">
        <headerContent>
            <Button icon="sap-icon://home" press="onNavWelcome" type="Emphasized" />
            <form:Avatar
                id="userAvatar"
                src="{user>/foto}"
                displaySize="XS"
                press="onUserMenuPress"
                class="sapUiTinyMarginBegin sapUiTinyMarginEnd" />
        </headerContent>

        <content>
            <VBox class="sapUiMediumMargin">

                <!-- Toolbar -->
                <VBox>
                    <Title text="Historial de Cruces" class="planesCruceHeaderTitle" />
                    <HBox class="planesCruceHeaderActions" wrap="Wrap" justifyContent="End">
                        <Button
                            text="Cruce abierto"
                            icon="sap-icon://chain-link"
                            type="Transparent"
                            press=".onNuevoCruceAbierto" />
                        <Button
                            text="Nuevo Plan por Linaje"
                            icon="sap-icon://add"
                            type="Emphasized"
                            press=".onNuevoPlan" />
                    </HBox>
                </VBox>

                <!-- Tabla -->
                <Table
                    id="planesTable"
                    width="100%"
                    inset="false"
                    items="{planes>/data}"
                    class="sapUiMediumMarginTop">

                    <headerToolbar>
                        <OverflowToolbar>
                            <Title text="Planes de Cruce ({= ${planes>/data}.length})" />
                        </OverflowToolbar>
                    </headerToolbar>

                    <columns>
                        <Column demandPopin="true" minScreenWidth="Tablet">
                            <Text text="Codigo" />
                        </Column>
                        <Column>
                            <Text text="Tipo" />
                        </Column>
                        <Column demandPopin="true" minScreenWidth="Tablet">
                            <Text text="Macho" />
                        </Column>
                        <Column demandPopin="true" minScreenWidth="Tablet">
                            <Text text="Hembra" />
                        </Column>
                        <Column demandPopin="true" minScreenWidth="Tablet">
                            <Text text="Parentesco" />
                        </Column>
                        <Column demandPopin="true" minScreenWidth="Tablet">
                            <Text text="Riesgo" />
                        </Column>
                        <Column>
                            <Text text="Decision" />
                        </Column>
                        <Column demandPopin="true" minScreenWidth="Tablet">
                            <Text text="Fecha" />
                        </Column>
                        <Column hAlign="Center" width="8rem">
                            <Text text="Acciones" />
                        </Column>
                    </columns>

                    <items>
                        <ColumnListItem type="Active" press=".onSelectPlan">
                            <cells>
                                <Text text="{= ${planes>codigo} || 'Sin codigo' }" />
                                <ObjectStatus
                                    text="{ path: 'planes>linea/nombre', formatter: '.formatter.formatTipoCruceTexto' }"
                                    state="{ path: 'planes>linea/nombre', formatter: '.formatter.formatTipoCruceState' }" />
                                <ObjectIdentifier
                                    title="{planes>macho/placa}"
                                    text="{
                                        parts: [
                                            { path: 'planes>macho/nombre' },
                                            { path: 'planes>macho/apodo' }
                                        ],
                                        formatter: '.formatter.formatAveNombre'
                                    }" />
                                <ObjectIdentifier
                                    title="{planes>hembra/placa}"
                                    text="{
                                        parts: [
                                            { path: 'planes>hembra/nombre' },
                                            { path: 'planes>hembra/apodo' }
                                        ],
                                        formatter: '.formatter.formatAveNombre'
                                    }" />
                                <Text
                                    text="{
                                    path: 'planes>tipoParentesco',
                                    formatter: '.formatearParentesco'
                                }" />
                                <ObjectStatus
                                    text="{ path: 'planes>nivelRiesgo', formatter: '.formatter.formatNivelRiesgoTexto' }"
                                    state="{ path: 'planes>nivelRiesgo', formatter: '.formatter.formatNivelRiesgoState' }" />
                                <ObjectStatus
                                    text="{ path: 'planes>decision', formatter: '.formatter.formatDecisionTexto' }"
                                    state="{ path: 'planes>decision', formatter: '.formatter.formatDecisionState' }" />
                                <Text text="{planes>fechaPropuesta}" />
                                <HBox justifyContent="Center">
                                    <Button
                                        icon="sap-icon://edit"
                                        type="Emphasized"
                                        tooltip="Editar plan"
                                        press=".onEditarPlan" />
                                    <Button
                                        icon="sap-icon://delete"
                                        type="Transparent"
                                        tooltip="Eliminar plan"
                                        press=".onEliminarPlan" />
                                </HBox>
                            </cells>
                        </ColumnListItem>
                    </items>

                </Table>

            </VBox>
        </content>
        <footer>
            <Toolbar>
                <ToolbarSpacer />
                <Button text="Cancelar" press="onNavBack" />
            </Toolbar>
        </footer>
    </Page>
</mvc:View>
