<mvc:View
        controllerName="com.rprincipees.registroavescombate.controller.PlanesCruce"
        xmlns:mvc="sap.ui.core.mvc"
        xmlns="sap.m"
        xmlns:core="sap.ui.core">

    <Page
            title="Planes de Cruce"
            showNavButton="true"
            navButtonPress=".onNavBack">

        <content>
            <VBox class="sapUiMediumMargin">

                <!-- Toolbar -->
                <Toolbar>
                    <Title text="Historial de Cruces"/>
                    <ToolbarSpacer/>
                    <Button
                            text="Nuevo Plan"
                            icon="sap-icon://add"
                            press=".onNuevoPlan"/>
                </Toolbar>

                <!-- Tabla -->
                <Table
                        id="planesTable"
                        width="100%"
                        inset="false"
                        items="{planes>/data}"
                        class="sapUiMediumMarginTop">

                    <headerToolbar>
                        <OverflowToolbar>
                            <Title text="Planes de Cruce ({= ${planes>/data}.length})"/>
                        </OverflowToolbar>
                    </headerToolbar>

                    <columns>
                        <Column>
                            <Text text="Codigo"/>
                        </Column>
                        <Column>
                            <Text text="Macho"/>
                        </Column>
                        <Column>
                            <Text text="Hembra"/>
                        </Column>
                        <Column>
                            <Text text="Parentesco"/>
                        </Column>
                        <Column>
                            <Text text="Riesgo"/>
                        </Column>
                        <Column>
                            <Text text="Decision"/>
                        </Column>
                        <Column>
                            <Text text="Fecha"/>
                        </Column>
                    </columns>

                    <items>
                        <ColumnListItem type="Active" press=".onSelectPlan">
                            <cells>
                                <Text text="{= ${planes>codigo} || 'Sin codigo' }"/>
                                <Text text="{planes>macho/placa}"/>
                                <Text text="{planes>hembra/placa}"/>
                                <Text text="{planes>tipoParentesco}"/>
                                <ObjectStatus
                                        text="{planes>nivelRiesgo}"
                                        state="{
                                        = ${planes>nivelRiesgo} === 'ALTO' ? 'Error' :
                                          ${planes>nivelRiesgo} === 'MODERADO' ? 'Warning' :
                                          'Success'
                                    }"/>
                                <ObjectStatus
                                        text="{planes>decision}"
                                        state="{
                                        = ${planes>decision} === 'NO_RECOMENDADO' ? 'Error' :
                                          ${planes>decision} === 'OBSERVAR' ? 'Warning' :
                                          'Success'
                                    }"/>
                                <Text text="{planes>fechaPropuesta}"/>
                            </cells>
                        </ColumnListItem>
                    </items>

                </Table>

            </VBox>
        </content>
    </Page>
</mvc:View>
