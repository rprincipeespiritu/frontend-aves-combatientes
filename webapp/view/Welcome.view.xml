<mvc:View
    controllerName="com.rprincipees.registroavescombate.controller.Welcome"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:core="sap.ui.core">

    <Page>
        <headerContent>
            <f:Avatar
                id="userAvatar"
                src="{user>/foto}"
                displaySize="XS"
                press="onUserMenuPress"
                class="sapUiTinyMarginBegin sapUiTinyMarginEnd" />
        </headerContent>
        <content>
            <ScrollContainer height="100%" vertical="true">
                <VBox class="sapUiMediumMargin">
                    <HBox width="100%" wrap="Wrap" justifyContent="Center" alignItems="Center">
                        <Title text="Gestión de Aves Combatientes" level="H1" class="homeMainTitle" />
                    </HBox>
                    <!-- HERO / BIENVENIDA -->
                    <Panel class="sapUiResponsiveMargin sapUiNoContentPadding">
                        <content>
                            <VBox class="dashboardHero sapUiMediumMargin" wrap="Wrap">
                                <Title text="Gestiona tu criadero de forma inteligente" level="H2" />
                                <Text
                                    text="Controla aves, incubaciones y seguimiento reproductivo desde un solo lugar."
                                    class="sapUiSmallMarginTop sapUiSmallMarginBottom" />
                                <HBox class="sapUiSmallMarginTop" wrap="Wrap"
                                    visible="{dashboard>/accesoSuscripcion}">
                                    <Button text="Agregar Ave Adulta" type="Emphasized" icon="sap-icon://add"
                                        press="onNavNewBird" />
                                    <Button text="Agregar Ave jóven" type="Emphasized"
                                        icon="sap-icon://add"
                                        press="onNavNewPollito" class="sapUiTinyMarginBegin" />
                                    <Button text="Agregar Incubación" type="Emphasized"
                                        icon="sap-icon://add"
                                        press="onNavNewIncubation" class="sapUiTinyMarginBegin" />
                                    <Button text="Agregar Linaje" type="Emphasized"
                                        icon="sap-icon://add"
                                        press="onNavLineasGallosCreate" class="sapUiTinyMarginBegin"
                                        visible="{= ${dashboard>/accesoSuscripcion} &amp;&amp; ${dashboard>/plan} === 'PRO'}" />
                                </HBox>
                            </VBox>
                        </content>
                    </Panel>

                    <!-- KPIS -->
                    <HBox wrap="Wrap" justifyContent="SpaceAround" class="sapUiSmallMarginTop">
                        <GenericTile class="sapUiSmallMarginTop" header="Aves Adultas"
                            subheader="Registros por Placa" press="onNavBirdList"
                            visible="{dashboard>/accesoSuscripcion}">
                            <TileContent>
                                <NumericContent value="{dashboard>/totalAves}"
                                    icon="images/icons/adult-bird.svg" />
                            </TileContent>
                        </GenericTile>

                        <GenericTile class="sapUiSmallMarginTop" header="Linaje de Aves"
                            subheader="Registradas" press="onNavLineasGallosList"
                            visible="{= ${dashboard>/accesoSuscripcion} &amp;&amp; ${dashboard>/plan} === 'PRO'}">
                            <TileContent>
                                <NumericContent value="{dashboard>/totalLineas}"
                                    icon="sap-icon://tree" />
                            </TileContent>
                        </GenericTile>

                        <GenericTile class="sapUiSmallMarginTop" header="Planes de Cruce"
                            subheader="Ver historial" press=".onVerPlanesCruce"
                            visible="{= ${dashboard>/accesoSuscripcion} &amp;&amp; ${dashboard>/plan} === 'PRO'}">
                            <TileContent>
                                <NumericContent value="{dashboard>/totalPlanes}"
                                    icon="sap-icon://table-view" />
                            </TileContent>
                        </GenericTile>

                        <GenericTile class="sapUiSmallMarginTop" header="Incubaciones"
                            subheader="Totales" press="onNavIncubationList"
                            visible="{dashboard>/accesoSuscripcion}">
                            <TileContent>
                                <NumericContent value="{dashboard>/totalIncubaciones}"
                                    icon="images/icons/incubation-eggs.svg" />
                            </TileContent>
                        </GenericTile>

                        <GenericTile class="sapUiSmallMarginTop" header="Incubaciones"
                            subheader="En proceso" press="onNavIncubationListProcess"
                            visible="{dashboard>/accesoSuscripcion}">
                            <TileContent>
                                <NumericContent value="{dashboard>/incubacionesActivas}"
                                    icon="images/icons/hatching-process.svg" />
                            </TileContent>
                        </GenericTile>

                        <GenericTile class="sapUiSmallMarginTop" header="Reportes" subheader=""
                            press="onVerReportes"
                            visible="{= ${dashboard>/accesoSuscripcion} &amp;&amp; ${dashboard>/plan} === 'PRO'}">
                            <TileContent>
                                <ImageContent src="sap-icon://business-objects-experience" />
                            </TileContent>
                        </GenericTile>

                        <GenericTile class="sapUiSmallMarginTop" header="Genealogía"
                            subheader="Arbol genealógico" press="onVerGenealogia"
                            visible="{= ${dashboard>/accesoSuscripcion} &amp;&amp; ${dashboard>/plan} === 'PRO'}">
                            <TileContent>
                                <ImageContent src="sap-icon://org-chart" />
                            </TileContent>
                        </GenericTile>

                        <GenericTile class="sapUiSmallMarginTop" header="Aves Jóvenes"
                            subheader="Registros por cintillo" press="onNavPollitos"
                            visible="{dashboard>/accesoSuscripcion}">
                            <TileContent>
                                <NumericContent value="{dashboard>/totalPollitos}"
                                    icon="images/icons/young-chick.svg" />
                                <!-- <ImageContent src="sap-icon://collaborate" /> -->
                            </TileContent>
                        </GenericTile>
                        <GenericTile class="sapUiSmallMarginTop" header="Suscripción"
                            subheader="{dashboard>/suscripcionTexto}" press="onVerSuscripcion"
                            visible="true">
                            <TileContent>
                                <NumericContent value="{dashboard>/suscripcionDias}"
                                    scale="dias" icon="images/icons/subscription-plan.svg" />
                            </TileContent>
                        </GenericTile>
                    </HBox>
                    <!-- ALERTAS -->
                    <VBox class="sapUiSmallMarginTop" visible="{dashboard>/accesoSuscripcion}">
                        <MessageStrip
                            text="{dashboard>/alertaIncubaciones}"
                            type="Warning"
                            visible="{= !!${dashboard>/alertaIncubaciones} }"
                            showIcon="true"
                            class="sapUiSmallMarginBottom" />

                        <MessageStrip
                            text="{dashboard>/alertaEclosion}"
                            type="Information"
                            visible="{= !!${dashboard>/alertaEclosion} }"
                            showIcon="true" />
                    </VBox>

                    <!-- BLOQUE CENTRAL -->
                    <HBox wrap="Wrap" class="sapUiMediumMarginTop" justifyContent="SpaceBetween" visible="{dashboard>/accesoSuscripcion}">

                        <!-- INCUBACIONES RECIENTES -->
                        <Panel headerText="Incubaciones recientes" width="auto" class="panelSpacing">
                            <content>
                                <Table items="{dashboard>/incubacionesRecientes}"
                                    noDataText="Sin incubaciones recientes">
                                    <columns>
                                        <Column>
                                            <Text text="Código" />
                                        </Column>
                                        <Column>
                                            <Text text="Estado" />
                                        </Column>
                                        <Column>
                                            <Text text="Fecha Incub." />
                                        </Column>
                                    </columns>

                                    <items>
                                        <ColumnListItem type="Navigation"
                                            press="onAbrirIncubacionDetalle">
                                            <cells>
                                                <Text text="{dashboard>codigo}" />
                                                <ObjectStatus
                                                    text="{dashboard>estadoTexto}"
                                                    state="{dashboard>estadoState}" />
                                                <Text text="{dashboard>fechaIncubacionFmt}" />
                                            </cells>
                                        </ColumnListItem>
                                    </items>
                                </Table>
                            </content>
                        </Panel>

                        <!-- RESUMEN / ATAJOS -->
                        <Panel headerText="Resumen rápido" width="auto" class="panelSpacing">
                            <content>
                                <List>
                                    <StandardListItem
                                        title="Aves activas"
                                        info="{dashboard>/totalAvesActivas}"
                                        icon="images/icons/adult-bird.svg" />
                                    <StandardListItem
                                        title="Incubaciones programadas"
                                        info="{dashboard>/incubacionesProgramadas}"
                                        icon="images/icons/incubation-eggs.svg" />
                                    <StandardListItem
                                        title="Incubaciones en proceso"
                                        info="{dashboard>/incubacionesActivas}"
                                        icon="images/icons/hatching-process.svg" />
                                    <StandardListItem
                                        title="Nacimientos acumulados"
                                        info="{dashboard>/totalNacidos}"
                                        icon="images/icons/young-chick.svg" />
                                </List>
                            </content>
                        </Panel>
                    </HBox>

                </VBox>
            </ScrollContainer>
        </content>
    </Page>
</mvc:View>
