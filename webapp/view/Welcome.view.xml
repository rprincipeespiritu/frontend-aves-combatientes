<mvc:View
    controllerName="com.rprincipees.registroavescombate.controller.Welcome"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:core="sap.ui.core">

    <Page>
        <headerContent>
            <f:Avatar
                id="userAvatar"
                src="{user>/foto}"
                displaySize="XS"
                press="onUserMenuPress"
                class="sapUiTinyMarginBegin sapUiTinyMarginEnd" />
        </headerContent>
        <content>
            <ScrollContainer height="100%" vertical="true" horizontal="false">
                <VBox class="welcomePageContent sapUiMediumMargin">
                    <HBox width="100%" wrap="Wrap" justifyContent="Center" alignItems="Center">
                        <Title text="Registro y Linaje de Aves" level="H1" class="homeMainTitle" />
                    </HBox>
                    <!-- HERO / BIENVENIDA -->
                    <Panel class="welcomeHeroPanel sapUiResponsiveMargin sapUiNoContentPadding">
                        <content>
                            <VBox class="dashboardHero sapUiMediumMargin" wrap="Wrap">
                                <Title text="Controla tu criadero de forma fácil y eficiente" level="H2" />
                                <Text
                                    text="Controla el registro de aves adultas y jóvenes, linajes, planes de cruce, incubaciones, genealogía, combates, estadísticas y reportes."
                                    class="sapUiSmallMarginTop sapUiSmallMarginBottom" />
                                <HBox class="heroActionBar sapUiSmallMarginTop" wrap="Wrap"
                                    visible="{dashboard>/accesoSuscripcion}">
                                    <Button text="Agregar Ave Adulta" type="Emphasized" icon="sap-icon://add"
                                        press="onNavNewBird" class="heroActionButton" />
                                    <Button text="Agregar Ave Jóven o Recién Nacido" type="Emphasized"
                                        icon="sap-icon://add"
                                        press="onNavNewPollito" class="heroActionButton" />
                                    <Button text="Agregar Incubación" type="Emphasized"
                                        icon="sap-icon://add"
                                        press="onNavNewIncubation" class="heroActionButton" />
                                    <Button text="Agregar Linaje" type="Emphasized"
                                        icon="sap-icon://add"
                                        press="onNavNewLine" class="heroActionButton"
                                        visible="{= ${dashboard>/accesoSuscripcion} &amp;&amp; (${dashboard>/plan} === 'PRUEBA' || ${dashboard>/plan} === 'PRO' || ${dashboard>/plan} === 'PREMIUM') }" />
                                </HBox>
                            </VBox>
                        </content>
                    </Panel>

                    <!-- KPIS -->
                    <HBox wrap="Wrap" justifyContent="SpaceAround" class="dashboardTiles sapUiSmallMarginTop">
                        <GenericTile class="sapUiSmallMarginTop" header="Aves Adultas"
                            subheader="Registros por placa" press="onNavBirdList"
                            visible="{dashboard>/accesoSuscripcion}">
                            <TileContent>
                                <NumericContent value="{dashboard>/totalAves}"
                                    icon="images/icons/adult-bird.svg" />
                            </TileContent>
                        </GenericTile>

                        <GenericTile class="sapUiSmallMarginTop" header="Aves Jóvenes"
                            subheader="Registros por cintillo" press="onNavPollitos"
                            visible="{dashboard>/accesoSuscripcion}">
                            <TileContent>
                                <NumericContent value="{dashboard>/totalPollitos}"
                                    icon="images/icons/young-chick.svg" />
                                <!-- <ImageContent src="sap-icon://collaborate" /> -->
                            </TileContent>
                        </GenericTile>

                        <GenericTile class="sapUiSmallMarginTop dashboardPhotoIconTile" header="Linaje de Aves"
                            subheader="Registradas" press="onNavLineasGallosList"
                            visible="{= ${dashboard>/accesoSuscripcion} &amp;&amp; (${dashboard>/plan} === 'PRUEBA' || ${dashboard>/plan} === 'PRO' || ${dashboard>/plan} === 'PREMIUM') }">
                            <TileContent>
                                <NumericContent value="{dashboard>/totalLineas}"
                                    icon="images/icons/bird-lineage.svg" />
                            </TileContent>
                        </GenericTile>

                        <GenericTile class="sapUiSmallMarginTop dashboardPhotoIconTile" header="Planes de Cruce"
                            subheader="Ver historial" press=".onVerPlanesCruce"
                            visible="{= ${dashboard>/accesoSuscripcion} &amp;&amp; (${dashboard>/plan} === 'PRUEBA' || ${dashboard>/plan} === 'PRO' || ${dashboard>/plan} === 'PREMIUM') }">
                            <TileContent>
                                <NumericContent value="{dashboard>/totalPlanes}"
                                    icon="images/icons/crossing-plans.svg" />
                            </TileContent>
                        </GenericTile>

                        <GenericTile class="sapUiSmallMarginTop" header="Incubaciones"
                            subheader="Totales" press="onNavIncubationList"
                            visible="{dashboard>/accesoSuscripcion}">
                            <TileContent>
                                <NumericContent value="{dashboard>/totalIncubaciones}"
                                    icon="images/icons/incubation-eggs.svg" />
                            </TileContent>
                        </GenericTile>

                        <GenericTile class="sapUiSmallMarginTop" header="Incubaciones"
                            subheader="En proceso" press="onNavIncubationListProcess"
                            visible="false">
                            <TileContent>
                                <NumericContent value="{dashboard>/incubacionesActivas}"
                                    icon="images/icons/hatching-process.svg" />
                            </TileContent>
                        </GenericTile>

                        <GenericTile class="sapUiSmallMarginTop" header="Reportes" subheader=""
                            press="onVerReportes"
                            visible="{= ${dashboard>/accesoSuscripcion} &amp;&amp; (${dashboard>/plan} === 'PRUEBA' || ${dashboard>/plan} === 'PRO' || ${dashboard>/plan} === 'PREMIUM') }">
                            <TileContent>
                                <ImageContent src="images/icons/reports.svg" />
                            </TileContent>
                        </GenericTile>

                        <GenericTile class="sapUiSmallMarginTop" header="Genealogía"
                            subheader="Arbol genealógico" press="onVerGenealogia"
                            visible="{= ${dashboard>/accesoSuscripcion} &amp;&amp; (${dashboard>/plan} === 'PRUEBA' || ${dashboard>/plan} === 'PRO' || ${dashboard>/plan} === 'PREMIUM') }">
                            <TileContent>
                                <ImageContent src="images/icons/genealogy.svg" />                                
                            </TileContent>
                        </GenericTile>

                        <GenericTile class="sapUiSmallMarginTop" header="Estadísticas"
                            subheader="Rendimiento por linaje" press="onVerEstadisticasPeleas"
                            visible="{= ${dashboard>/accesoSuscripcion} &amp;&amp; (${dashboard>/plan} === 'PRUEBA' || ${dashboard>/plan} === 'PRO' || ${dashboard>/plan} === 'PREMIUM') }">
                            <TileContent>
                                <ImageContent src="images/icons/combats.svg" />
                            </TileContent>
                        </GenericTile>

                        <GenericTile class="sapUiSmallMarginTop" header="Combates"
                            subheader="Historial de encuentros" press="onVerCombates"
                            visible="{= ${dashboard>/accesoSuscripcion} &amp;&amp; (${dashboard>/plan} === 'PRUEBA' || ${dashboard>/plan} === 'PREMIUM') }">
                            <TileContent>
                                <NumericContent value="{dashboard>/totalCombates}"
                                    icon="images/icons/combats.svg" />
                            </TileContent>
                        </GenericTile>
                        <GenericTile class="sapUiSmallMarginTop" header="Suscripción"
                            subheader="{dashboard>/suscripcionTexto}" press="onVerSuscripcion"
                            visible="true">
                            <TileContent>
                                <NumericContent value="{dashboard>/suscripcionDias}"
                                    scale="dias" icon="images/icons/subscription-plan.svg" />
                            </TileContent>
                        </GenericTile>
                    </HBox>
                    <!-- ALERTAS -->
                    <VBox class="sapUiSmallMarginTop" visible="{dashboard>/accesoSuscripcion}">
                        <MessageStrip
                            text="{dashboard>/alertaIncubaciones}"
                            type="Warning"
                            visible="{= !!${dashboard>/alertaIncubaciones} }"
                            showIcon="true"
                            class="sapUiSmallMarginBottom" />

                        <MessageStrip
                            text="{dashboard>/alertaEclosion}"
                            type="Information"
                            visible="{= !!${dashboard>/alertaEclosion} }"
                            showIcon="true" />
                    </VBox>

                    <!-- BLOQUE CENTRAL -->
                    <HBox wrap="Wrap" class="sapUiMediumMarginTop welcomeCentralBlock" justifyContent="SpaceBetween" visible="{dashboard>/accesoSuscripcion}">

                        <!-- INCUBACIONES RECIENTES -->
                        <Panel headerText="Incubaciones recientes" width="100%" class="panelSpacing">
                            <content>
                                <Table items="{dashboard>/incubacionesRecientes}"
                                    noDataText="Sin incubaciones recientes"
                                    width="100%">
                                    <columns>
                                        <Column>
                                            <Text text="Código" />
                                        </Column>
                                        <Column>
                                            <Text text="Estado" />
                                        </Column>
                                        <Column>
                                            <Text text="Fecha Incub." />
                                        </Column>
                                    </columns>

                                    <items>
                                        <ColumnListItem type="Navigation"
                                            press="onAbrirIncubacionDetalle">
                                            <cells>
                                                <Text text="{dashboard>codigo}" />
                                                <ObjectStatus
                                                    text="{dashboard>estadoTexto}"
                                                    state="{dashboard>estadoState}" />
                                                <Text text="{dashboard>fechaIncubacionFmt}" />
                                            </cells>
                                        </ColumnListItem>
                                    </items>
                                </Table>
                            </content>
                        </Panel>

                        <!-- RESUMEN / ATAJOS -->
                        <Panel headerText="Resumen rápido" width="100%" class="panelSpacing">
                            <content>
                                <List width="100%">
                                    <StandardListItem
                                        title="Aves activas"
                                        info="{dashboard>/totalAvesActivas}"
                                        icon="images/icons/adult-bird.svg" />
                                    <StandardListItem
                                        title="Incubaciones programadas"
                                        info="{dashboard>/incubacionesProgramadas}"
                                        icon="images/icons/incubation-eggs.svg" />
                                    <StandardListItem
                                        title="Incubaciones en proceso"
                                        info="{dashboard>/incubacionesActivas}"
                                        icon="images/icons/hatching-process.svg" />
                                    <StandardListItem
                                        title="Nacimientos acumulados"
                                        info="{dashboard>/totalNacidos}"
                                        icon="images/icons/young-chick.svg" />
                                </List>
                            </content>
                        </Panel>
                    </HBox>

                    <!-- CONTACTO / QUEJAS Y SUGERENCIAS -->
                    <Panel headerText="Quejas, sugerencias y contacto" width="100%" class="panelSpacing contactSupportPanel">
                        <content>
                            <VBox class="contactSupportBody" width="100%">
                                <Text
                                    text="Cuéntanos qué mejorar o reporta un problema."
                                    class="sapUiSmallMarginBottom" />

                                <HBox wrap="Wrap" class="contactSupportChannels sapUiSmallMarginBottom" visible="{= !!(${dashboard>/contactoTelefono} || ${dashboard>/contactoWhatsappUrl}) }">
                                    <Link
                                        text="{= 'Llamar: ' + ${dashboard>/contactoTelefono} }"
                                        href="{= 'tel:' + ${dashboard>/contactoTelefono} }"
                                        target="_blank"
                                        visible="{= !!${dashboard>/contactoTelefono} }"
                                        class="sapUiSmallMarginEnd sapUiSmallMarginBottom" />
                                    <Link
                                        text="Escribir por WhatsApp"
                                        href="{dashboard>/contactoWhatsappUrl}"
                                        target="_blank"
                                        visible="{= !!${dashboard>/contactoWhatsappUrl} }"
                                        class="sapUiSmallMarginBottom" />
                                </HBox>

                                <Label text="Tipo" labelFor="contactoTipo" />
                                <Select id="contactoTipo" width="100%" selectedKey="{dashboard>/contactoTipo}" class="sapUiSmallMarginBottom">
                                    <core:Item key="SUGERENCIA" text="Sugerencia" />
                                    <core:Item key="QUEJA" text="Queja" />
                                </Select>

                                <!-- <Label text="Teléfono o WhatsApp (opcional)" labelFor="contactoTelefonoUsuario" />
                                <Input
                                    id="contactoTelefonoUsuario"
                                    width="100%"
                                    value="{dashboard>/contactoTelefonoUsuario}"
                                    placeholder="Ej. 999 999 999"
                                    class="sapUiSmallMarginBottom" /> -->

                                <Label text="Mensaje" labelFor="contactoMensaje" required="true" />
                                <TextArea
                                    id="contactoMensaje"
                                    width="100%"
                                    rows="4"
                                    value="{dashboard>/contactoMensaje}"
                                    placeholder="Describe tu queja o sugerencia..."
                                    growing="true"
                                    growingMaxLines="8"
                                    class="sapUiSmallMarginBottom" />

                                <Button
                                    text="Enviar mensaje"
                                    type="Emphasized"
                                    icon="sap-icon://email"
                                    press=".onEnviarQuejaSugerencia"
                                    enabled="{= !${dashboard>/contactoEnviando} }" />
                            </VBox>
                        </content>
                    </Panel>

                </VBox>
            </ScrollContainer>
        </content>
    </Page>
</mvc:View>
