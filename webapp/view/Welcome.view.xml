<mvc:View
        controllerName="com.rprincipees.registroavescombate.controller.Welcome"
        xmlns:mvc="sap.ui.core.mvc"
        xmlns="sap.m"
        xmlns:f="sap.f"
        xmlns:core="sap.ui.core">

    <Page title="Sistema de Gestión de Aves Combatientes">
        <headerContent>
            <f:Avatar
                    id="userAvatar"
                    src="{user>/foto}"
                    displaySize="XS"
                    press="onUserMenuPress"
                    class="sapUiTinyMarginBegin sapUiTinyMarginEnd" />
        </headerContent>
        <content>
            <ScrollContainer height="100%" vertical="true">
                <VBox class="sapUiMediumMargin">

                    <!-- HERO / BIENVENIDA -->
                    <Panel class="sapUiResponsiveMargin sapUiNoContentPadding">
                        <content>
                            <VBox class="dashboardHero sapUiMediumMargin" wrap="Wrap">
                                <Title text="Bienvenido!!!" level="2"/>
                                <Text text="Gestiona tu criadero de forma inteligente" level="H2" design="Bold"/>
                                <Text text="Controla aves, incubaciones y seguimiento reproductivo desde un solo lugar." class="sapUiSmallMarginTop sapUiSmallMarginBottom"/>
                                <HBox class="sapUiSmallMarginTop" wrap="Wrap">
                                    <Button text="Nueva Ave" type="Emphasized" icon="sap-icon://add" press="onNavNewBird"/>
                                    <Button text="Nueva Incubación" icon="sap-icon://add" press="onNavNewIncubation" class="sapUiTinyMarginBegin"/>
                                    <Button text="Ver Incubaciones" icon="sap-icon://table-view" press="onNavIncubationList" class="sapUiTinyMarginBegin"/>
                                </HBox>
                            </VBox>
                        </content>
                    </Panel>

                    <!-- KPIS -->
                    <HBox wrap="Wrap" justifyContent="SpaceBetween" class="sapUiSmallMarginTop">
                        <GenericTile class="sapUiSmallMarginTop" header="Aves" subheader="Registradas" press="onNavBirdList">
                            <TileContent>
                                <NumericContent value="{dashboard>/totalAves}" icon="sap-icon://activate"/>
                            </TileContent>
                        </GenericTile>

                        <GenericTile class="sapUiSmallMarginTop" header="Incubaciones" subheader="Totales" press="onNavIncubationList">
                            <TileContent>
                                <NumericContent value="{dashboard>/totalIncubaciones}" icon="sap-icon://nutrition-activity"/>
                            </TileContent>
                        </GenericTile>

                        <GenericTile class="sapUiSmallMarginTop" header="En proceso" subheader="Activas" press="onNavIncubationListProcess">
                            <TileContent>
                                <NumericContent value="{dashboard>/incubacionesActivas}" icon="sap-icon://process"/>
                            </TileContent>
                        </GenericTile>

                        <GenericTile class="sapUiSmallMarginTop" header="Nacidos" subheader="Acumulado" press="onVerIncubaciones">
                            <TileContent>
                                <NumericContent value="{dashboard>/totalNacidos}" icon="sap-icon://favorite"/>
                            </TileContent>
                        </GenericTile>
                    </HBox>

                    <!-- ALERTAS -->
                    <VBox class="sapUiSmallMarginTop">
                        <MessageStrip
                                text="{dashboard>/alertaIncubaciones}"
                                type="Warning"
                                visible="{= !!${dashboard>/alertaIncubaciones} }"
                                showIcon="true"
                                class="sapUiSmallMarginBottom"/>

                        <MessageStrip
                                text="{dashboard>/alertaEclosion}"
                                type="Information"
                                visible="{= !!${dashboard>/alertaEclosion} }"
                                showIcon="true"/>
                    </VBox>

                    <!-- BLOQUE CENTRAL -->
                    <HBox wrap="Wrap" class="sapUiMediumMarginTop" justifyContent="SpaceBetween">

                        <!-- INCUBACIONES RECIENTES -->
                        <Panel headerText="Incubaciones recientes" width="auto" class="panelSpacing">
                            <content>
                                <Table items="{dashboard>/incubacionesRecientes}" noDataText="Sin incubaciones recientes">
                                    <columns>
                                        <Column>
                                            <Text text="Código"/>
                                        </Column>
                                        <Column>
                                            <Text text="Estado"/>
                                        </Column>
                                        <Column>
                                            <Text text="Fecha"/>
                                        </Column>
                                    </columns>

                                    <items>
                                        <ColumnListItem type="Navigation" press="onAbrirIncubacionDetalle">
                                            <cells>
                                                <Text text="{dashboard>codigo}"/>
                                                <ObjectStatus
                                                        text="{dashboard>estadoTexto}"
                                                        state="{dashboard>estadoState}"/>
                                                <Text text="{dashboard>fechaIncubacionFmt}"/>
                                            </cells>
                                        </ColumnListItem>
                                    </items>
                                </Table>
                            </content>
                        </Panel>

                        <!-- RESUMEN / ATAJOS -->
                        <Panel headerText="Resumen rápido" width="auto" class="panelSpacing">
                            <content>
                                <List>
                                    <StandardListItem
                                            title="Aves activas"
                                            info="{dashboard>/totalAvesActivas}"
                                            icon="sap-icon://activate"/>
                                    <StandardListItem
                                            title="Incubaciones programadas"
                                            info="{dashboard>/incubacionesProgramadas}"
                                            icon="sap-icon://calendar"/>
                                    <StandardListItem
                                            title="Incubaciones en proceso"
                                            info="{dashboard>/incubacionesActivas}"
                                            icon="sap-icon://process"/>
                                    <StandardListItem
                                            title="Nacimientos acumulados"
                                            info="{dashboard>/totalNacidos}"
                                            icon="sap-icon://favorite"/>
                                </List>
                            </content>
                        </Panel>
                    </HBox>

                </VBox>
            </ScrollContainer>
        </content>
    </Page>
</mvc:View>