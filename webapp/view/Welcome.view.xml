<mvc:View
        controllerName="com.rprincipees.registroavescombate.controller.Welcome"
        xmlns:mvc="sap.ui.core.mvc"
        xmlns="sap.m"
        xmlns:tnt="sap.tnt"
        xmlns:core="sap.ui.core"
        xmlns:f="sap.f">

    <tnt:ToolPage id="toolPage">
        <tnt:header>
            <tnt:ToolHeader>
                <Button
                        id="menuButton"
                        icon="sap-icon://menu2"
                        type="Transparent"
                        press="onToggleSideContent" />

                <Title
                        text="Bienvenido al Sistema de Gestión de Aves Combatientes"
                        level="H2" />
                <ToolbarSpacer />

                <f:Avatar
                        id="userAvatar"
                        src="{user>/foto}"
                        displaySize="XS"
                        press="onUserMenuPress"
                        class="sapUiTinyMarginBegin sapUiTinyMarginEnd" />
            </tnt:ToolHeader>
        </tnt:header>

        <tnt:sideContent>
            <tnt:SideNavigation
                    id="sideNavigation"
                    expanded="false"
                    selectedKey="aves">

                <tnt:NavigationList itemSelect="onMenuSelect">
                    <tnt:NavigationListItem
                            text="Aves combatientes"
                            icon="sap-icon://add-product"
                            key="aves" />

                    <tnt:NavigationListItem
                            text="Incubaciones"
                            icon="sap-icon://shipping-status"
                            key="incubaciones" />

                    <tnt:NavigationListItem
                            text="Peleas"
                            icon="sap-icon://activity-items"
                            key="peleas" />

                    <tnt:NavigationListItem
                            text="Vacunación"
                            icon="sap-icon://activity-individual"
                            key="vacunacion" />
                </tnt:NavigationList>
            </tnt:SideNavigation>
        </tnt:sideContent>

        <tnt:mainContents>
            <VBox class="sapUiTinyMargin">
                <HBox class="sapUiMediumMarginTop" justifyContent="Center">
                    <Text
                            text="Gestiona el registro de tus aves de combate de manera fácil y eficiente."
                            class="sapUiMediumMarginTop" />
                </HBox>
            </VBox>

            <Carousel id="imageCarousel" height="auto" width="auto" showPageIndicator="true" pageIndicatorPlacement="Bottom" loop="true" class="sapUiMediumMargin">

                <!-- Imagen 1 -->
                <Image src="../images/gallo1.jpg" alt="Gallo de Combate 1" width="auto" height="20rem" class="carouselImage"/>

                <!-- Imagen 2 -->
                <Image src="../images/gallo2.jpg" alt="Gallo de Combate 2" width="auto" height="20rem" class="carouselImage"/>

                <!-- Imagen 3 -->
                <Image src="../images/gallo3.jpg" alt="Gallo de Combate 3" width="auto" height="20rem" class="carouselImage"/>

                <!-- Imagen 4 -->
                <Image src="../images/gallo4.jpg" alt="Gallo de Combate 4" width="auto" height="20rem" class="carouselImage"/>
            </Carousel>
        </tnt:mainContents>
    </tnt:ToolPage>
</mvc:View>