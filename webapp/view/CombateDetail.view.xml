<mvc:View
    controllerName="com.rprincipees.registroavescombate.controller.CombateDetail"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.ui.layout.form"
    xmlns:fb="sap.f">

    <Page
        title="Detalle de combate"
        showNavButton="true"
        navButtonPress=".onNavBack"
        busy="{detalle>/busy}">
        <headerContent>
            <Button icon="sap-icon://home" press=".onNavWelcome" type="Emphasized" />
            <fb:Avatar
                id="userAvatar"
                src="{user>/foto}"
                displaySize="XS"
                press="onUserMenuPress"
                class="sapUiTinyMarginBegin sapUiTinyMarginEnd" />
        </headerContent>

        <content>
            <VBox class="sapUiMediumMargin">
                <ObjectHeader
                    title="{path: 'detalle>/combate/fecha', formatter: '.formatearFecha'}"
                    intro="{detalle>/combate/evento}"
                    number="{path: 'detalle>/combate/tipoCombate', formatter: '.formatearTipo'}"
                    numberState="{= ${detalle>/combate/tipoCombate} === 'OFICIAL' ? 'Success' : 'Information'}">
                    <statuses>
                        <ObjectStatus
                            text="{path: 'detalle>/combate/resultado', formatter: '.formatearResultado'}"
                            state="{path: 'detalle>/combate/resultado', formatter: '.estadoResultado'}" />
                        <ObjectStatus
                            text="{= ${detalle>/combate/ambosPropios} === false ? 'Rival externo' : 'Ambas aves propias'}"
                            state="{= ${detalle>/combate/ambosPropios} === false ? 'Warning' : 'Success'}" />
                    </statuses>
                </ObjectHeader>

                <Panel headerText="Combatientes" class="sapUiMediumMarginTop">
                    <f:Form editable="false" class="sapUiSmallMargin">
                      <f:layout>
                        <f:ResponsiveGridLayout
                          labelSpanXL="3"
                          labelSpanL="3"
                          labelSpanM="4"
                          labelSpanS="12"
                          emptySpanXL="0"
                          emptySpanL="0"
                          emptySpanM="0"
                          emptySpanS="0"
                          columnsXL="2"
                          columnsL="2"
                          columnsM="1"
                          singleContainerFullSize="false" />
                      </f:layout>
                      <f:formContainers>
                        <f:FormContainer>
                          <f:formElements>
                            <f:FormElement>
                              <f:label>
                                <Label text="Primer combatiente" />
                              </f:label>
                              <f:fields>
                                <Link text="{path: 'detalle>/combate', formatter: '.formatearCombatienteA'}" press=".onVerCombatienteA" visible="{= !!${detalle>/combate/ave_ID}}" />
                                <Text text="{path: 'detalle>/combate', formatter: '.formatearCombatienteA'}" visible="{= !${detalle>/combate/ave_ID}}" />
                              </f:fields>
                            </f:FormElement>
                            <f:FormElement visible="{= ${detalle>/combate/ambosPropios}}">
                              <f:label>
                                <Label text="Segundo combatiente" visible="{= ${detalle>/combate/ambosPropios}}"/>
                              </f:label>
                              <f:fields>
                                <Link text="{path: 'detalle>/combate', formatter: '.formatearCombatienteB'}" press=".onVerCombatienteB" visible="{= ${detalle>/combate/ambosPropios} &amp;&amp; !!${detalle>/combate/combatienteB_ID}}" />
                                <Text text="{path: 'detalle>/combate', formatter: '.formatearCombatienteB'}" visible="{= ${detalle>/combate/ambosPropios} &amp;&amp; !${detalle>/combate/combatienteB_ID}}" />
                              </f:fields>
                            </f:FormElement>
                            <f:FormElement visible="{= !${detalle>/combate/ambosPropios}}">
                              <f:label>
                                <Label text="Rival" visible="{= !${detalle>/combate/ambosPropios}}"/>
                              </f:label>
                              <f:fields>
                                <Text text="{path: 'detalle>/combate', formatter: '.formatearRival'}" visible="{= !${detalle>/combate/ambosPropios}}"/>
                              </f:fields>
                            </f:FormElement>
                            <f:FormElement>
                              <f:label>
                                <Label text="Propietario rival" />
                              </f:label>
                              <f:fields>
                                <Text text="{path: 'detalle>/combate', formatter: '.formatearPropietarioRival'}" />
                              </f:fields>
                            </f:FormElement>
                            <f:FormElement visible="{= ${detalle>/combate/ambosPropios} === false}">
                              <f:label>
                                <Label text="Procedencia rival" visible="{= ${detalle>/combate/ambosPropios} === false}" />
                              </f:label>
                              <f:fields>
                                <Text text="{detalle>/combate/procedenciaOponente}" visible="{= ${detalle>/combate/ambosPropios} === false}" />
                              </f:fields>
                            </f:FormElement>
                          </f:formElements>
                        </f:FormContainer>
                      </f:formContainers>
                    </f:Form>
                </Panel>

                <Panel headerText="Datos del combate" class="sapUiMediumMarginTop">
                    <f:Form editable="false" class="sapUiSmallMargin">
                      <f:layout>
                        <f:ResponsiveGridLayout
                          labelSpanXL="3"
                          labelSpanL="3"
                          labelSpanM="4"
                          labelSpanS="12"
                          emptySpanXL="0"
                          emptySpanL="0"
                          emptySpanM="0"
                          emptySpanS="0"
                          columnsXL="2"
                          columnsL="2"
                          columnsM="1"
                          singleContainerFullSize="false" />
                      </f:layout>
                      <f:formContainers>
                        <f:FormContainer>
                          <f:formElements>
                            <f:FormElement>
                              <f:label>
                                <Label text="Lugar" />
                              </f:label>
                              <f:fields>
                                <Text text="{detalle>/combate/lugar}" />
                              </f:fields>
                            </f:FormElement>
                            <f:FormElement>
                              <f:label>
                                <Label text="Metodo" />
                              </f:label>
                              <f:fields>
                                <Text text="{detalle>/combate/metodoVictoria}" />
                              </f:fields>
                            </f:FormElement>
                            <f:FormElement>
                              <f:label>
                                <Label text="Lesiones" />
                              </f:label>
                              <f:fields>
                                <Text text="{detalle>/combate/lesiones}" />
                              </f:fields>
                            </f:FormElement>
                            <f:FormElement>
                              <f:label>
                                <Label text="Observaciones" />
                              </f:label>
                              <f:fields>
                                <Text text="{detalle>/combate/observaciones}" />
                              </f:fields>
                            </f:FormElement>
                          </f:formElements>
                        </f:FormContainer>
                      </f:formContainers>
                    </f:Form>
                </Panel>

                <Panel headerText="Video" class="sapUiMediumMarginTop"
                    visible="{dashboard>/multimediaPremium}">
                    <core:HTML
                        sanitizeContent="false"
                        visible="{= !!${detalle>/combate/videoUrl}}"
                        content="{path: 'detalle>/combate', formatter: '.renderVideoPlayer'}" />
                    <f:Form editable="false" class="sapUiSmallMargin">
                      <f:layout>
                        <f:ResponsiveGridLayout
                          labelSpanXL="3"
                          labelSpanL="3"
                          labelSpanM="4"
                          labelSpanS="12"
                          emptySpanXL="0"
                          emptySpanL="0"
                          emptySpanM="0"
                          emptySpanS="0"
                          columnsXL="2"
                          columnsL="2"
                          columnsM="1"
                          singleContainerFullSize="false" />
                      </f:layout>
                      <f:formContainers>
                        <f:FormContainer>
                          <f:formElements>
                            <f:FormElement>
                              <f:label>
                                <Label text="Estado" />
                              </f:label>
                              <f:fields>
                                <ObjectStatus
                                    text="{path: 'detalle>/combate/videoEstadoCarga', formatter: '.formatearVideo'}"
                                    icon="{= ${detalle>/combate/videoUrl} ? 'sap-icon://video' : 'sap-icon://attachment' }"
                                    state="{= ${detalle>/combate/videoUrl} ? 'Information' : 'None' }" />
                              </f:fields>
                            </f:FormElement>
                            <f:FormElement>
                              <f:label>
                                <Label text="Archivo" />
                              </f:label>
                              <f:fields>
                                <Text text="{detalle>/combate/videoNombreArchivo}" />
                              </f:fields>
                            </f:FormElement>
                          </f:formElements>
                        </f:FormContainer>
                      </f:formContainers>
                    </f:Form>
                </Panel>
            </VBox>
        </content>
        <footer>
            <Toolbar>
                <ToolbarSpacer />
                <Button text="Editar" type="Emphasized" icon="sap-icon://edit" press=".onEditar" />
                <Button text="Cancelar" press=".onNavBack" />
            </Toolbar>
        </footer>
    </Page>
</mvc:View>
