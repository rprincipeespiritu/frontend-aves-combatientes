<mvc:View
        controllerName="com.rprincipees.registroavescombate.controller.ResetPassword"
        xmlns:mvc="sap.ui.core.mvc"
        xmlns="sap.m">

    <Page title="Nueva contraseña" showNavButton="false">
        <content>
            <VBox class="sapUiMediumMargin">
                <Text text="Ingresa tu nueva contraseña." />

                <Label text="Nueva contraseña" class="sapUiSmallMarginTop" />
                <Input id="inputNewPassword" type="Password" />

                <Label text="Confirmar contraseña" class="sapUiSmallMarginTop" />
                <Input id="inputConfirmPassword" type="Password" />

                <Button
                        text="Actualizar contraseña"
                        type="Emphasized"
                        press="onRestablecerPassword"
                        class="sapUiMediumMarginTop" />
            </VBox>
        </content>
    </Page>
</mvc:View>