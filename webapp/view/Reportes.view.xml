<mvc:View
    controllerName="com.rprincipees.registroavescombate.controller.Reportes"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.ui.layout.form"
    xmlns:form="sap.f">

    <Page
        title="Reportes"
        showNavButton="true"
        navButtonPress=".onNavBack">
        <headerContent>
            <Button icon="sap-icon://home" press="onNavWelcome" type="Emphasized" />
            <form:Avatar
                id="userAvatar"
                src="{user>/foto}"
                displaySize="XS"
                press="onUserMenuPress"
                class="sapUiTinyMarginBegin sapUiTinyMarginEnd" />
        </headerContent>

        <content>
            <VBox class="sapUiMediumMargin" busy="{reportes>/busy}">

                <Panel headerText="Opciones de reporte">
                    <f:SimpleForm editable="true" layout="ResponsiveGridLayout" columnsL="3"
                        columnsM="2">
                        <f:content>
                            <Label text="Reporte" />
                            <Select selectedKey="{reportes>/tipoReporte}" change=".onGenerarReporte">
                                <core:Item key="CRUCES_INCUBACION" text="Cruces e incubaciones" />
                                <core:Item key="PLANES" text="Planes de cruce" />
                                <core:Item key="AVES" text="Aves" />
                            </Select>

                            <Label text="Fecha desde" />
                            <DatePicker value="{reportes>/fechaDesde}" displayFormat="dd/MM/yyyy"
                                valueFormat="yyyy-MM-dd" />

                            <Label text="Fecha hasta" />
                            <DatePicker value="{reportes>/fechaHasta}" displayFormat="dd/MM/yyyy"
                                valueFormat="yyyy-MM-dd" />
                        </f:content>
                    </f:SimpleForm>

                    <Toolbar>
                        <ToolbarSpacer />
                        <Button text="Generar" type="Emphasized" icon="sap-icon://refresh"
                            press=".onGenerarReporte" />
                        <Button text="Exportar Excel" icon="sap-icon://excel-attachment"
                            press=".onExportarExcel" />
                    </Toolbar>
                </Panel>

                <Panel headerText="{reportes>/titulo}" class="sapUiMediumMarginTop">
                    <Toolbar>
                        <Text text="Registros: {reportes>/totalRegistros}" />
                    </Toolbar>

                    <Table
                        items="{reportes>/rows}"
                        noDataText="Sin datos para mostrar"
                        growing="true"
                        growingThreshold="25">
                        <columns>
                            <Column>
                                <Text text="{reportes>/columnasVista/fecha}" />
                            </Column>
                            <Column>
                                <Text text="{reportes>/columnasVista/referencia}" />
                            </Column>
                            <Column>
                                <Text text="{reportes>/columnasVista/machoPlaca}" />
                            </Column>
                            <Column>
                                <Text text="{reportes>/columnasVista/hembraNombre}" />
                            </Column>
                            <Column>
                                <Text text="{reportes>/columnasVista/riesgoEstado}" />
                            </Column>
                            <Column hAlign="End">
                                <Text text="{reportes>/columnasVista/huevosPorcentaje}" />
                            </Column>
                            <Column hAlign="End">
                                <Text text="{reportes>/columnasVista/nacidos}" />
                            </Column>
                        </columns>
                        <items>
                            <ColumnListItem>
                                <cells>
                                    <Text
                                        text="{= ${reportes>fechaIncubacion} || ${reportes>fechaPropuesta} || ${reportes>fechaNacimiento} }" />
                                    <ObjectIdentifier
                                        title="{= ${reportes>codigoIncubacion} || ${reportes>codigo} || ${reportes>placa} }"
                                        text="{= ${reportes>planCruce} || ${reportes>linea} || ${reportes>nombre} }" />
                                    <Text text="{= ${reportes>/tipoReporte} === 'AVES' ? ${reportes>nombre} : ${reportes>macho} }" />
                                    <Text text="{= ${reportes>/tipoReporte} === 'AVES' ? ${reportes>sexo} : ${reportes>hembra} }" />
                                    <ObjectStatus
                                        text="{= ${reportes>/tipoReporte} === 'AVES' ? ${reportes>estado} : (${reportes>riesgo} || ${reportes>decision}) }"
                                        state="{= ${reportes>riesgo} === 'ALTO' || ${reportes>estado} === 'ELIMINADO' || ${reportes>estado} === 'FALLECIDO' ? 'Error' :
                                                      ${reportes>riesgo} === 'MEDIO' || ${reportes>riesgo} === 'MODERADO' || ${reportes>estado} === 'RETIRADO' ? 'Warning' : 'Success'}" />
                                    <ObjectNumber
                                        number="{= ${reportes>/tipoReporte} === 'AVES' ? ${reportes>aptoReproduccion} : (${reportes>totalHuevos} || ${reportes>porcentajeConsanguinidad} || 0) }"
                                        unit="{= ${reportes>/tipoReporte} === 'AVES' ? '' : (${reportes>totalHuevos} ? 'huevos' : '%') }" />
                                    <ObjectNumber
                                        number="{= ${reportes>/tipoReporte} === 'AVES' ? (${reportes>coeficienteConsanguinidad} || 0) : (${reportes>huevosEclosionados} || ${reportes>fertilidadPorc} || 0) }"
                                        unit="{= ${reportes>/tipoReporte} === 'AVES' ? '%' : (${reportes>huevosEclosionados} ? 'nacidos' : '%') }" />
                                </cells>
                            </ColumnListItem>
                        </items>
                    </Table>
                </Panel>

            </VBox>
        </content>
    </Page>
</mvc:View>
