<mvc:View
    controllerName="com.rprincipees.registroavescombate.controller.Combates"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    xmlns="sap.m"
    xmlns:form="sap.ui.layout.form"
    xmlns:f="sap.f">

    <Page
        title="Combates"
        showNavButton="true"
        navButtonPress=".onNavBack"
        busy="{combates>/busy}">
        <headerContent>
            <Button icon="sap-icon://home" press=".onNavWelcome" type="Emphasized" />
            <f:Avatar
                id="userAvatar"
                src="{user>/foto}"
                displaySize="XS"
                press="onUserMenuPress"
                class="sapUiTinyMarginBegin sapUiTinyMarginEnd" />
        </headerContent>

        <content>
            <VBox class="sapUiMediumMargin">
                <Panel
                    headerText="Filtros"
                    expandable="true"
                    expanded="{= ${device>/system/phone} ? 'false' : 'true'}"
                    width="100%"
                    class="combatesFilterPanel">
                    <form:Form editable="true" class="sapUiSmallMargin">
                        <form:layout>
                            <form:ResponsiveGridLayout
                                labelSpanXL="3" labelSpanL="3" labelSpanM="4" labelSpanS="12"
                                emptySpanXL="0" emptySpanL="0" emptySpanM="0" emptySpanS="0"
                                columnsXL="3" columnsL="2" columnsM="2"
                                singleContainerFullSize="false" />
                        </form:layout>
                        <form:formContainers>
                            <form:FormContainer>
                                <form:formElements>
                                    <form:FormElement label="Buscar">
                                        <form:fields>
                                            <SearchField width="100%" placeholder="Buscar por ave, rival, evento o resultado" value="{combates>/filtros/busqueda}" liveChange=".onFiltrarCombates" search=".onFiltrarCombates" />
                                        </form:fields>
                                    </form:FormElement>
                                    <form:FormElement label="Tipo de pelea">
                                        <form:fields>
                                            <ComboBox selectedKey="{combates>/filtros/tipo}" selectionChange=".onFiltrarCombates" placeholder="Tipo de pelea" width="100%">
                                                <items>
                                                    <core:Item key="" text="Todos los tipos" />
                                                    <core:Item key="OFICIAL" text="Oficial" />
                                                    <core:Item key="PRUEBA" text="Entrenamiento" />
                                                </items>
                                            </ComboBox>
                                        </form:fields>
                                    </form:FormElement>
                                </form:formElements>
                            </form:FormContainer>
                            <form:FormContainer>
                                <form:formElements>
                                    <form:FormElement label="Resultado">
                                        <form:fields>
                                            <ComboBox selectedKey="{combates>/filtros/resultado}" selectionChange=".onFiltrarCombates" placeholder="Resultado" width="100%">
                                                <items>
                                                    <core:Item key="" text="Todos los resultados" />
                                                    <core:Item key="VICTORIA" text="Victoria" />
                                                    <core:Item key="DERROTA" text="Derrota" />
                                                    <core:Item key="EMPATE" text="Empate" />
                                                    <core:Item key="SIN_RESULTADO" text="Sin resultado" />
                                                </items>
                                            </ComboBox>
                                        </form:fields>
                                    </form:FormElement>
                                    <form:FormElement label="Video" visible="{= !${device>/system/phone} }">
                                        <form:fields>
                                            <ComboBox selectedKey="{combates>/filtros/video}" selectionChange=".onFiltrarCombates" placeholder="Video" width="100%">
                                                <items>
                                                    <core:Item key="" text="Todos los videos" />
                                                    <core:Item key="CON_VIDEO" text="Con video" />
                                                    <core:Item key="SIN_VIDEO" text="Sin video" />
                                                    <core:Item key="PENDIENTE" text="Pendiente" />
                                                </items>
                                            </ComboBox>
                                        </form:fields>
                                    </form:FormElement>
                                    <form:FormElement>
                                        <form:fields>
                                            <Button text="Limpiar filtros" icon="sap-icon://clear-filter" press=".onLimpiarFiltros" />
                                        </form:fields>
                                    </form:FormElement>
                                </form:formElements>
                            </form:FormContainer>
                            <!-- <form:FormContainer>
                                <form:formElements>
                                    <form:FormElement>
                                        <form:fields>
                                            <Button text="Limpiar filtros" icon="sap-icon://clear-filter" press=".onLimpiarFiltros" />
                                        </form:fields>
                                    </form:FormElement>
                                </form:formElements>
                            </form:FormContainer> -->
                        </form:formContainers>
                    </form:Form>
                </Panel>
                <ScrollContainer
                    width="100%"
                    vertical="true"
                    horizontal="true"
                    class="listadoTablaScroll sapUiMediumMarginTop">
                <Table
                    items="{combates>/combates}"
                    growing="true"
                    growingScrollToLoad="true"
                    sticky="ColumnHeaders,HeaderToolbar"
                    noDataText="Sin combates registrados"
                    class="listadoTabla">
                    <headerToolbar>
                        <OverflowToolbar>
                            <Title text="Combates registrados ({= ${combates>/combates}.length})" />
                            <ObjectStatus
                                text="{combates>/limiteMensaje}"
                                state="Warning"
                                visible="{combates>/limiteAlcanzado}" />
                            <ToolbarSpacer />
                            <Button
                                icon="sap-icon://add"
                                type="Emphasized"
                                press=".onCrearCombate"
                                enabled="{= !${combates>/limiteAlcanzado} }"
                                tooltip="{combates>/limiteMensaje}" />
                            <Button icon="sap-icon://refresh" press=".onRefrescar" />
                        </OverflowToolbar>
                    </headerToolbar>
                    <columns>
                        <Column><Text text="Fecha" /></Column>
                        <Column minScreenWidth="Tablet" demandPopin="true"><Text text="Tipo de Pelea" /></Column>
                        <Column minScreenWidth="Tablet" demandPopin="true"><Text text="Primer combatiente " /></Column>
                        <Column minScreenWidth="Tablet" demandPopin="true"><Text text="Segundo combatiente / Rival" /></Column>
                        <Column minScreenWidth="Tablet" demandPopin="true"><Text text="Propietario rival" /></Column>
                        <Column minScreenWidth="Tablet" demandPopin="true"><Text text="Resultado" /></Column>
                        <Column minScreenWidth="Tablet" demandPopin="true" visible="{= !${device>/system/phone} }" ><Text text="Evento" /></Column>
                        <Column minScreenWidth="Tablet" demandPopin="true" visible="{= !${device>/system/phone} }" ><Text text="Video" /></Column>
                        <Column><Text text="Acciones" /></Column>
                    </columns>
                    <items>
                        <ColumnListItem type="Navigation" press=".onVerDetalleCombate">
                            <cells>
                                <Text text="{path: 'combates>fecha', formatter: '.formatearFecha'}" />
                                <ObjectStatus text="{path: 'combates>tipoCombate', formatter: '.formatearTipo'}" state="{= ${combates>tipoCombate} === 'OFICIAL' ? 'Success' : 'Information'}" />
                                <ObjectIdentifier title="{path: 'combates>', formatter: '.formatearCombatienteATitulo'}" text="{path: 'combates>', formatter: '.formatearCombatienteATexto'}" />
                                <VBox>
                                    <ObjectIdentifier title="{path: 'combates>', formatter: '.formatearCombatienteBTitulo'}" text="{path: 'combates>', formatter: '.formatearCombatienteBTexto'}" visible="{= ${combates>ambosPropios}}" />
                                    <Text text="{path: 'combates>', formatter: '.formatearRival'}" visible="{= !${combates>ambosPropios}}"/>
                                </VBox>
                                <Text text="{path: 'combates>', formatter: '.formatearPropietarioRival'}" />
                                <ObjectStatus text="{path: 'combates>resultado', formatter: '.formatearResultado'}" state="{path: 'combates>resultado', formatter: '.estadoResultado'}" />
                                <Text text="{combates>evento}" />
                                <ObjectStatus text="{path: 'combates>videoEstadoCarga', formatter: '.formatearVideo'}" icon="{= ${combates>videoUrl} ? 'sap-icon://video' : 'sap-icon://attachment' }" state="{= ${combates>videoUrl} ? 'Information' : 'None' }" />
                                <HBox>
                                    <Button icon="sap-icon://edit" type="Emphasized" press=".onEditarCombate" />
                                    <Button icon="sap-icon://delete" type="Transparent" press=".onEliminarCombate" />
                                </HBox>
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>
                </ScrollContainer>
            </VBox>
        </content>
        <footer>
            <Toolbar>
                <ToolbarSpacer />
                <Button text="Cancelar" press=".onNavBack" />
            </Toolbar>
        </footer>
    </Page>
</mvc:View>
