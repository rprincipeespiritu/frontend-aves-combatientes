<mvc:View
        controllerName="com.rprincipees.registroavescombate.controller.LineaGalloForm"
        xmlns:mvc="sap.ui.core.mvc"
        xmlns="sap.m"
        xmlns:core="sap.ui.core"
        xmlns:f="sap.ui.layout.form"
        xmlns:form="sap.f">

    <Page
            title="{= ${linea>/editMode} ? 'Editar Línea de Gallos' : 'Nueva Línea de Gallos' }"
            showNavButton="true"
            navButtonPress=".onNavBack">
        <headerContent>
            <Button icon="sap-icon://home" press="onNavWelcome" type="Emphasized"/>
            <form:Avatar
                    id="userAvatar"
                    src="{user>/foto}"
                    displaySize="XS"
                    press="onUserMenuPress"
                    class="sapUiTinyMarginBegin sapUiTinyMarginEnd" />
        </headerContent>

        <content>

            <f:Form editable="true" class="sapUiSmallMargin">
              <f:layout>
                <f:ResponsiveGridLayout
                  labelSpanXL="3"
                  labelSpanL="3"
                  labelSpanM="4"
                  labelSpanS="12"
                  emptySpanXL="0"
                  emptySpanL="0"
                  emptySpanM="0"
                  emptySpanS="0"
                  columnsXL="2"
                  columnsL="2"
                  columnsM="1"
                  singleContainerFullSize="false" />
              </f:layout>
              <f:formContainers>
                <f:FormContainer>
                  <f:formElements>
                    <f:FormElement>
                      <f:label>
                        <Label text="Nombre de la línea"/>
                      </f:label>
                      <f:fields>
                        <Input
                                value="{linea>/nombre}"
                                placeholder="Ejemplo: Línea Trueno"/>
                      </f:fields>
                    </f:FormElement>
                    <f:FormElement>
                      <f:label>
                        <Label text="Descripción" class="sapUiSmallMarginTop"/>
                      </f:label>
                      <f:fields>
                        <TextArea
                                value="{linea>/descripcion}"
                                rows="3" width="auto"/>
                      </f:fields>
                    </f:FormElement>
                    <f:FormElement>
                      <f:label>
                        <Label text="Objetivo de la línea" class="sapUiSmallMarginTop"/>
                      </f:label>
                      <f:fields>
                        <TextArea
                                value="{linea>/objetivo}"
                                rows="4"
                                placeholder="Ejemplo: fijar velocidad, casta, resistencia, fertilidad..."/>
                      </f:fields>
                    </f:FormElement>
                    <f:FormElement>
                      <f:label>
                        <Label text="Padre Fundador"/>
                      </f:label>
                      <f:fields>
                        <Input
                                id="inputPadreLinea"
                                placeholder="Seleccionar Padre Fundador"
                                value="{linea>/aveFundadorPlaca}"
                                description="{linea>/aveFundadorNombre}"
                                showValueHelp="true"
                                valueHelpOnly="true"
                                valueHelpRequest="onValueHelpPadre"
                                width="100%"/>
                      </f:fields>
                    </f:FormElement>
                    <f:FormElement>
                      <f:label>
                        <Label text="Madre Fundadora"/>
                      </f:label>
                      <f:fields>
                        <Input
                                id="inputMadreLinea"
                                placeholder="Seleccionar Madre Fundadora"
                                value="{linea>/aveFundadoraPlaca}"
                                description="{linea>/aveFundadoraNombre}"
                                showValueHelp="true"
                                valueHelpOnly="true"
                                valueHelpRequest="onValueHelpMadre"
                                width="100%"/>
                      </f:fields>
                    </f:FormElement>
                    <f:FormElement visible="{linea>/editMode}">
                      <f:label>
                        <Label text="Estado"/>
                      </f:label>
                      <f:fields>
                        <Select
                                selectedKey="{linea>/estado}"
                                width="100%"
                                forceSelection="true">
                          <core:Item key="ACTIVA" text="Activa"/>
                          <core:Item key="INACTIVA" text="Inactiva"/>
                        </Select>
                      </f:fields>
                    </f:FormElement>
                  </f:formElements>
                </f:FormContainer>
              </f:formContainers>
            </f:Form>

        </content>
        <footer>
            <Toolbar>
                <ToolbarSpacer/>
                <Button text="Guardar" type="Emphasized" icon="sap-icon://save" press=".onGuardar" />
                <Button text="Cancelar" press="onNavBack"/>
            </Toolbar>
        </footer>
    </Page>
</mvc:View>