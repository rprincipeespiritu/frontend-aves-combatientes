<mvc:View controllerName="com.rprincipees.registroavescombate.controller.List"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <Page title="{i18n>titleListPage}" titleAlignment="Center" showNavButton="true" navButtonPress="onNavBack">
        <headerContent>
            <Button icon="sap-icon://log" type="Transparent" tooltip="Cerrar Sesión" press="onLogout" class="sapUiSmallMarginBegin"/>
        </headerContent>
        <content>
            <VBox class="sapUiMediumMargin">

                <!-- Barra de herramientas principal -->
                <Toolbar>
                    <Title text="Gestión de Aves" level="H2"/>
                    <ToolbarSpacer/>
                    <Button text="Agregar Ave" type="Emphasized" icon="sap-icon://add" press="onAgregarAve"/>
                    <Button text="Refrescar" icon="sap-icon://refresh" press="onRefrescar"/>
                </Toolbar>

                <!-- Panel de filtros -->
                <Panel headerText="Filtros" expandable="true" expanded="false">
                    <VBox class="sapUiMediumMargin">
                        <HBox class="sapUiSmallMarginBottom">
                            <SearchField id="searchField" placeholder="Buscar por nombre, propietario o raza..." width="300px" search="onBuscar"/>
                            <ComboBox id="razaFilter" placeholder="Filtrar por raza" width="200px" items="{razas>/}" selectionChange="onFiltrarRaza">
                                <core:Item key="{razas>id}" text="{razas>nombre}"/>
                            </ComboBox>
                            <ComboBox id="categoriaFilter" placeholder="Filtrar por categoría" width="200px" items="{categorias>/}" selectionChange="onFiltrarCategoria">
                                <core:Item key="{categorias>id}" text="{categorias>nombre}"/>
                            </ComboBox>
                            <Button text="Limpiar Filtros" press="onLimpiarFiltros"/>
                        </HBox>
                    </VBox>
                </Panel>

                <!-- Tabla de aves -->
                <Table id="avesTable" items="{aves>/value}" mode="MultiSelect" class="sapUiMediumMarginTop" selectionChange="onSelectionChange">

                    <headerToolbar>
                        <Toolbar>
                            <Title text="Aves Registradas ({= ${aves>/value}.length})"/>
                            <ToolbarSpacer/>
                            <Button text="Editar Seleccionada" enabled="{= ${table>/selectedIndex} >= 0}" press="onEditarAve" visible="false"/>
                            <Button text="Eliminar Seleccionada" type="Reject" enabled="{= ${table>/selectedIndex} >= 0}" press="onEliminarAve"/>
                        </Toolbar>
                    </headerToolbar>

                    <columns>
                        <Column width="10rem">
                            <Text text="Placa"/>
                        </Column>
                        <Column minScreenWidth="Tablet">
                            <Text text="Nombre"/>
                        </Column>
                        <!-- <Column minScreenWidth="Desktop">
                            <Text text="Raza"/>
                        </Column> -->
                        <Column minScreenWidth="Desktop">
                            <Text text="Fecha Nacimiento"/>
                        </Column>
                        <Column minScreenWidth="Tablet" hAlign="Right">
                            <Text text="Edad"/>
                        </Column>
                        <Column minScreenWidth="Desktop">
                            <Text text="Género"/>
                        </Column>
                        <Column minScreenWidth="Tablet">
                            <Text text="Propietario"/>
                        </Column>
                        <Column minScreenWidth="Desktop">
                            <Text text="Categoría"/>
                        </Column>
                        <Column minScreenWidth="Tablet">
                            <Text text="Estado"/>
                        </Column>
                        <Column width="8rem">
                            <Text text="Padre"/>
                        </Column>
                        <Column width="8rem">
                            <Text text="Madre"/>
                        </Column>
                        <Column width="8rem">
                            <Text text="Acciones"/>
                        </Column>
                    </columns>

                    <items>
                        <ColumnListItem press="onAvePress">
                            <Text text="{aves>placa}"/>
                            <Text text="{aves>nombre}"/>
                            <!-- <Text text="{aves>raza}"/> -->
                            <Text text="{
                                path: 'aves>fechaNacimiento',
                                formatter: '.formatearFecha'
                            }"/>
                            <Text text="{aves>edad}"/>
                            <Text text="{
                                path: 'aves>sexo',
                                formatter: '.formatearSexo'}"/>
                            <Text text="{aves>criador}"/>
                            <Text text="{aves>categoria}"/>
                            <ObjectStatus text="{
                                    path: 'aves>estado',
                                    formatter: '.formatearEstado'
                                }" state="{= ${aves>estado} === 'ACTIVO' ? 'Success' : 
                                         ${aves>estado} === 'ENTRENAMIENTO' ? 'Warning' :
                                         ${aves>estado} === 'COMPETENCIA' ? 'Information' : 'Error'}"/>
                            <Link text="{aves>padre}" press="onPadreLinkPress"/>
                            <Link text="{aves>madre}" press="onMadreLinkPress"/>
                            <HBox>
                                <Button icon="sap-icon://edit" type="Transparent" tooltip="Editar" press="onEditarAveInline"/>
                                <Button icon="sap-icon://delete" type="Transparent" tooltip="Eliminar" press="onEliminarAveInline" visible="false"/>
                                <Button icon="sap-icon://detail-view" type="Transparent" tooltip="Ver detalle" press="onAvePress"/>
                            </HBox>
                        </ColumnListItem>
                    </items>
                </Table>

            </VBox>
        </content>
    </Page>

</mvc:View>