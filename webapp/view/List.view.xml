<mvc:View controllerName="com.rprincipees.registroavescombate.controller.List"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:form="sap.ui.layout.form"
    xmlns:f="sap.f">

    <Page title="{i18n>titleListPage}" titleAlignment="Center" showNavButton="true" navButtonPress="onNavBack">

        <headerContent visible="false">
            <Button icon="sap-icon://home" press="onNavWelcome" type="Emphasized" />
            <f:Avatar id="userAvatar" src="{user>/foto}" displaySize="XS" press="onUserMenuPress" class="sapUiTinyMarginBegin sapUiTinyMarginEnd" />
        </headerContent>

        <content>
            <VBox width="100%">

                <!-- Barra principal responsiva -->
                <OverflowToolbar width="100%">
                    <!-- <Title text="Gestión de Aves" level="H2" /> -->
                    <ToolbarSpacer />
                    <Button text="{= ${device>/system/phone} ? '' : 'Agregar Ave'}" icon="sap-icon://add" type="Emphasized" press="onAgregarAve" />
                    <Button text="{= ${device>/system/phone} ? '' : 'Refrescar'}" icon="sap-icon://refresh" press="onRefrescar" />
                </OverflowToolbar>

                <!-- Panel de filtros -->
                <Panel headerText="Filtros" expandable="true" expanded="false" width="100%">

                    <content>
                        <form:Form editable="true" class="sapUiSmallMargin">
                            <form:layout>
                                <form:ResponsiveGridLayout
                                    labelSpanXL="3" labelSpanL="3" labelSpanM="4" labelSpanS="12"
                                    emptySpanXL="0" emptySpanL="0" emptySpanM="0" emptySpanS="0"
                                    columnsXL="3" columnsL="2" columnsM="2"
                                    singleContainerFullSize="false" />
                            </form:layout>
                            <form:formContainers>
                                <form:FormContainer>
                                    <form:formElements>
                                        <form:FormElement label="Buscar">
                                            <form:fields>
                                                <SearchField id="searchField" tooltip="Buscar por Nombre y Placa del Ave" placeholder="Nombre y Placa del Ave" width="100%" search="onBuscar" />
                                            </form:fields>
                                        </form:FormElement>
                                        <form:FormElement label="Género">
                                            <form:fields>
                                                <ComboBox id="generoFilter" placeholder="Filtrar por Género" width="100%" selectionChange="onFiltrarGenero">
                                                    <core:Item key="M" text="Macho" />
                                                    <core:Item key="H" text="Hembra" />
                                                </ComboBox>
                                            </form:fields>
                                        </form:FormElement>
                                        <form:FormElement label="Categoría">
                                            <form:fields>
                                                <ComboBox id="categoriaFilter" placeholder="Filtrar por Categoría" width="100%" selectionChange="onFiltrarCategoria">
                                                    <core:Item key="BUENO" text="Bueno" />
                                                    <core:Item key="EXCELENTE" text="Excelente" />
                                                    <core:Item key="EXTRAORDINARIO" text="Extraordinario" />
                                                </ComboBox>
                                            </form:fields>
                                        </form:FormElement>
                                    </form:formElements>
                                </form:FormContainer>
                                <form:FormContainer>
                                    <form:formElements>
                                        <form:FormElement label="Padre/Madre">
                                            <form:fields>
                                                <Input id="inputPadres" placeholder="Seleccionar Padre/Madre" showValueHelp="true" valueHelpOnly="true" valueHelpRequest="onAbrirPopupPadres" width="100%" />
                                            </form:fields>
                                        </form:FormElement>
                                        <form:FormElement label="Estado">
                                            <form:fields>
                                                <ComboBox id="estadoFilter" placeholder="Filtrar por Estado" width="100%" selectionChange="onFiltrarEstado">
                                                    <core:Item key="ACTIVO" text="Activo" />
                                                    <core:Item key="VENDIDO" text="Vendido" />
                                                    <core:Item key="PRESTADO" text="Prestado" />
                                                    <core:Item key="RETIRADO" text="Retirado" />
                                                    <core:Item key="FALLECIDO" text="Fallecido" />
                                                </ComboBox>
                                            </form:fields>
                                        </form:FormElement>
                                        <form:FormElement label="Clasificación">
                                            <form:fields>
                                                <CheckBox id="padroteFilter" text="Padrote" select="onSelectPadrote" />
                                            </form:fields>
                                        </form:FormElement>
                                        <form:FormElement>
                                            <form:fields>
                                                <Button text="Limpiar Filtros" icon="sap-icon://clear-filter" press="onLimpiarFiltros" />
                                            </form:fields>
                                        </form:FormElement>
                                    </form:formElements>
                                </form:FormContainer>
                                <!-- <form:FormContainer>
                                    <form:formElements>
                                        <form:FormElement label="Clasificación">
                                            <form:fields>
                                                <CheckBox id="padroteFilter" text="Padrote" select="onSelectPadrote" />
                                            </form:fields>
                                        </form:FormElement>
                                        <form:FormElement>
                                            <form:fields>
                                                <Button text="Limpiar Filtros" icon="sap-icon://clear-filter" press="onLimpiarFiltros" />
                                            </form:fields>
                                        </form:FormElement>
                                    </form:formElements>
                                </form:FormContainer> -->
                            </form:formContainers>
                        </form:Form>
                    </content>
                </Panel>

                <Panel>
                    <VBox>

                        <!-- Tabla -->
                        <Table
                            id="avesTable"
                            width="100%"
                            inset="false"
                            items="{aves>/value}"
                            visible="{= !${device>/system/phone} }"
                            class="sapUiMediumMarginTop">

                            <headerToolbar>
                                <OverflowToolbar>
                                    <Title text="Aves Registradas ({aves>/filteredCount})" />
                                    <ToolbarSpacer />
                                    <!-- <Button text="{= ${device>/system/phone} ? 'Editar' : 'Editar Seleccionada'}" enabled="{= ${table>/selectedIndex} >= 0}" press="onEditarAve" visible="false" /> -->
                                    <!-- <Button text="{= ${device>/system/phone} ? '' : 'Descargar plantilla'}" icon="sap-icon://download" press="onDescargarPlantilla" type="Emphasized" />
                                    <Button text="{= ${device>/system/phone} ? '' : 'Subir datos'}" icon="sap-icon://upload" press="onSubirDatos" type="Emphasized" /> -->
                                    <Button text="{= ${device>/system/phone} ? '' : 'Exportar a Excel'}" icon="sap-icon://excel-attachment" press="onExportarExcel" type="Emphasized" tooltip="Exportar a Excel" />
                                </OverflowToolbar>
                            </headerToolbar>

                            <columns>
                                <Column width="5rem" hAlign="Center">
                                    <Text text="Imagen" />
                                </Column>

                                <Column width="8rem">
                                    <Text text="Placa" />
                                </Column>

                                <Column width="8rem">
                                    <Text text="Nombre" />
                                </Column>

                                <Column minScreenWidth="Tablet" demandPopin="true" visible="{= ${device>/system/phone} ? false : true}">
                                    <Text text="Fecha Nac." />
                                </Column>

                                <Column minScreenWidth="Tablet" demandPopin="true">
                                    <Text text="Género" />
                                </Column>

                                <Column width="10rem" minScreenWidth="Tablet" demandPopin="true" visible="{= ${device>/system/phone} ? false : true}">
                                    <Text text="Categoría" />
                                </Column>

                                <Column minScreenWidth="Desktop" demandPopin="true" >
                                    <Text text="Cría" />
                                </Column>

                                <Column minScreenWidth="Tablet" demandPopin="true" visible="{= ${device>/system/phone} ? false : true}">
                                    <Text text="Estado" />
                                </Column>

                                <Column minScreenWidth="Desktop" demandPopin="true">
                                    <Text text="Padrote" />
                                </Column>

                                <Column minScreenWidth="Desktop" demandPopin="true">
                                    <Text text="Padre" />
                                </Column>

                                <Column minScreenWidth="Desktop" demandPopin="true">
                                    <Text text="Madre" />
                                </Column>

                                <!-- <Column width="8rem" hAlign="Center">
                                    <Text text="Acciones" />
                                </Column> -->
                            </columns>

                            <items>
                                <ColumnListItem type="Navigation" press="onAvePress">
                                    <cells>
                                        <f:Avatar
                                            src="{aves>fotoPrincipal}"
                                            fallbackIcon="sap-icon://picture"
                                            displayShape="Circle"
                                            displaySize="S"
                                            tooltip="{= ${aves>fotoPrincipal} ? 'Ver imagen principal' : 'Sin imagen principal' }"
                                            press="onVerImagenAve" />

                                        <ObjectStatus text="{
                                            path: 'aves>placa'
                                            }" state="Information" />
                                        <!-- <Text text="{aves>placa}" /> -->
                                        <ObjectStatus text="{
                                            path: 'aves>nombre'
                                            }" state="Information" />
                                        <!-- <Text text="{aves>nombre}" /> -->

                                        <Text text="{
                                        path: 'aves>fechaNacimiento',
                                        formatter: '.formatearFecha'
                                    }" />

                                        <Text text="{
                                        path: 'aves>sexo',
                                        formatter: '.formatearSexo'
                                    }" />

                                        <Text text="{
                                        path: 'aves>categoria',
                                        formatter: '.formatearCategoria'
                                    }" />

                                        <CheckBox selected="{aves>cria}" editable="false" />

                                        <ObjectStatus text="{
                                            path: 'aves>estado',
                                            formatter: '.formatearEstado'
                                        }" state="{= ${aves>estado} === 'ACTIVO' ? 'Success' :
                                                ${aves>estado} === 'PRESTADO' ? 'Information' :
                                                ${aves>estado} === 'RETIRADO' ? 'Information' :
                                                ${aves>estado} === 'VENDIDO' ? 'Warning' : 'Error'}" />

                                        <CheckBox selected="{aves>padrote}" editable="false" />

                                        <!--<Link text="{aves>padre/placa}" press="onPadreLinkPress"/>
                                    <Link text="{aves>madre/placa}" press="onMadreLinkPress"/>-->
                                        <VBox>
                                            <Text text="{aves>padre/placa}" class="sapUiTinyMarginTop" />
                                            <Text text="{aves>padre/nombre}" />
                                        </VBox>

                                        <VBox>
                                            <Text text="{aves>madre/placa}" class="sapUiTinyMarginTop" />
                                            <Text text="{aves>madre/nombre}" />
                                        </VBox>

                                        <!-- <HBox justifyContent="Center" width="100%" renderType="Bare">
                                            <Button icon="sap-icon://edit" type="Emphasized" tooltip="Editar" press="onEditarAveInline" />
                                            <Button icon="sap-icon://delete" type="Transparent" tooltip="Eliminar" press="onEliminarAveInline" visible="true" />
                                            <Button icon="sap-icon://detail-view" type="Emphasized" tooltip="Ver detalle" press="onAvePress" />
                                        </HBox> -->
                                    </cells>
                                </ColumnListItem>
                            </items>
                        </Table>

                        <List
                            id="avesMobileList"
                            items="{aves>/value}"
                            noDataText="Sin datos"
                            visible="{device>/system/phone}"
                            class="avesAdultasMobileList sapUiSmallMarginTop">
                            <headerToolbar>
                                <OverflowToolbar>
                                    <Title text="Aves Registradas ({aves>/filteredCount})" />
                                    <ToolbarSpacer />
                                    <!--<Button
                                        icon="sap-icon://download"
                                        press="onDescargarPlantilla"
                                        type="Emphasized"
                                        tooltip="Descargar plantilla" />
                                    <Button
                                        icon="sap-icon://upload"
                                        press="onSubirDatos"
                                        type="Emphasized"
                                        tooltip="Subir datos" />-->
                                    <Button text="{= ${device>/system/phone} ? '' : 'Exportar a Excel'}" icon="sap-icon://excel-attachment" press="onExportarExcel" type="Emphasized" tooltip="Exportar a Excel" />
                                </OverflowToolbar>
                            </headerToolbar>
                            <items>
                                <CustomListItem
                                    type="Navigation"
                                    press="onAvePress"
                                    class="aveAdultaMobileItem">
                                    <VBox class="aveAdultaMobileCard">
                                        <HBox
                                            alignItems="Center"
                                            class="aveAdultaMobileHeader">
                                            <f:Avatar
                                                src="{aves>fotoPrincipal}"
                                                fallbackIcon="sap-icon://picture"
                                                displayShape="Circle"
                                                displaySize="S"
                                                tooltip="{= ${aves>fotoPrincipal} ? 'Ver imagen principal' : 'Sin imagen principal' }"
                                                press="onVerImagenAve"
                                                class="aveAdultaMobileAvatar" />
                                            <VBox class="aveAdultaMobileIdentity">
                                                <Text
                                                    text="{= ${aves>nombre} || 'Sin nombre' }"
                                                    wrapping="true"
                                                    class="aveAdultaMobileTitle" />
                                                <HBox alignItems="Center" wrap="Wrap" class="aveAdultaMobilePlateRow">
                                                    <Label text="Placa:" />
                                                    <ObjectStatus text="{aves>placa}" state="Information" />
                                                </HBox>
                                            </VBox>
                                            <!-- <HBox
                                                alignItems="Center"
                                                renderType="Bare"
                                                class="aveAdultaMobileActions">
                                                <Button
                                                    icon="sap-icon://edit"
                                                    type="Emphasized"
                                                    tooltip="Editar"
                                                    press="onEditarAveInline" />
                                                <Button
                                                    icon="sap-icon://delete"
                                                    type="Transparent"
                                                    tooltip="Eliminar"
                                                    press="onEliminarAveInline" />
                                            </HBox> -->
                                        </HBox>

                                        <FlexBox
                                            wrap="Wrap"
                                            renderType="Div"
                                            class="aveAdultaMobileGrid">
                                            <!-- <VBox class="aveAdultaMobileField">
                                                <Label text="Fecha Nac." />
                                                <Text
                                                    text="{
                                                        path: 'aves>fechaNacimiento',
                                                        formatter: '.formatearFecha'
                                                    }" />
                                            </VBox> -->
                                            <VBox class="aveAdultaMobileField">
                                                <Label text="Genero" />
                                                <Text
                                                    text="{
                                                        path: 'aves>sexo',
                                                        formatter: '.formatearSexo'
                                                    }" />
                                            </VBox>
                                            <VBox class="aveAdultaMobileField">
                                                <Label text="Categoria" />
                                                <Text
                                                    text="{
                                                        path: 'aves>categoria',
                                                        formatter: '.formatearCategoria'
                                                    }" />
                                            </VBox>
                                            <VBox class="aveAdultaMobileField">
                                                <Label text="Estado" />
                                                <ObjectStatus
                                                    text="{
                                                        path: 'aves>estado',
                                                        formatter: '.formatearEstado'
                                                    }"
                                                    state="{= ${aves>estado} === 'ACTIVO' ? 'Success' :
                                                        ${aves>estado} === 'PRESTADO' ? 'Information' :
                                                        ${aves>estado} === 'RETIRADO' ? 'Information' :
                                                        ${aves>estado} === 'VENDIDO' ? 'Warning' : 'Error'}" />
                                            </VBox>
                                            <!-- <VBox class="aveAdultaMobileField">
                                                <Label text="Cria" />
                                                <CheckBox selected="{aves>cria}" editable="false" />
                                            </VBox> -->
                                            <VBox class="aveAdultaMobileField">
                                                <Label text="Padrote" />
                                                <CheckBox selected="{aves>padrote}" editable="false" />
                                            </VBox>
                                            <VBox class="aveAdultaMobileField">
                                                <Label text="Padre" />
                                                <Text text="{aves>padre/placa}" />
                                                <Text text="{aves>padre/nombre}" class="aveAdultaMobileMuted" />
                                            </VBox>
                                            <VBox class="aveAdultaMobileField">
                                                <Label text="Madre" />
                                                <Text text="{aves>madre/placa}" />
                                                <Text text="{aves>madre/nombre}" class="aveAdultaMobileMuted" />
                                            </VBox>
                                        </FlexBox>
                                    </VBox>
                                </CustomListItem>
                            </items>
                        </List>
                    </VBox>
                </Panel>
            </VBox>
        </content>
        <footer>
            <Toolbar>
                <ToolbarSpacer />
                <Button text="Cancelar" press="onNavBack" visible="true" />
            </Toolbar>
        </footer>
    </Page>
</mvc:View>
