<mvc:View controllerName="com.rprincipees.registroavescombate.controller.List"
          xmlns:mvc="sap.ui.core.mvc"
          xmlns="sap.m"
          xmlns:core="sap.ui.core"
          xmlns:f="sap.f">

    <Page
            title="{i18n>titleListPage}"
            titleAlignment="Center"
            showNavButton="true"
            navButtonPress="onNavBack">

        <headerContent>
            <f:Avatar
                    id="userAvatar"
                    src="{user>/foto}"
                    displaySize="XS"
                    press="onUserMenuPress"
                    class="sapUiTinyMarginBegin sapUiTinyMarginEnd" />
        </headerContent>

        <content>
            <VBox width="100%" class="sapUiSmallMargin">

                <!-- Barra principal responsiva -->
                <OverflowToolbar width="100%">
                    <Title text="Gestión de Aves" level="H2"/>
                    <ToolbarSpacer/>
                    <Button
                            text="{= ${device>/system/phone} ? '' : 'Agregar Ave'}"
                            icon="sap-icon://add"
                            type="Emphasized"
                            press="onAgregarAve"/>
                    <Button
                            text="{= ${device>/system/phone} ? '' : 'Refrescar'}"
                            icon="sap-icon://refresh"
                            press="onRefrescar"/>
                </OverflowToolbar>

                <!-- Panel de filtros -->
                <Panel
                        headerText="Filtros"
                        expandable="true"
                        expanded="false"
                        width="100%">

                    <content>
                        <VBox width="100%" class="sapUiSmallMargin">

                            <FlexBox wrap="Wrap" width="100%" class="sapUiSmallMarginBottom" renderType="Div">
                                <items>
                                    <SearchField
                                            id="searchField"
                                            tooltip="Buscar por nombre y placa del individuo"
                                            placeholder="Buscar por nombre y placa del individuo"
                                            width="100%"
                                            search="onBuscar" />

                                    <ComboBox
                                            id="generoFilter"
                                            placeholder="Filtrar por Género"
                                            width="100%"
                                            selectionChange="onFiltrarGenero">
                                        <core:Item key="M" text="Gallo"/>
                                        <core:Item key="H" text="Gallina"/>
                                    </ComboBox>

                                    <ComboBox
                                            id="categoriaFilter"
                                            placeholder="Filtrar por Categoría"
                                            width="100%"
                                            selectionChange="onFiltrarCategoria">
                                        <core:Item key="BUENO" text="Bueno"/>
                                        <core:Item key="EXCELENTE" text="Excelente"/>
                                        <core:Item key="EXTRAORDINARIO" text="Extraordinario"/>
                                    </ComboBox>
                                </items>
                            </FlexBox>

                            <FlexBox wrap="Wrap" width="100%" class="sapUiSmallMarginBottom" renderType="Div">
                                <items>
                                    <SearchField
                                            id="searchFieldPadres"
                                            tooltip="Buscar por nombre y placa de los padres"
                                            placeholder="Buscar por nombre y placa de los padres"
                                            width="100%"
                                            search="onBuscar2"/>

                                    <ComboBox
                                            id="estadoFilter"
                                            placeholder="Filtrar por Estado"
                                            width="100%"
                                            selectionChange="onFiltrarEstado">
                                        <core:Item key="ACTIVO" text="Activo"/>
                                        <core:Item key="VENDIDO" text="Vendido"/>
                                        <core:Item key="PRESTADO" text="Prestado"/>
                                        <core:Item key="RETIRADO" text="Retirado"/>
                                        <core:Item key="FALLECIDO" text="Fallecido"/>
                                    </ComboBox>

                                    <CheckBox
                                            id="padroteFilter"
                                            text="Padrote"
                                            select="onSelectPadrote"/>

                                    <Button text="Limpiar Filtros" press="onLimpiarFiltros"/>

                                </items>
                            </FlexBox>

                            <!--<HBox width="100%" justifyContent="End">
                                <Button text="Limpiar Filtros" press="onLimpiarFiltros"/>
                            </HBox>-->

                        </VBox>
                    </content>
                </Panel>

                <!-- Tabla -->
                <Table
                        id="avesTable"
                        width="100%"
                        inset="false"
                        items="{aves>/value}"
                        mode="MultiSelect"
                        class="sapUiMediumMarginTop"
                        selectionChange="onSelectionChange">

                    <headerToolbar>
                        <OverflowToolbar>
                            <Title text="Aves Registradas ({= ${aves>/value}.length})"/>
                            <ToolbarSpacer/>
                            <Button
                                    text="{= ${device>/system/phone} ? 'Editar' : 'Editar Seleccionada'}"
                                    enabled="{= ${table>/selectedIndex} >= 0}"
                                    press="onEditarAve"
                                    visible="false"/>
                            <Button
                                    text="{= ${device>/system/phone} ? 'Eliminar' : 'Eliminar Seleccionada'}"
                                    type="Reject"
                                    enabled="{= ${table>/selectedIndex} >= 0}"
                                    press="onEliminarAve"/>
                        </OverflowToolbar>
                    </headerToolbar>

                    <columns>
                        <Column width="7rem">
                            <Text text="Placa"/>
                        </Column>

                        <Column width="9rem">
                            <Text text="Nombre"/>
                        </Column>

                        <Column minScreenWidth="Tablet" demandPopin="true" width="8rem">
                            <Text text="Fecha Nac."/>
                        </Column>

                        <Column minScreenWidth="Tablet" demandPopin="true" width="6rem">
                            <Text text="Género"/>
                        </Column>

                        <Column minScreenWidth="Tablet" demandPopin="true" width="8rem">
                            <Text text="Categoría"/>
                        </Column>

                        <Column minScreenWidth="Desktop" demandPopin="true" width="5rem">
                            <Text text="Cría"/>
                        </Column>

                        <Column minScreenWidth="Tablet" demandPopin="true" width="7rem">
                            <Text text="Estado"/>
                        </Column>

                        <Column minScreenWidth="Desktop" demandPopin="true" width="6rem">
                            <Text text="Padrote"/>
                        </Column>

                        <Column minScreenWidth="Desktop" demandPopin="true" width="7rem">
                            <Text text="Padre"/>
                        </Column>

                        <Column minScreenWidth="Desktop" demandPopin="true" width="7rem">
                            <Text text="Madre"/>
                        </Column>

                        <Column hAlign="Center" width="7rem">
                            <Text text="Acciones"/>
                        </Column>
                    </columns>

                    <items>
                        <ColumnListItem type="Active" press="onAvePress">
                            <cells>
                                <Text text="{aves>placa}"/>
                                <Text text="{aves>nombre}"/>

                                <Text text="{
                                    path: 'aves>fechaNacimiento',
                                    formatter: '.formatearFecha'
                                }"/>

                                <Text text="{
                                    path: 'aves>sexo',
                                    formatter: '.formatearSexo'
                                }"/>

                                <Text text="{
                                    path: 'aves>categoria',
                                    formatter: '.formatearCategoria'
                                }"/>

                                <CheckBox selected="{aves>cria}" editable="false"/>

                                <ObjectStatus
                                        text="{
                                        path: 'aves>estado',
                                        formatter: '.formatearEstado'
                                    }"
                                        state="{= ${aves>estado} === 'ACTIVO' ? 'Success' :
                                             ${aves>estado} === 'PRESTADO' ? 'Information' :
                                             ${aves>estado} === 'RETIRADO' ? 'Information' :
                                             ${aves>estado} === 'VENDIDO' ? 'Warning' : 'Error'}"/>

                                <CheckBox selected="{aves>padrote}" editable="false"/>

                                <Link text="{aves>padre}" press="onPadreLinkPress"/>
                                <Link text="{aves>madre}" press="onMadreLinkPress"/>

                                <HBox justifyContent="Center" width="100%" renderType="Bare">
                                    <Button
                                            icon="sap-icon://edit"
                                            type="Transparent"
                                            tooltip="Editar"
                                            press="onEditarAveInline"/>
                                    <Button
                                            icon="sap-icon://delete"
                                            type="Transparent"
                                            tooltip="Eliminar"
                                            press="onEliminarAveInline"
                                            visible="false"/>
                                    <Button
                                            icon="sap-icon://detail-view"
                                            type="Transparent"
                                            tooltip="Ver detalle"
                                            press="onAvePress"/>
                                </HBox>
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>

            </VBox>
        </content>
    </Page>
</mvc:View>