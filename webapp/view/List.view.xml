<mvc:View controllerName="com.rprincipees.registroavescombate.controller.List"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.f">

    <Page title="{i18n>titleListPage}" titleAlignment="Center" showNavButton="true" navButtonPress="onNavBack">
        <headerContent>
            <f:Avatar
                    id="userAvatar"
                    src="{user>/foto}"
                    displaySize="XS"
                    press="onUserMenuPress"
                    class="sapUiTinyMarginBegin sapUiTinyMarginEnd" />
        </headerContent>
        <content>
            <VBox class="sapUiMediumMargin">

                <!-- Barra de herramientas principal -->
                <Toolbar>
                    <Title text="Gestión de Aves" level="H2"/>
                    <ToolbarSpacer/>
                    <Button text="Agregar Ave" type="Emphasized" icon="sap-icon://add" press="onAgregarAve"/>
                    <Button text="Refrescar" icon="sap-icon://refresh" press="onRefrescar"/>
                </Toolbar>

                <!-- Panel de filtros -->
                <Panel headerText="Filtros" expandable="true" expanded="false">
                    <VBox class="sapUiMediumMargin">
                        <HBox class="sapUiSmallMarginBottom">
                            <SearchField id="searchField" tooltip="Buscar por nombre y placa del individuo" placeholder="Buscar por nombre y placa del individuo" width="300px" search="onBuscar"/>
                            <ComboBox id="generoFilter" placeholder="Filtrar por Género" width="200px" selectionChange="onFiltrarGenero">
                                <core:Item key="M" text="Gallo"/>
                                <core:Item key="H" text="Gallina"/>
                            </ComboBox>
                            <ComboBox id="categoriaFilter" placeholder="Filtrar por Categoria" width="200px" selectionChange="onFiltrarCategoria">
                                <core:Item key="BUENO" text="Bueno"/>
                                <core:Item key="EXCELENTE" text="Excelente"/>
                                <core:Item key="EXTRAORDINARIO" text="Extraordinario"/>
                            </ComboBox>
                        </HBox>
                        <HBox class="sapUiSmallMarginBottom">
                            <SearchField id="searchFieldPadres" tooltip="Buscar por nombre y placa de los padres" placeholder="Buscar por nombre y placa de los padres" width="300px" search="onBuscar2"/>
                            <ComboBox id="estadoFilter" placeholder="Filtrar por Estado" width="200px" selectionChange="onFiltrarEstado">
                                <core:Item key="ACTIVO" text="Activo"/>
                                <core:Item key="VENDIDO" text="Vendido"/>
                                <core:Item key="PRESTADO" text="Prestado"/>
                                <core:Item key="RETIRADO" text="Retirado"/>
                                <core:Item key="FALLECIDO" text="Fallecido"/>
                            </ComboBox>
                            <CheckBox id="padroteFilter" text="Padrote" select="onSelectPadrote"/>
                        </HBox>
                        <HBox class="sapUiSmallMarginBottom">
                            <Button text="Limpiar Filtros" press="onLimpiarFiltros"/>
                        </HBox>
                    </VBox>
                </Panel>

                <!-- Tabla de aves -->
                <Table id="avesTable" items="{aves>/value}" mode="MultiSelect" class="sapUiMediumMarginTop" selectionChange="onSelectionChange">

                    <headerToolbar>
                        <Toolbar>
                            <Title text="Aves Registradas ({= ${aves>/value}.length})"/>
                            <ToolbarSpacer/>
                            <Button text="Editar Seleccionada" enabled="{= ${table>/selectedIndex} >= 0}" press="onEditarAve" visible="false"/>
                            <Button text="Eliminar Seleccionada" type="Reject" enabled="{= ${table>/selectedIndex} >= 0}" press="onEliminarAve"/>
                        </Toolbar>
                    </headerToolbar>

                    <columns>
                        <Column width="8rem" minScreenWidth="Phone">
                            <Text text="Placa"/>
                        </Column>
                        <Column width="10rem" minScreenWidth="Phone">
                            <Text text="Nombre"/>
                        </Column>
                        <!-- <Column minScreenWidth="Desktop">
                            <Text text="Raza"/>
                        </Column> -->
                        <Column width="8rem" minScreenWidth="Phone">
                            <Text text="Fecha Nac."/>
                        </Column>
                        <!-- <Column width="3rem" minScreenWidth="Phone">
                            <Text text="Edad"/>
                        </Column> -->
                        <Column width="5rem" minScreenWidth="Phone">
                            <Text text="Género"/>
                        </Column>
                        <!-- <Column width="15rem" minScreenWidth="Phone">
                            <Text text="Criador de Procedencia"/>
                        </Column> -->
                        <Column width="8rem" minScreenWidth="Phone">
                            <Text text="Categoría"/>
                        </Column>
                        <Column width="5rem" minScreenWidth="Phone">
                            <Text text="Cría"/>
                        </Column>
                        <Column width="5rem" minScreenWidth="Phone">
                            <Text text="Estado"/>
                        </Column>
                        <Column width="5rem" minScreenWidth="Phone">
                            <Text text="Padrote"/>
                        </Column>
                        <Column width="7rem">
                            <Text text="Padre"/>
                        </Column>
                        <Column width="7rem">
                            <Text text="Madre"/>
                        </Column>
                        <Column width="8rem">
                            <Text text="Acciones"/>
                        </Column>
                    </columns>

                    <items>
                        <ColumnListItem press="onAvePress">
                            <Text text="{aves>placa}"/>
                            <Text text="{aves>nombre}"/>
                            <!-- <Text text="{aves>raza}"/> -->
                            <Text text="{
                                path: 'aves>fechaNacimiento',
                                formatter: '.formatearFecha'
                            }"/>
                            <!-- <Text text="{aves>edad}"/> -->
                            <Text text="{
                                path: 'aves>sexo',
                                formatter: '.formatearSexo'}"/>
                            <!-- <Text text="{aves>criador}"/> -->
                            <Text text="{
                                path: 'aves>categoria',
                                formatter: '.formatearCategoria'}"/>
                            <CheckBox selected="{aves>cria}" editable="false"/>
                            <ObjectStatus text="{
                                    path: 'aves>estado',
                                    formatter: '.formatearEstado'
                                }" state="{= ${aves>estado} === 'ACTIVO' ? 'Success' : 
                                         ${aves>estado} === 'PRESTADO' ? 'Information' :
                                         ${aves>estado} === 'RETIRADO' ? 'Information' :
                                         ${aves>estado} === 'VENDIDO' ? 'Warning' : 'Error'}"/>
                            <CheckBox selected="{aves>padrote}" editable="false"/>
                            <Link text="{aves>padre}" press="onPadreLinkPress"/>
                            <Link text="{aves>madre}" press="onMadreLinkPress"/>
                            <HBox>
                                <Button icon="sap-icon://edit" type="Transparent" tooltip="Editar" press="onEditarAveInline"/>
                                <Button icon="sap-icon://delete" type="Transparent" tooltip="Eliminar" press="onEliminarAveInline" visible="false"/>
                                <Button icon="sap-icon://detail-view" type="Transparent" tooltip="Ver detalle" press="onAvePress"/>
                            </HBox>
                        </ColumnListItem>
                    </items>
                </Table>

            </VBox>
        </content>
    </Page>

</mvc:View>