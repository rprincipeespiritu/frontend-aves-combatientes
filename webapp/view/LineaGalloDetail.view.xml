<mvc:View
    controllerName="com.rprincipees.registroavescombate.controller.LineaGalloDetail"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:form="sap.f"
    xmlns:f="sap.ui.layout.form">

    <Page
        title="Detalle de Linaje"
        showNavButton="true"
        navButtonPress=".onNavBack">
        <headerContent>
            <Button icon="sap-icon://home" press="onNavWelcome" type="Emphasized" />
            <form:Avatar
                id="userAvatar"
                src="{user>/foto}"
                displaySize="XS"
                press="onUserMenuPress"
                class="sapUiTinyMarginBegin sapUiTinyMarginEnd" />
        </headerContent>

        <content>
            <VBox class="sapUiMediumMargin">

                <ObjectHeader
                    title="{detalle>/linea/nombre}"
                    number="{
                                        path: 'detalle>/linea/estado',
                                        formatter: '.formatearEstado'
                                    }"
                    numberState="{= ${detalle>/linea/estado} === 'ACTIVA' ? 'Success' :
                                             ${detalle>/linea/estado} === 'INACTIVA' ? 'Warning' : 'Error'}">

                </ObjectHeader>

                <f:Form editable="false" class="sapUiSmallMargin">
                    <f:layout>
                        <f:ResponsiveGridLayout
                            columnsXL="1"
                            columnsL="1"
                            columnsM="1"
                            labelSpanXL="3"
                            labelSpanL="3"
                            labelSpanM="4"
                            labelSpanS="12"
                            emptySpanXL="0"
                            emptySpanL="0"
                            emptySpanM="0"
                            emptySpanS="0"
                            adjustLabelSpan="false"
                            singleContainerFullSize="false" />
                    </f:layout>
                    <f:formContainers>
                        <f:FormContainer>
                            <f:formElements>
                                <f:FormElement label="Objetivo">
                                    <f:fields>
                                        <Text text="{detalle>/linea/objetivo}" />
                                    </f:fields>
                                </f:FormElement>
                                <f:FormElement label="Descripción">
                                    <f:fields>
                                        <Text text="{detalle>/linea/descripcion}" />
                                    </f:fields>
                                </f:FormElement>
                                <f:FormElement label="Padre Fundador">
                                    <f:fields>
                                        <Link
                                            text="{detalle>/linea/aveFundador/placa} {detalle>/linea/aveFundador/nombre}"
                                            press="onVerPadre" />
                                    </f:fields>
                                </f:FormElement>
                                <f:FormElement label="Madre Fundadora">
                                    <f:fields>
                                        <Link
                                            text="{detalle>/linea/aveFundadora/placa} {detalle>/linea/aveFundadora/nombre}"
                                            press="onVerMadre" />
                                    </f:fields>
                                </f:FormElement>
                            </f:formElements>
                        </f:FormContainer>
                    </f:formContainers>
                </f:Form>

                <ScrollContainer
                    width="100%"
                    vertical="true"
                    horizontal="true"
                    class="listadoTablaScroll sapUiMediumMarginTop">
                <Table
                    items="{detalle>/planes}"
                    growing="true"
                    sticky="ColumnHeaders,HeaderToolbar"
                    class="listadoTabla">
                    <headerToolbar>
                        <OverflowToolbar>
                            <Title text="Planes de Cruce ({= ${detalle>/planes}.length})" />
                            <ToolbarSpacer />
                            <Button
                                text=""
                                type="Emphasized"
                                icon="sap-icon://add"
                                press=".onNuevoCruce" />
                            <Button icon="sap-icon://refresh" press="onRefresh" />
                        </OverflowToolbar>
                    </headerToolbar>

                    <columns>
                        <Column  minScreenWidth="Desktop" demandPopin="true" >
                            <Text text="Código" />
                        </Column>
                        <Column>
                            <Text text="Macho" />
                        </Column>
                        <Column>
                            <Text text="Hembra" />
                        </Column>
                        <Column minScreenWidth="Desktop" demandPopin="true">
                            <Text text="Tipo" />
                        </Column>
                        <Column minScreenWidth="Desktop" demandPopin="true">
                            <Text text="Parentesco" />
                        </Column>
                        <Column minScreenWidth="Desktop" demandPopin="true">
                            <Text text="Riesgo" />
                        </Column>
                        <Column minScreenWidth="Desktop" demandPopin="true">
                            <Text text="Decision" />
                        </Column>
                        <Column minScreenWidth="Desktop" demandPopin="true">
                            <Text text="Fecha" />
                        </Column>
                        <Column hAlign="Center" width="8rem">
                            <Text text="Acciones" />
                        </Column>
                    </columns>

                    <items>
                        <ColumnListItem type="Navigation" press=".onVerDetallePlan">
                            <cells>
                                <Text text="{detalle>codigo}" />
                                <ObjectIdentifier
                                    title="{detalle>macho/placa}"
                                    text="{
                                        parts: [
                                            { path: 'detalle>macho/nombre' },
                                            { path: 'detalle>macho/apodo' }
                                        ],
                                        formatter: '.formatter.formatAveNombre'
                                    }" />
                                <ObjectIdentifier
                                    title="{detalle>hembra/placa}"
                                    text="{
                                        parts: [
                                            { path: 'detalle>hembra/nombre' },
                                            { path: 'detalle>hembra/apodo' }
                                        ],
                                        formatter: '.formatter.formatAveNombre'
                                    }" />
                                <ObjectStatus
                                    text="{
                                        parts: [
                                            { path: 'detalle>tipoCruce' },
                                            { path: 'detalle>linea/nombre' }
                                        ],
                                        formatter: '.formatter.formatTipoFormacionCruceTexto'
                                    }"
                                    state="{
                                        parts: [
                                            { path: 'detalle>tipoCruce' },
                                            { path: 'detalle>linea/nombre' }
                                        ],
                                        formatter: '.formatter.formatTipoFormacionCruceState'
                                    }" />
                                <Text
                                    text="{
                                    path: 'detalle>tipoParentesco',
                                    formatter: '.formatearParentesco'
                                }" />
                                <ObjectStatus
                                    text="{ path: 'detalle>nivelRiesgo', formatter: '.formatter.formatNivelRiesgoTexto' }"
                                    state="{ path: 'detalle>nivelRiesgo', formatter: '.formatter.formatNivelRiesgoState' }" />
                                <ObjectStatus
                                    text="{ path: 'detalle>decision', formatter: '.formatter.formatDecisionTexto' }"
                                    state="{ path: 'detalle>decision', formatter: '.formatter.formatDecisionState' }" />
                                <Text text="{detalle>fechaPropuesta}" />
                                <HBox justifyContent="Center">
                                    <Button
                                        icon="sap-icon://edit"
                                        type="Emphasized"
                                        tooltip="Editar plan"
                                        press=".onEditarPlan" />
                                    <Button
                                        icon="sap-icon://delete"
                                        type="Transparent"
                                        tooltip="Eliminar plan"
                                        press=".onEliminarPlan" />
                                </HBox>
                            </cells>
                        </ColumnListItem>
                    </items>

                </Table>
                </ScrollContainer>

            </VBox>
        </content>
        <footer>
            <Toolbar>
                <ToolbarSpacer />
                <Button text="Cancelar" press="onNavBack" />
            </Toolbar>
        </footer>
    </Page>
</mvc:View>
