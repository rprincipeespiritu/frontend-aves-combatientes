<mvc:View controllerName="com.rprincipees.registroavescombate.controller.CruceCreate"
        xmlns:mvc="sap.ui.core.mvc"
        xmlns="sap.m"
        xmlns:f="sap.ui.layout.form"
        xmlns:core="sap.ui.core"
        xmlns:form="sap.f">

        <Page title="{cruce>/titulo}" showNavButton="true" navButtonPress=".onNavBack" class="cruceCreatePage">
                <headerContent>
                        <Button icon="sap-icon://home" press="onNavWelcome" type="Emphasized"/>
                        <form:Avatar id="userAvatar" src="{user>/foto}" displaySize="XS" press="onUserMenuPress" class="sapUiTinyMarginBegin sapUiTinyMarginEnd" />
                </headerContent>

                <content>
                        <VBox class="sapUiMediumMargin cruceCreateContent">

                                <Panel headerText="Información del linaje" visible="{cruce>/linajeVisible}" class="cruceLinajeInfoPanel">
                                        <VBox class="cruceLinajeInfoBody">
                                                <Title text="{cruce>/linaje/nombre}" level="H4" wrapping="true" class="sapUiTinyMarginBottom" />
                                                <ObjectStatus title="Objetivo" text="{= ${cruce>/linaje/objetivo} || 'Sin objetivo registrado' }" state="Information" class="sapUiTinyMarginBottom cruceLinajeStatus" />
                                                <Text text="{cruce>/linaje/descripcion}" wrapping="true" visible="{= !!${cruce>/linaje/descripcion} }" class="sapUiTinyMarginBottom" />
                                                <VBox width="100%" class="cruceLinajeFundadores">
                                                        <VBox width="100%" class="cruceLinajeFundadorItem">
                                                                <Label text="Padre fundador" />
                                                                <ObjectStatus text="{cruce>/linaje/fundadorTexto}" state="Success" icon="sap-icon://family-care" class="cruceLinajeStatus" />
                                                        </VBox>
                                                        <VBox width="100%" class="cruceLinajeFundadorItem">
                                                                <Label text="Madre fundadora" />
                                                                <ObjectStatus text="{cruce>/linaje/fundadoraTexto}" state="Success" icon="sap-icon://family-care" class="cruceLinajeStatus" />
                                                        </VBox>
                                                </VBox>
                                                <MessageStrip text="Para continuar el linaje, al menos uno de los reproductores debe aportar continuidad respecto a estos padres fundadores (mínimo 25% proyectado en la descendencia)." type="Information" showIcon="true" class="sapUiTinyMarginTop cruceLinajeHint" />
                                        </VBox>
                                </Panel>

                                <Panel headerText="{= ${cruce>/soloLectura} ? 'Reproductores' : 'Selección de reproductores' }" class="sapUiMediumMarginTop">
                                        <f:Form editable="{= !${cruce>/soloLectura} }" class="sapUiSmallMargin">
                                                <f:layout>
                                                        <f:ResponsiveGridLayout
                                                                columnsXL="2"
                                                                columnsL="2"
                                                                columnsM="1"
                                                                labelSpanXL="3"
                                                                labelSpanL="3"
                                                                labelSpanM="12"
                                                                labelSpanS="12"
                                                                emptySpanXL="0"
                                                                emptySpanL="0"
                                                                emptySpanM="0"
                                                                emptySpanS="0"
                                                                adjustLabelSpan="false"
                                                                singleContainerFullSize="true" />
                                                </f:layout>
                                                <f:formContainers>
                                                        <f:FormContainer>
                                                                <f:formElements>
                                                                        <f:FormElement label="Macho" required="{= !${cruce>/soloLectura} }">
                                                                                <f:fields>
                                                                                        <Input id="inputPadreLinea" placeholder="Seleccionar Macho" value="{cruce>/padrePlaca}" description="{cruce>/padreNombre}" showValueHelp="{= !${cruce>/soloLectura} }" valueHelpOnly="true" valueHelpRequest="onValueHelpPadre" editable="{= !${cruce>/soloLectura} }" width="100%" />
                                                                                </f:fields>
                                                                        </f:FormElement>
                                                                        <f:FormElement label="% sangre del linaje (macho)" visible="{= !${cruce>/cruceAbierto} &amp;&amp; ${cruce>/resultado/porcentajeMachoLinaje} !== undefined &amp;&amp; ${cruce>/resultado/porcentajeMachoLinaje} !== null }">
                                                                                <f:fields>
                                                                                        <ObjectNumber number="{cruce>/resultado/porcentajeMachoLinaje}" unit="%" state="{= ${cruce>/resultado/porcentajeMachoLinaje} &gt; 0 ? 'Success' : 'None' }" />
                                                                                </f:fields>
                                                                        </f:FormElement>
                                                                        <f:FormElement label="Hembra" required="{= !${cruce>/soloLectura} }">
                                                                                <f:fields>
                                                                                        <Input id="inputMadreLinea" placeholder="Seleccionar Hembra" value="{cruce>/madrePlaca}" description="{cruce>/madreNombre}" showValueHelp="{= !${cruce>/soloLectura} }" valueHelpOnly="true" valueHelpRequest="onValueHelpMadre" editable="{= !${cruce>/soloLectura} }" width="100%" />
                                                                                </f:fields>
                                                                        </f:FormElement>
                                                                        <f:FormElement label="% sangre del linaje (hembra)" visible="{= !${cruce>/cruceAbierto} &amp;&amp; ${cruce>/resultado/porcentajeHembraLinaje} !== undefined &amp;&amp; ${cruce>/resultado/porcentajeHembraLinaje} !== null }">
                                                                                <f:fields>
                                                                                        <ObjectNumber number="{cruce>/resultado/porcentajeHembraLinaje}" unit="%" state="{= ${cruce>/resultado/porcentajeHembraLinaje} &gt; 0 ? 'Success' : 'None' }" />
                                                                                </f:fields>
                                                                        </f:FormElement>
                                                                </f:formElements>
                                                        </f:FormContainer>
                                                        <f:FormContainer>
                                                                <f:formElements>
                                                                        <f:FormElement label="Parentesco calculado">
                                                                                <f:fields>
                                                                                        <VBox width="100%">
                                                                                                <Input value="{cruce>/parentescoTexto}" editable="false" busy="{cruce>/analisisEnCurso}" placeholder="Se calculará automáticamente" width="100%"/>
                                                                                                <Link
                                                                                                        text="Para mayor información del parentesco, visite el módulo 'Genealogía'"
                                                                                                        press=".onAbrirArbolGenealogico"
                                                                                                        wrapping="true"
                                                                                                        visible="{cruce>/resultadoVisible}"
                                                                                                        class="sapUiTinyMarginTop cruceParentescoHint" />
                                                                                        </VBox>
                                                                                </f:fields>
                                                                        </f:FormElement>
                                                                        <f:FormElement label="Objetivo del cruce">
                                                                                <f:fields>
                                                                                        <TextArea width="100%" rows="{= ${device>/system/phone} ? 4 : 3 }" growing="true" growingMaxLines="8" value="{cruce>/objetivoCruce}" editable="{= !${cruce>/soloLectura} }" placeholder="Ejemplo: fijar velocidad, corte, casta, tamaño, fertilidad..." />
                                                                                </f:fields>
                                                                        </f:FormElement>
                                                                </f:formElements>
                                                        </f:FormContainer>
                                                </f:formContainers>
                                        </f:Form>
                                        <HBox justifyContent="End" wrap="Wrap" visible="{= !${cruce>/soloLectura} }" class="sapUiSmallMargin cruceAnalizarActions">
                                                <Button
                                                        text="{= ${device>/system/phone} ? 'Analizar' : 'Analizar cruce' }"
                                                        type="Emphasized"
                                                        icon="sap-icon://decision"
                                                        press=".onAnalizarCruce"
                                                        class="cruceAnalizarBtn" />
                                        </HBox>
                                </Panel>

                                <Panel headerText="Resultado del análisis" visible="{cruce>/resultadoVisible}" class="sapUiMediumMarginTop">
                                        <VBox class="sapUiSmallMargin cruceResultadoBox">
                                                <ObjectStatus title="Tipo de formación" text="{ path: 'cruce>/resultado/tipoCruce', formatter: '.formatter.formatTipoFormacionCruceTexto' }" state="{ path: 'cruce>/resultado/tipoCruce', formatter: '.formatter.formatTipoFormacionCruceState' }" class="cruceLinajeStatus sapUiTinyMarginBottom" />
                                                <ObjectStatus title="Nivel de riesgo" text="{ path: 'cruce>/resultado/nivelRiesgo', formatter: '.formatter.formatNivelRiesgoTexto' }" state="{ path: 'cruce>/resultado/nivelRiesgo', formatter: '.formatter.formatNivelRiesgoState' }" class="cruceLinajeStatus sapUiTinyMarginBottom" />
                                                <ObjectStatus title="Decision sugerida" text="{ path: 'cruce>/resultado/decision', formatter: '.formatter.formatDecisionTexto' }" state="{ path: 'cruce>/resultado/decision', formatter: '.formatter.formatDecisionState' }" class="cruceLinajeStatus sapUiTinyMarginBottom" />
                                                <ObjectNumber number="{cruce>/resultado/porcentaje}" unit="% consanguinidad" class="sapUiTinyMarginBottom"/>
                                                <VBox visible="{= !${cruce>/cruceAbierto} &amp;&amp; ${cruce>/resultado/porcentajeLinajeProyectado} !== undefined &amp;&amp; ${cruce>/resultado/porcentajeLinajeProyectado} !== null }" class="sapUiSmallMarginTop sapUiSmallMarginBottom cruceSangreLinajeBox">
                                                        <Title text="Aporte de sangre al linaje" level="H5" class="sapUiTinyMarginBottom" />
                                                        <VBox width="100%" class="cruceSangreLinajeItems">
                                                                <VBox class="cruceSangreLinajeItem">
                                                                        <Label text="Sangre aportada por el macho" />
                                                                        <ObjectNumber number="{cruce>/resultado/porcentajeMachoLinaje}" unit="%" state="{= ${cruce>/resultado/porcentajeMachoLinaje} &gt; 0 ? 'Success' : 'None' }" />
                                                                </VBox>
                                                                <VBox class="cruceSangreLinajeItem">
                                                                        <Label text="Sangre aportada por la hembra" />
                                                                        <ObjectNumber number="{cruce>/resultado/porcentajeHembraLinaje}" unit="%" state="{= ${cruce>/resultado/porcentajeHembraLinaje} &gt; 0 ? 'Success' : 'None' }" />
                                                                </VBox>
                                                                <VBox class="cruceSangreLinajeItem">
                                                                        <Label text="Sangre proyectada en la descendencia" />
                                                                        <ObjectNumber number="{cruce>/resultado/porcentajeLinajeProyectado}" unit="%" state="{= ${cruce>/resultado/cumplePorcentajeLinaje} ? 'Success' : 'Error' }" />
                                                                </VBox>
                                                        </VBox>
                                                        <ObjectStatus
                                                                title="Continuidad del linaje"
                                                                text="{= ${cruce>/resultado/cumplePorcentajeLinaje} ? 'Cumple el mínimo de ' + ${cruce>/resultado/porcentajeMinimoLinaje} + '%' : 'No cumple el mínimo de ' + ${cruce>/resultado/porcentajeMinimoLinaje} + '%' }"
                                                                state="{= ${cruce>/resultado/cumplePorcentajeLinaje} ? 'Success' : 'Error' }"
                                                                class="cruceLinajeStatus sapUiTinyMarginTop" />
                                                </VBox>
                                                <Text text="{cruce>/resultado/descripcion}" wrapping="true" />
                                                <MessageStrip text="{cruce>/resultado/recomendacion}" type="{cruce>/resultado/messageType}" showIcon="true" class="sapUiSmallMarginTop"/>
                                        </VBox>
                                </Panel>

                        </VBox>
                </content>
                <footer>
                        <Toolbar class="cruceCreateFooter">
                                <ToolbarSpacer/>
                                <Button
                                        visible="{cruce>/soloLectura}"
                                        text="{= ${device>/system/phone} ? '' : 'Editar' }"
                                        tooltip="Editar plan de cruce"
                                        type="Emphasized"
                                        icon="sap-icon://edit"
                                        press=".onIrAEditarPlan"/>
                                <Button
                                        visible="{= !${cruce>/soloLectura} &amp;&amp; ${cruce>/puedeGuardar} }"
                                        text="{= ${device>/system/phone} ? '' : ${cruce>/guardarTexto} }"
                                        tooltip="{cruce>/guardarTexto}"
                                        type="Emphasized"
                                        icon="sap-icon://save"
                                        press=".onGuardarPlanCruce"/>
                                <Button
                                        visible="{= !${cruce>/soloLectura} &amp;&amp; ${cruce>/mostrarCruceAbierto} }"
                                        text="{= ${device>/system/phone} ? '' : 'Cruce abierto' }"
                                        type="Emphasized"
                                        icon="sap-icon://journey-change"
                                        press=".onContinuarComoCruceAbierto"
                                        tooltip="Guardar este cruce como Cruce abierto"/>
                                <Button
                                        text="{= ${device>/system/phone} ? '' : (${cruce>/soloLectura} ? 'Volver' : 'Cancelar') }"
                                        icon="{= ${device>/system/phone} ? 'sap-icon://nav-back' : '' }"
                                        tooltip="{= ${cruce>/soloLectura} ? 'Volver' : 'Cancelar' }"
                                        press="onNavBack"/>
                        </Toolbar>
                </footer>
        </Page>
</mvc:View>
