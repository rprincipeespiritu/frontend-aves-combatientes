<mvc:View
    controllerName="com.rprincipees.registroavescombate.controller.Genealogia"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.ui.layout.form"
    xmlns:graph="sap.suite.ui.commons.networkgraph"
    xmlns:layout="sap.suite.ui.commons.networkgraph.layout">

    <Page
        title="Arbol genealógico"
        showNavButton="true"
        navButtonPress=".onNavBack"
        xmlns:form="sap.f">
        <headerContent>
            <Button icon="sap-icon://home" press=".onNavWelcome" type="Emphasized" />
            <form:Avatar
                id="userAvatar"
                src="{user>/foto}"
                displaySize="XS"
                press="onUserMenuPress"
                class="sapUiTinyMarginBegin sapUiTinyMarginEnd" />
        </headerContent>

        <content>
            <VBox class="sapUiMediumMargin" busy="{genealogia>/busy}">
                <Panel headerText="Seleccion de ave">
                    <f:SimpleForm editable="true" layout="ResponsiveGridLayout" columnsL="3"
                        columnsM="2">
                        <f:content>
                            <Label text="Ave" />
                            <Input
                                id="inputAve"
                                placeholder="Seleccionar Ave"
                                value="{genealogia>/placa}"
                                description="{genealogia>/nombre}"
                                showValueHelp="true"
                                valueHelpOnly="true"
                                valueHelpRequest="onValueHelpAve"
                                width="100%" />
                            <!-- <Select
                                selectedKey="{genealogia>/aveSeleccionadaId}"
                                change=".onSeleccionarAve"
                                items="{genealogia>/aves}">
                                <core:Item
                                    key="{genealogia>ID}"
                                    text="{= ${genealogia>placa} + ' - ' + (${genealogia>nombre} || 'Sin nombre') }" />
                            </Select> -->

                            <Label text="Generaciones" />
                            <ObjectStatus text="Hasta 5 generaciones" state="Information" />

                            <Label text="Ancestros encontrados" />
                            <ObjectNumber number="{genealogia>/resumen/ancestrosIdentificados}" />
                        </f:content>
                    </f:SimpleForm>

                    <Toolbar>
                        <ToolbarSpacer />
                        <Button
                            text="Refrescar"
                            icon="sap-icon://refresh"
                            press=".onRefrescar" />
                    </Toolbar>
                </Panel>

                <Panel headerText="Resumen genealogico" class="sapUiMediumMarginTop">
                    <HBox wrap="Wrap" justifyContent="SpaceBetween">
                        <ObjectIdentifier
                            title="{genealogia>/aveSeleccionada/placa}"
                            text="{= ${genealogia>/aveSeleccionada/nombre} + (${genealogia>/aveSeleccionada/fechaNacimientoFmt} ? ' - Nac. ' + ${genealogia>/aveSeleccionada/fechaNacimientoFmt} : '') }" />
                        <ObjectStatus
                            text="{genealogia>/aveSeleccionada/estado}"
                            state="{= ${genealogia>/aveSeleccionada/estado} === 'ACTIVO' ? 'Success' : 'Warning' }" />
                        <ObjectNumber
                            number="{genealogia>/resumen/registrosFaltantes}"
                            unit="registros faltantes" />
                        <ObjectNumber
                            number="{genealogia>/resumen/hermanosCompletos}"
                            unit="hermanos completos" />
                        <ObjectNumber
                            number="{genealogia>/resumen/mediosHermanosPadre}"
                            unit="medios por padre" />
                        <ObjectNumber
                            number="{genealogia>/resumen/mediosHermanosMadre}"
                            unit="medios por madre" />
                    </HBox>
                </Panel>

                <HBox
                    wrap="Wrap"
                    renderType="Bare"
                    class="sapUiMediumMarginTop">
                    <Panel
                        headerText="Hermanos completos"
                        width="32rem"
                        class="sapUiSmallMarginEnd sapUiSmallMarginBottom">
                        <List
                            noDataText="No hay hermanos completos registrados."
                            items="{genealogia>/hermanos}">
                            <CustomListItem
                                type="Active"
                                press=".onSeleccionarHermano">
                                <HBox
                                    alignItems="Center"
                                    justifyContent="SpaceBetween"
                                    class="sapUiSmallMargin">
                                    <ObjectIdentifier
                                        title="{genealogia>placa}"
                                        text="{= (${genealogia>nombre} || 'Sin nombre') + (${genealogia>fechaNacimientoFmt} ? ' - Nac. ' + ${genealogia>fechaNacimientoFmt} : '') }" />
                                    <HBox alignItems="Center">
                                        <ObjectStatus
                                            text="{genealogia>sexoFmt}"
                                            state="Information"
                                            class="sapUiSmallMarginEnd" />
                                        <ObjectStatus
                                            text="{genealogia>estado}"
                                            state="{= ${genealogia>estado} === 'ACTIVO' ? 'Success' : 'Warning' }" />
                                    </HBox>
                                </HBox>
                            </CustomListItem>
                        </List>
                    </Panel>

                    <Panel
                        headerText="Medios hermanos por padre"
                        width="32rem"
                        class="sapUiSmallMarginEnd sapUiSmallMarginBottom">
                        <List
                            noDataText="No hay medios hermanos por padre."
                            items="{genealogia>/mediosHermanosPadre}">
                            <CustomListItem
                                type="Active"
                                press=".onSeleccionarHermano">
                                <HBox
                                    alignItems="Center"
                                    justifyContent="SpaceBetween"
                                    class="sapUiSmallMargin">
                                    <ObjectIdentifier
                                        title="{genealogia>placa}"
                                        text="{= (${genealogia>nombre} || 'Sin nombre') + (${genealogia>fechaNacimientoFmt} ? ' - Nac. ' + ${genealogia>fechaNacimientoFmt} : '') }" />
                                    <HBox alignItems="Center">
                                        <ObjectStatus
                                            text="{genealogia>sexoFmt}"
                                            state="Information"
                                            class="sapUiSmallMarginEnd" />
                                        <ObjectStatus
                                            text="{genealogia>estado}"
                                            state="{= ${genealogia>estado} === 'ACTIVO' ? 'Success' : 'Warning' }" />
                                    </HBox>
                                </HBox>
                            </CustomListItem>
                        </List>
                    </Panel>

                    <Panel
                        headerText="Medios hermanos por madre"
                        width="32rem"
                        class="sapUiSmallMarginEnd sapUiSmallMarginBottom">
                        <List
                            noDataText="No hay medios hermanos por madre."
                            items="{genealogia>/mediosHermanosMadre}">
                            <CustomListItem
                                type="Active"
                                press=".onSeleccionarHermano">
                                <HBox
                                    alignItems="Center"
                                    justifyContent="SpaceBetween"
                                    class="sapUiSmallMargin">
                                    <ObjectIdentifier
                                        title="{genealogia>placa}"
                                        text="{= (${genealogia>nombre} || 'Sin nombre') + (${genealogia>fechaNacimientoFmt} ? ' - Nac. ' + ${genealogia>fechaNacimientoFmt} : '') }" />
                                    <HBox alignItems="Center">
                                        <ObjectStatus
                                            text="{genealogia>sexoFmt}"
                                            state="Information"
                                            class="sapUiSmallMarginEnd" />
                                        <ObjectStatus
                                            text="{genealogia>estado}"
                                            state="{= ${genealogia>estado} === 'ACTIVO' ? 'Success' : 'Warning' }" />
                                    </HBox>
                                </HBox>
                            </CustomListItem>
                        </List>
                    </Panel>
                </HBox>

                <graph:Graph
                    id="genealogyGraph"
                    class="genealogyNetworkGraph sapUiMediumMarginTop"
                    height="42rem"
                    orientation="TopBottom"
                    enableWheelZoom="true"
                    nodes="{genealogia>/graph/nodes}"
                    lines="{genealogia>/graph/lines}">
                    <graph:layoutAlgorithm>
                        <layout:LayeredLayout
                            nodePlacement="BrandesKoepf"
                            nodeSpacing="56"
                            layerSpacing="92" />
                    </graph:layoutAlgorithm>
                    <graph:statuses>
                        <graph:Status key="Base" title="Ave seleccionada" backgroundColor="#fff0b3" borderColor="#d99a00" />
                        <graph:Status key="Padre" title="Padre" backgroundColor="#e5f2ff" borderColor="#0a6ed1" />
                        <graph:Status key="Madre" title="Madre" backgroundColor="#f4e8ff" borderColor="#8a3ffc" />
                        <graph:Status key="Faltante" title="Sin registro" backgroundColor="#f2f4f5" borderColor="#89919a" />
                        <graph:Status key="Linea" title="Relacion" borderColor="#6a7d90" />
                    </graph:statuses>
                    <graph:nodes>
                        <graph:Node
                            key="{genealogia>key}"
                            title="{genealogia>title}"
                            description="{genealogia>description}"
                            icon="{genealogia>icon}"
                            shape="{genealogia>shape}"
                            width="{genealogia>width}"
                            status="{genealogia>status}"
                            press=".onVerImagenAve">
                            <graph:attributes>
                                <graph:ElementAttribute label="Rol" value="{genealogia>rol}" />
                                <graph:ElementAttribute label="Sexo" value="{genealogia>sexo}" />
                                <graph:ElementAttribute label="Estado" value="{genealogia>estado}" />
                            </graph:attributes>
                        </graph:Node>
                    </graph:nodes>
                    <graph:lines>
                        <graph:Line
                            from="{genealogia>from}"
                            to="{genealogia>to}"
                            status="{genealogia>status}"
                            arrowPosition="End" />
                    </graph:lines>
                </graph:Graph>
            </VBox>
        </content>
        <footer>
            <Toolbar>
                <ToolbarSpacer/>                
                <Button text="Cancelar" press="onNavBack"/>
            </Toolbar>
        </footer>
    </Page>
</mvc:View>
