<mvc:View controllerName="com.rprincipees.registroavescombate.controller.AveDetail"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.ui.layout.form"
    xmlns:core="sap.ui.core"
    xmlns:u="sap.ui.unified"
    xmlns:form="sap.f">

    <Page title="Detalle del Ave" showNavButton="true" navButtonPress="onNavBack">
        <headerContent>
            <Button icon="sap-icon://home" press="onNavWelcome" type="Emphasized" />
            <Button text="{planIndicator>/text}" icon="{planIndicator>/icon}"
                type="{planIndicator>/type}" visible="{planIndicator>/visible}"
                class="planHeaderButton sapUiTinyMarginEnd" />
            <form:Avatar
                id="userAvatar"
                src="{user>/foto}"
                displaySize="XS"
                press="onUserMenuPress"
                class="sapUiTinyMarginBegin sapUiTinyMarginEnd" />
        </headerContent>
        <content>
            <VBox class="sapUiMediumMargin">

                <!-- Header con foto y datos básicos -->
                <HBox class="sapUiMediumMarginBottom" alignItems="Center">
                    <Avatar src="{detail>/fotoPrincipal}" displaySize="XL"
                        class="sapUiMediumMarginEnd" />
                    <VBox>
                        <Title text="{detail>/nombre}" level="H2" />
                        <Text text="Placa: {detail>/placa}" />
                        <ObjectStatus
                            text="{
                                    path: 'detail>/estado',
                                    formatter: '.formatearEstado'
                                }"
                            state="{= ${detail>/estado} === 'ACTIVO' ? 'Success' :
                                   ${detail>/estado} === 'VENDIDO' ? 'Warning' :
                                   ${detail>/estado} === 'FALLECIDO' ? 'Error' : 'None'}" />
                    </VBox>
                </HBox>

                <!-- Identificación -->
                <Panel headerText="Identificación" expandable="false">
                    <f:SimpleForm layout="ResponsiveGridLayout" editable="{detail>/editMode}"
                        columnsL="2" columnsM="1">
                        <f:content>
                            <Label text="Placa" />
                            <ObjectStatus
                                text="{
                                path: 'detail>/placa'
                                }"
                                state="Information" />

                            <Label text="Nombre" />
                            <Text text="{detail>/nombre}" />

                            <Label text="Apodo" />
                            <Text text="{detail>/apodo}" />

                            <Label text="Género" />
                            <ObjectStatus
                                text="{
                                path: 'detail>/sexo',
                                formatter: '.formatearSexo'
                                }"
                                state="Information" />

                            <!-- <Select selectedKey="{detail>/sexo}" enabled="{detail>/editMode}">
                                <core:Item key="M" text="Macho"/>
                                <core:Item key="H" text="Hembra"/>
                            </Select> -->

                            <Label text="Cría" />
                            <CheckBox selected="{detail>/cria}" editable="false" />

                            <Label text="Estado" />
                            <ObjectStatus
                                text="{
                                    path: 'detail>/estado',
                                    formatter: '.formatearEstado'
                                }"
                                state="{= ${detail>/estado} === 'ACTIVO' ? 'Success' :
                                   ${detail>/estado} === 'VENDIDO' ? 'Warning' :
                                   ${detail>/estado} === 'FALLECIDO' ? 'Error' : 'None'}" />
                            <!-- <Text
                                text="{
                                    path: 'detail>/estado',
                                    formatter: '.formatearEstado'
                                }" /> -->
                            <!-- <Select selectedKey="{detail>/estado}"
                            enabled="{detail>/editMode}">
                                <core:Item key="ACTIVO" text="Activo"/>
                                <core:Item key="VENDIDO" text="Vendido"/>
                                <core:Item key="FALLECIDO" text="Fallecido"/>
                                <core:Item key="PRESTADO" text="Prestado"/>
                            </Select> -->

                            <Label text="Ubicación" />
                            <Text text="{detail>/ubicacion}" editable="{detail>/editMode}" />

                            <Label text="Padrote" />
                            <CheckBox selected="{detail>/padrote}" editable="false" />

                            <Label text="Calificación" />
                            <Text
                                text="{
                                    path: 'detail>/categoria',
                                    formatter: '.formatearCategoria'
                                }" />
                            <!-- <Select selectedKey="{detail>/categoria}" editable="false">
                                <core:Item key="BUENO" text="Bueno"/>
                                <core:Item key="EXCELENTE" text="Excelente"/>
                                <core:Item key="EXTRAORDINARIO" text="Extraordinario"/>
                            </Select> -->

                        </f:content>
                    </f:SimpleForm>
                </Panel>

                <!-- Estadísticas -->
                <Panel headerText="Estadísticas" expandable="false" class="sapUiSmallMarginTop"
                    visible="false">
                    <HBox justifyContent="SpaceAround" class="sapUiSmallMargin">
                        <VBox alignItems="Center">
                            <Title text="{detail>/totalPeleas}" level="H2" />
                            <Label text="Total Peleas" />
                        </VBox>
                        <VBox alignItems="Center">
                            <Title text="{detail>/peleasGanadas}" level="H2"
                                class="sapThemePositiveText" />
                            <Label text="Victorias" />
                        </VBox>
                        <VBox alignItems="Center">
                            <Title text="{detail>/porcentajeVictorias}" level="H2" />
                            <Label text="% Victorias" />
                        </VBox>
                        <VBox alignItems="Center">
                            <Title text="{detail>/pesoActual}" level="H2" />
                            <Label text="Peso Actual (kg)" />
                        </VBox>
                        <VBox alignItems="Center">
                            <Title text="{detail>/edad}" level="H2" />
                            <Label text="Edad (años)" />
                        </VBox>
                    </HBox>
                </Panel>

                <!-- Características -->
                <Panel headerText="Características Físicas" expandable="true" expanded="true"
                    class="sapUiSmallMarginTop">
                    <f:SimpleForm layout="ResponsiveGridLayout" editable="{detail>/editMode}"
                        columnsL="2" columnsM="1">
                        <f:content>
                            <Label text="Raza" />
                            <Text text="{detail>/raza}" visible="true" />

                            <Label text="Color" />
                            <Text text="{detail>/color}" visible="true" />

                            <Label text="Tipo de Ave" />
                            <Text text="{detail>/tipoAve}" visible="true" />

                            <Label text="Fecha Nacimiento" />
                            <Text
                                text="{
                                path: 'detail>/fechaNacimiento',
                                formatter: '.formatearFecha'
                            }" />
                            <!-- <Text text="{detail>/fechaNacimiento}" visible="true" /> -->

                            <Label text="Fecha Compra" />
                            <Text text="{detail>/fechaCompra}" visible="true" />

                        </f:content>
                    </f:SimpleForm>
                </Panel>

                <Panel headerText="Archivos del ave" expandable="true" expanded="true"
                    visible="{dashboard>/multimediaPremium}"
                    class="sapUiSmallMarginTop">
                    <VBox class="sapUiSmallMargin">
                        <HBox alignItems="Center" wrap="Wrap" class="sapUiTinyMarginBottom">
                            <u:FileUploader
                                id="archivosAveDetailUploader"
                                buttonText="Agregar imagenes o videos"
                                fileType="jpg,jpeg,png,webp,mp4,mov,avi,mkv,webm"
                                mimeType="image/jpeg,image/png,image/webp,video/mp4,video/quicktime,video/x-msvideo,video/x-matroska,video/webm"
                                multiple="true"
                                sameFilenameAllowed="true"
                                change=".onArchivosAveDetailChange" />
                            <ObjectStatus
                                class="sapUiSmallMarginBegin"
                                text="{= 'Disponibles: ' + ${detail>/archivosRestantes} + ' de 3'}"
                                state="{= ${detail>/archivosRestantes} > 0 ? 'Information' : 'Warning'}" />
                        </HBox>
                        <Table items="{detail>/archivosAve}" noDataText="Sin archivos registrados">
                            <columns>
                                <Column minScreenWidth="Desktop" demandPopin="true" >
                                    <Text text="Archivo" />
                                </Column>
                                <Column width="15%">
                                    <Text text="Vista" />
                                </Column>
                                <Column width="15%" minScreenWidth="Desktop" demandPopin="true">
                                    <Text text="Estado" />
                                </Column>
                                <Column width="10%">
                                    <Text text="Acciones" />
                                </Column>
                            </columns>
                            <items>
                                <ColumnListItem>
                                    <cells>
                                        <HBox alignItems="Center">
                                            <ObjectStatus
                                                icon="{= ${detail>tipo} === 'IMAGEN' ? 'sap-icon://picture' : 'sap-icon://video'}"
                                                state="Information" />
                                            <Text text="{detail>nombreVisual}" class="sapUiSmallMarginBegin" />
                                        </HBox>
                                        <Button
                                            text="Ver"
                                            icon="{= ${detail>tipo} === 'VIDEO' ? 'sap-icon://video' : 'sap-icon://picture'}"
                                            type="Transparent"
                                            press=".onVerArchivoAve" />
                                        <ObjectStatus
                                            text="{detail>estadoArchivoTexto}"
                                            state="{detail>estadoArchivoState}"
                                            icon="{detail>estadoArchivoIcon}" />
                                        <Button icon="sap-icon://delete" type="Transparent"
                                            tooltip="Quitar archivo" press=".onEliminarArchivoAve" />
                                    </cells>
                                </ColumnListItem>
                            </items>
                        </Table>
                    </VBox>
                </Panel>

                <Panel headerText="Evaluacion reproductiva" expandable="true" expanded="true"
                    class="sapUiSmallMarginTop">
                    <Table items="{detail>/evaluaciones}" noDataText="Sin evaluaciones registradas">
                        <headerToolbar>
                            <OverflowToolbar>
                                <ToolbarSpacer />
                                <Button text="Nueva evaluacion" type="Emphasized"
                                    icon="sap-icon://add" press=".onAbrirEvaluacionDialog" />
                            </OverflowToolbar>
                        </headerToolbar>
                        <columns>
                            <Column width="10%">
                                <Text text="Fecha" />
                            </Column>
                            <Column width="10%">
                                <Text text="Vigor" />
                            </Column>
                            <Column width="10%" minScreenWidth="Desktop" demandPopin="true">
                                <Text text="Salud" />
                            </Column>
                            <Column width="10%" minScreenWidth="Desktop" demandPopin="true">
                                <Text text="Fertilidad" />
                            </Column>
                            <Column width="10%" minScreenWidth="Desktop" demandPopin="true">
                                <Text text="Apto" />
                            </Column>
                            <Column width="20%" minScreenWidth="Desktop" demandPopin="true">
                                <Text text="Defectos observados" />
                            </Column>
                            <Column width="20%" minScreenWidth="Desktop" demandPopin="true">
                                <Text text="Recomendacion" />
                            </Column>
                            <Column width="10%">
                                <Text text="Acciones" />
                            </Column>
                        </columns>
                        <items>
                            <ColumnListItem>
                                <cells>
                                    <Text text="{detail>fecha}" />
                                    <ObjectNumber number="{detail>vigor}" />
                                    <ObjectNumber number="{detail>saludGeneral}" />
                                    <ObjectNumber number="{detail>fertilidad}" />
                                    <ObjectStatus
                                        text="{= ${detail>aptoReproduccion} ? 'Si' : 'No'}"
                                        state="{= ${detail>aptoReproduccion} ? 'Success' : 'Error'}" />
                                    <Text text="{detail>defectosObservados}" />
                                    <Text text="{detail>recomendacion}" />
                                    <Button icon="sap-icon://edit" type="Transparent"
                                        tooltip="Editar" press=".onEditarEvaluacion" />
                                </cells>
                            </ColumnListItem>
                        </items>
                    </Table>
                </Panel>

                <Panel headerText="Evaluacion de pleito" expandable="true" expanded="true"
                    class="sapUiSmallMarginTop">
                    <Table items="{detail>/evaluacionesPleito}"
                        noDataText="Sin evaluaciones de pleito registradas">
                        <headerToolbar>
                            <OverflowToolbar>
                                <ToolbarSpacer />
                                <Button text="Nueva evaluacion" type="Emphasized"
                                    icon="sap-icon://add" press=".onAbrirEvaluacionPleitoDialog" />
                            </OverflowToolbar>
                        </headerToolbar>
                        <columns>
                            <Column width="10%">
                                <Text text="Fecha" />
                            </Column>
                            <Column width="14%">
                                <Text text="Calificacion" />
                            </Column>
                            <Column width="10%" minScreenWidth="Desktop" demandPopin="true">
                                <Text text="Bravura" />
                            </Column>
                            <Column width="10%" minScreenWidth="Desktop" demandPopin="true">
                                <Text text="Tecnica" />
                            </Column>
                            <Column width="10%" minScreenWidth="Desktop" demandPopin="true">
                                <Text text="Resistencia" />
                            </Column>
                            <Column width="12%" minScreenWidth="Desktop" demandPopin="true">
                                <Text text="Cond. fisica" />
                            </Column>
                            <Column width="24%" minScreenWidth="Desktop" demandPopin="true">
                                <Text text="Observaciones" />
                            </Column>
                            <Column width="10%">
                                <Text text="Acciones" />
                            </Column>
                        </columns>
                        <items>
                            <ColumnListItem>
                                <cells>
                                    <Text
                                        text="{path: 'detail>fecha', formatter: '.formatearFecha'}" />
                                    <ObjectStatus
                                        text="{path: 'detail>calificacion', formatter: '.formatearCategoria'}"
                                        state="{= ${detail>calificacion} === 'EXCELENTE' || ${detail>calificacion} === 'EXTRAORDINARIO' ? 'Success' : ${detail>calificacion} === 'REGULAR' ? 'Warning' : ${detail>calificacion} === 'PESIMO' ? 'Error' : 'Information'}" />
                                    <ObjectNumber number="{detail>bravura}" />
                                    <ObjectNumber number="{detail>tecnica}" />
                                    <ObjectNumber number="{detail>resistencia}" />
                                    <ObjectNumber number="{detail>condicionFisica}" />
                                    <Text text="{detail>observaciones}" />
                                    <HBox>
                                        <Button icon="sap-icon://edit" type="Transparent"
                                            tooltip="Editar" press=".onEditarEvaluacionPleito" />
                                        <Button icon="sap-icon://delete" type="Transparent"
                                            tooltip="Eliminar" press=".onEliminarEvaluacionPleito" />
                                    </HBox>
                                </cells>
                            </ColumnListItem>
                        </items>
                    </Table>
                </Panel>

                <!-- Genealogía -->
                <Panel headerText="Genealogía" expandable="true" expanded="true"
                    class="sapUiSmallMarginTop">
                    <f:SimpleForm layout="ResponsiveGridLayout" editable="false" columnsL="2"
                        columnsM="1">
                        <f:content>
                            <Label text="Padre" />
                            <Link text="{detail>/padre/placa} {detail>/padre/nombre}"
                                press="onVerPadre" />

                            <Label text="Madre" />
                            <Link text="{detail>/madre/placa} {detail>/madre/nombre}"
                                press="onVerMadre" />

                            <Label text="Procedencia" />
                            <Input value="{detail>/procedencia}" editable="false" />

                            <Label text="Criador" />
                            <Input value="{detail>/criador}" editable="false" />

                            <Label text="Arbol Genealógico"
                                visible="{= ${dashboard>/accesoSuscripcion} &amp;&amp; (${dashboard>/plan} === 'PRO' || ${dashboard>/plan} === 'PREMIUM') }" />
                            <Button icon="sap-icon://org-chart" type="Emphasized"
                                press="onVerArbGen" width="5rem" tooltip="Ver Arbol Genealógico"
                                visible="{= ${dashboard>/accesoSuscripcion} &amp;&amp; (${dashboard>/plan} === 'PRO' || ${dashboard>/plan} === 'PREMIUM') }" />

                        </f:content>
                    </f:SimpleForm>
                </Panel>

                <!-- Pesajes recientes -->
                <!-- <Panel headerText="Pesajes Recientes" expandable="true" expanded="false"
                class="sapUiSmallMarginTop">
                    <headerToolbar>
                        <Toolbar>
                            <Title text="Pesajes Recientes"/>
                            <ToolbarSpacer/>
                            <Button text="Agregar Pesaje" icon="sap-icon://add" press="onAgregarPesaje"/>
                        </Toolbar>
                    </headerToolbar>
                    <Table items="{detail>/pesajes}" noDataText="Sin pesajes registrados">
                        <columns>
                            <Column>
                                <Text text="Fecha"/>
                            </Column>
                            <Column>
                                <Text text="Peso (kg)"/>
                            </Column>
                            <Column>
                                <Text text="Condición"/>
                            </Column>
                            <Column>
                                <Text text="Observaciones"/>
                            </Column>
                        </columns>
                        <items>
                            <ColumnListItem>
                                <Text text="{detail>fecha}"/>
                                <Text text="{detail>peso}"/>
                                <ObjectStatus text="{detail>condicionFisica}" state="{= ${detail>condicionFisica} === 'EXCELENTE' ?
                'Success' :
                                           ${detail>condicionFisica} === 'BUENA' ? 'Success' :
                                           ${detail>condicionFisica} === 'REGULAR' ? 'Warning' : 'Error'}"/>
                                <Text text="{detail>observaciones}"/>
                            </ColumnListItem>
                        </items>
                    </Table>
                </Panel>-->

                <!-- Peleas recientes -->
                <!-- <Panel headerText="Peleas" expandable="true" expanded="false"
                class="sapUiSmallMarginTop">
                    <Table items="{detail>/peleas}" noDataText="Sin peleas registradas">
                        <columns>
                            <Column>
                                <Text text="Fecha"/>
                            </Column>
                            <Column>
                                <Text text="Lugar"/>
                            </Column>
                            <Column>
                                <Text text="Resultado"/>
                            </Column>
                            <Column>
                                <Text text="Oponente"/>
                            </Column>
                        </columns>
                        <items>
                            <ColumnListItem>
                                <Text text="{detail>fecha}"/>
                                <Text text="{detail>lugar}"/>
