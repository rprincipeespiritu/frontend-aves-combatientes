<mvc:View controllerName="com.rprincipees.registroavescombate.controller.AveDetail"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.ui.layout.form"
    xmlns:core="sap.ui.core"
    xmlns:u="sap.ui.unified"
    xmlns:form="sap.f">

    <Page title="Detalle del Ave" showNavButton="true" navButtonPress="onNavBack">
        <headerContent>
            <Button icon="sap-icon://home" press="onNavWelcome" type="Emphasized" />
            <form:Avatar
                id="userAvatar"
                src="{user>/foto}"
                displaySize="XS"
                press="onUserMenuPress"
                class="sapUiTinyMarginBegin sapUiTinyMarginEnd" />
        </headerContent>
        <content>
            <VBox class="sapUiMediumMargin">

                <!-- Header con foto y datos básicos -->
                <HBox class="sapUiMediumMarginBottom" alignItems="Center">
                    <Image
                        src="{detail>/fotoPrincipal}"
                        visible="{= !!${detail>/fotoPrincipal} }"
                        decorative="false"
                        alt="{= ${detail>/placa} + ' ' + ${detail>/nombre} }"
                        press=".onVerFotoPrincipal"
                        class="avePrincipalHeaderImage sapUiMediumMarginEnd" />
                    <!-- <Avatar
                        icon="sap-icon://picture"
                        displaySize="XL"
                        visible="{= !${detail>/fotoPrincipal} }"
                        class="sapUiMediumMarginEnd" /> -->
                    <VBox>
                        <Title text="{detail>/nombre}" level="H2" />
                        <Text text="Placa: {detail>/placa}" />
                        <ObjectStatus
                            text="{
                                    path: 'detail>/estado',
                                    formatter: '.formatearEstado'
                                }"
                            state="{= ${detail>/estado} === 'ACTIVO' ? 'Success' :
                                   ${detail>/estado} === 'VENDIDO' ? 'Warning' :
                                   ${detail>/estado} === 'FALLECIDO' ? 'Error' : 'None'}" />
                    </VBox>
                </HBox>

                <!-- Identificación -->
                <Panel headerText="Identificación" expandable="false">
                    <f:Form editable="false" class="sapUiSmallMargin">
                        <f:layout>
                            <f:ResponsiveGridLayout
                                columnsXL="2"
                                columnsL="2"
                                columnsM="2"
                                labelSpanXL="3"
                                labelSpanL="3"
                                labelSpanM="4"
                                labelSpanS="12"
                                emptySpanXL="0"
                                emptySpanL="0"
                                emptySpanM="0"
                                emptySpanS="0"
                                adjustLabelSpan="false"
                                singleContainerFullSize="false" />
                        </f:layout>
                        <f:formContainers>
                            <f:FormContainer>
                                <f:formElements>
                                    <f:FormElement label="Placa">
                                        <f:fields>
                                            <ObjectStatus
                                                text="{path: 'detail>/placa'}"
                                                state="Information" />
                                        </f:fields>
                                    </f:FormElement>
                                    <f:FormElement label="Nombre">
                                        <f:fields>
                                            <Text text="{detail>/nombre}" />
                                        </f:fields>
                                    </f:FormElement>
                                    <f:FormElement label="Apodo">
                                        <f:fields>
                                            <Text text="{detail>/apodo}" />
                                        </f:fields>
                                    </f:FormElement>
                                    <f:FormElement label="Género">
                                        <f:fields>
                                            <ObjectStatus
                                                text="{
                                                    path: 'detail>/sexo',
                                                    formatter: '.formatearSexo'
                                                }"
                                                state="Information" />
                                        </f:fields>
                                    </f:FormElement>
                                    <f:FormElement label="Cría">
                                        <f:fields>
                                            <CheckBox selected="{detail>/cria}" editable="false" />
                                        </f:fields>
                                    </f:FormElement>
                                </f:formElements>
                            </f:FormContainer>
                            <f:FormContainer>
                                <f:formElements>
                                    <f:FormElement label="Estado">
                                        <f:fields>
                                            <ObjectStatus
                                                text="{
                                                    path: 'detail>/estado',
                                                    formatter: '.formatearEstado'
                                                }"
                                                state="{= ${detail>/estado} === 'ACTIVO' ? 'Success' :
                                                   ${detail>/estado} === 'VENDIDO' ? 'Warning' :
                                                   ${detail>/estado} === 'FALLECIDO' ? 'Error' : 'None'}" />
                                        </f:fields>
                                    </f:FormElement>
                                    <f:FormElement label="Fecha de fallecimiento"
                                        visible="{= ${detail>/estado} === 'FALLECIDO' }">
                                        <f:fields>
                                            <Text
                                                text="{
                                                    path: 'detail>/fechaFallecimiento',
                                                    formatter: '.formatearFecha'
                                                }" />
                                        </f:fields>
                                    </f:FormElement>
                                    <f:FormElement label="Ubicación">
                                        <f:fields>
                                            <Text text="{detail>/ubicacion}" />
                                        </f:fields>
                                    </f:FormElement>
                                    <f:FormElement label="Padrote">
                                        <f:fields>
                                            <CheckBox selected="{detail>/padrote}" editable="false" />
                                        </f:fields>
                                    </f:FormElement>
                                    <f:FormElement label="Calificación">
                                        <f:fields>
                                            <Text
                                                text="{
                                                    path: 'detail>/categoria',
                                                    formatter: '.formatearCategoria'
                                                }" />
                                        </f:fields>
                                    </f:FormElement>
                                </f:formElements>
                            </f:FormContainer>
                        </f:formContainers>
                    </f:Form>
                </Panel>

                <!-- Estadísticas -->
                <Panel headerText="Estadísticas" expandable="false" class="sapUiSmallMarginTop"
                    visible="false">
                    <HBox justifyContent="SpaceAround" class="sapUiSmallMargin">
                        <VBox alignItems="Center">
                            <Title text="{detail>/totalPeleas}" level="H2" />
                            <Label text="Total Peleas" />
                        </VBox>
                        <VBox alignItems="Center">
                            <Title text="{detail>/peleasGanadas}" level="H2"
                                class="sapThemePositiveText" />
                            <Label text="Victorias" />
                        </VBox>
                        <VBox alignItems="Center">
                            <Title text="{detail>/porcentajeVictorias}" level="H2" />
                            <Label text="% Victorias" />
                        </VBox>
                        <VBox alignItems="Center">
                            <Title text="{detail>/pesoActual}" level="H2" />
                            <Label text="Peso Actual (kg)" />
                        </VBox>
                        <VBox alignItems="Center">
                            <Title text="{detail>/edad}" level="H2" />
                            <Label text="Edad (años)" />
                        </VBox>
                    </HBox>
                </Panel>

                <!-- Características -->
                <Panel headerText="Características Físicas" expandable="true" expanded="true"
                    class="sapUiSmallMarginTop">
                    <f:Form editable="false" class="sapUiSmallMargin">
                        <f:layout>
                            <f:ResponsiveGridLayout
                                columnsXL="1"
                                columnsL="1"
                                columnsM="1"
                                labelSpanXL="3"
                                labelSpanL="3"
                                labelSpanM="4"
                                labelSpanS="12"
                                emptySpanXL="0"
                                emptySpanL="0"
                                emptySpanM="0"
                                emptySpanS="0"
                                adjustLabelSpan="false"
                                singleContainerFullSize="false" />
                        </f:layout>
                        <f:formContainers>
                            <f:FormContainer>
                                <f:formElements>
                                    <f:FormElement label="Raza">
                                        <f:fields>
                                            <Text text="{detail>/raza}" visible="true" />
                                        </f:fields>
                                    </f:FormElement>
                                    <f:FormElement label="Color">
                                        <f:fields>
                                            <Text text="{detail>/color}" visible="true" />
                                        </f:fields>
                                    </f:FormElement>
                                    <f:FormElement label="Tipo de Ave">
                                        <f:fields>
                                            <Text text="{detail>/tipoAve}" visible="true" />
                                        </f:fields>
                                    </f:FormElement>
                                    <f:FormElement label="Fecha Nacimiento">
                                        <f:fields>
                                            <Text
                                                text="{
                                                    path: 'detail>/fechaNacimiento',
                                                    formatter: '.formatearFecha'
                                                }" />
                                        </f:fields>
                                    </f:FormElement>
                                    <f:FormElement label="Fecha Compra">
                                        <f:fields>
                                            <Text text="{detail>/fechaCompra}" visible="true" />
                                        </f:fields>
                                    </f:FormElement>
                                </f:formElements>
                            </f:FormContainer>
                        </f:formContainers>
                    </f:Form>
                </Panel>

                <Panel headerText="Archivos del ave" expandable="true" expanded="true"
                    visible="{dashboard>/multimediaPremium}"
                    class="sapUiSmallMarginTop">
                    <VBox class="sapUiSmallMargin">
                        <HBox alignItems="Center" wrap="Wrap" class="sapUiTinyMarginBottom">
                            <u:FileUploader
                                id="archivosAveDetailUploader"
                                buttonText="Agregar imagenes o videos"
                                fileType="jpg,jpeg,png,webp,mp4,mov,avi,mkv,webm"
                                mimeType="image/jpeg,image/png,image/webp,video/mp4,video/quicktime,video/x-msvideo,video/x-matroska,video/webm"
                                multiple="true"
                                sameFilenameAllowed="true"
                                change=".onArchivosAveDetailChange" />
                            <ObjectStatus
                                class="sapUiSmallMarginBegin"
                                text="{= 'Disponibles: ' + ${detail>/archivosRestantes} + ' de 3'}"
                                state="{= ${detail>/archivosRestantes} > 0 ? 'Information' : 'Warning'}" />
                        </HBox>
                        <Table items="{detail>/archivosAve}" noDataText="Sin archivos registrados">
                            <columns>
                                <Column minScreenWidth="Desktop" demandPopin="true">
                                    <Text text="Archivo" />
                                </Column>
                                <Column width="15%">
                                    <Text text="Vista" />
                                </Column>
                                <Column width="15%" minScreenWidth="Desktop" demandPopin="true">
                                    <Text text="Estado" />
                                </Column>
                                <Column width="10%">
                                    <Text text="Acciones" />
                                </Column>
                            </columns>
                            <items>
                                <ColumnListItem>
                                    <cells>
                                        <HBox alignItems="Center">
                                            <ObjectStatus
                                                icon="{= ${detail>tipo} === 'IMAGEN' ? 'sap-icon://picture' : 'sap-icon://video'}"
                                                state="Information" />
                                            <Text text="{detail>nombreVisual}"
                                                class="sapUiSmallMarginBegin" />
                                        </HBox>
                                        <Button
                                            text="Ver"
                                            icon="{= ${detail>tipo} === 'VIDEO' ? 'sap-icon://video' : 'sap-icon://picture'}"
                                            type="Transparent"
                                            press=".onVerArchivoAve" />
                                        <ObjectStatus
                                            text="{detail>estadoArchivoTexto}"
                                            state="{detail>estadoArchivoState}"
                                            icon="{detail>estadoArchivoIcon}" />
                                        <Button icon="sap-icon://delete" type="Transparent"
                                            tooltip="Quitar archivo" press=".onEliminarArchivoAve" />
                                    </cells>
                                </ColumnListItem>
                            </items>
                        </Table>
                    </VBox>
                </Panel>

                <Panel headerText="Composición de lí­neas" expandable="true" expanded="true"
                    class="sapUiSmallMarginTop"
                    visible="{= ${dashboard>/accesoSuscripcion} &amp;&amp; (${dashboard>/plan} === 'PRUEBA' || ${dashboard>/plan} === 'PRO' || ${dashboard>/plan} === 'PREMIUM') }">
                    <Table items="{detail>/composicionLineas}"
                        noDataText="Sin composiciónn de lí­neas registrada">
                        <headerToolbar>
                            <OverflowToolbar class="sapUiTinyMarginTop">
                                <ToolbarSpacer />
                                <Button
                                    text="Recalcular composición"
                                    icon="sap-icon://refresh"
                                    type="Transparent"
                                    press=".onRecalcularComposicionLineas" />
                            </OverflowToolbar>
                        </headerToolbar>
                        <columns>
                            <Column>
                                <Text text="Lí­nea" />
                            </Column>
                            <Column width="18%">
                                <Text text="%" />
                            </Column>
                            <Column minScreenWidth="Tablet" demandPopin="true">
                                <Text text="Composición" />
                            </Column>
                        </columns>
                        <items>
                            <ColumnListItem>
                                <cells>
                                    <ObjectIdentifier
                                        title="{= ${detail>linea/nombre} || 'Sin lÃ­nea' }"
                                        text="{detail>linea/objetivo}" />
                                    <ObjectNumber
                                        number="{detail>porcentaje}"
                                        unit="%" />
                                    <ProgressIndicator
                                        percentValue="{detail>porcentaje}"
                                        displayValue="{= ${detail>porcentaje} + '%' }"
                                        state="Information" />
                                </cells>
                            </ColumnListItem>
                        </items>
                    </Table>
                </Panel>

                <Panel headerText="Evaluacion reproductiva" expandable="true" expanded="true"
                    class="sapUiSmallMarginTop">
                    <Table items="{detail>/evaluaciones}" noDataText="Sin evaluaciones registradas">
                        <headerToolbar>
                            <OverflowToolbar>
                                <ToolbarSpacer />
                                <Button text="Nueva evaluacion" type="Emphasized"
                                    icon="sap-icon://add" press=".onAbrirEvaluacionDialog" />
                            </OverflowToolbar>
                        </headerToolbar>
                        <columns>
                            <Column width="10%">
                                <Text text="Fecha" />
                            </Column>
                            <Column width="10%">
                                <Text text="Vigor" />
                            </Column>
                            <Column width="10%" minScreenWidth="Desktop" demandPopin="true">
                                <Text text="Salud" />
                            </Column>
                            <Column width="10%" minScreenWidth="Desktop" demandPopin="true">
                                <Text text="Fertilidad" />
                            </Column>
                            <Column width="10%" minScreenWidth="Desktop" demandPopin="true">
                                <Text text="Apto" />
                            </Column>
                            <Column width="20%" minScreenWidth="Desktop" demandPopin="true">
                                <Text text="Defectos observados" />
                            </Column>
                            <Column width="20%" minScreenWidth="Desktop" demandPopin="true">
                                <Text text="Recomendacion" />
                            </Column>
                            <Column width="10%">
                                <Text text="Acciones" />
                            </Column>
                        </columns>
                        <items>
                            <ColumnListItem>
                                <cells>
                                    <Text text="{detail>fecha}" />
                                    <ObjectNumber number="{detail>vigor}" />
                                    <ObjectNumber number="{detail>saludGeneral}" />
                                    <ObjectNumber number="{detail>fertilidad}" />
                                    <ObjectStatus
                                        text="{= ${detail>aptoReproduccion} ? 'Si' : 'No'}"
                                        state="{= ${detail>aptoReproduccion} ? 'Success' : 'Error'}" />
                                    <Text text="{detail>defectosObservados}" />
                                    <Text text="{detail>recomendacion}" />
                                    <Button icon="sap-icon://edit" type="Transparent"
                                        tooltip="Editar" press=".onEditarEvaluacion" />
                                </cells>
                            </ColumnListItem>
                        </items>
                    </Table>
                </Panel>

                <Panel headerText="Evaluacion de pleito" expandable="true" expanded="true"
                    class="sapUiSmallMarginTop">
                    <Table items="{detail>/evaluacionesPleito}"
                        noDataText="Sin evaluaciones de pleito registradas">
                        <headerToolbar>
                            <OverflowToolbar>
                                <ToolbarSpacer />
                                <Button text="Nueva evaluacion" type="Emphasized"
                                    icon="sap-icon://add" press=".onAbrirEvaluacionPleitoDialog" />
                            </OverflowToolbar>
                        </headerToolbar>
                        <columns>
                            <Column width="10%">
                                <Text text="Fecha" />
                            </Column>
                            <Column width="14%">
                                <Text text="Calificacion" />
                            </Column>
                            <Column width="10%" minScreenWidth="Desktop" demandPopin="true">
                                <Text text="Bravura" />
                            </Column>
                            <Column width="10%" minScreenWidth="Desktop" demandPopin="true">
                                <Text text="Tecnica" />
                            </Column>
                            <Column width="10%" minScreenWidth="Desktop" demandPopin="true">
                                <Text text="Resistencia" />
                            </Column>
                            <Column width="12%" minScreenWidth="Desktop" demandPopin="true">
                                <Text text="Cond. fisica" />
                            </Column>
                            <Column width="24%" minScreenWidth="Desktop" demandPopin="true">
                                <Text text="Observaciones" />
                            </Column>
                            <Column width="10%">
                                <Text text="Acciones" />
                            </Column>
                        </columns>
                        <items>
                            <ColumnListItem>
                                <cells>
                                    <Text
                                        text="{path: 'detail>fecha', formatter: '.formatearFecha'}" />
                                    <ObjectStatus
                                        text="{path: 'detail>calificacion', formatter: '.formatearCategoria'}"
                                        state="{= ${detail>calificacion} === 'EXCELENTE' || ${detail>calificacion} === 'EXTRAORDINARIO' ? 'Success' : ${detail>calificacion} === 'REGULAR' ? 'Warning' : ${detail>calificacion} === 'PESIMO' ? 'Error' : 'Information'}" />
                                    <ObjectNumber number="{detail>bravura}" />
                                    <ObjectNumber number="{detail>tecnica}" />
                                    <ObjectNumber number="{detail>resistencia}" />
                                    <ObjectNumber number="{detail>condicionFisica}" />
                                    <Text text="{detail>observaciones}" />
                                    <HBox>
                                        <Button icon="sap-icon://edit" type="Transparent"
                                            tooltip="Editar" press=".onEditarEvaluacionPleito" />
                                        <Button icon="sap-icon://delete" type="Transparent"
                                            tooltip="Eliminar" press=".onEliminarEvaluacionPleito" />
                                    </HBox>
                                </cells>
                            </ColumnListItem>
                        </items>
                    </Table>
                </Panel>

                <!-- Genealogía -->
                <Panel headerText="Genealogía" expandable="true" expanded="true"
                    class="sapUiSmallMarginTop">
                    <f:Form editable="false" class="sapUiSmallMargin">
                        <f:layout>
                            <f:ResponsiveGridLayout
                                labelSpanXL="3"
                                labelSpanL="3"
                                labelSpanM="4"
                                labelSpanS="12"
                                emptySpanXL="0"
                                emptySpanL="0"
                                emptySpanM="0"
                                emptySpanS="0"
                                columnsXL="2"
                                columnsL="2"
                                columnsM="1"
                                singleContainerFullSize="false" />
                        </f:layout>
                        <f:formContainers>
                            <f:FormContainer>
                                <f:formElements>
                                    <f:FormElement>
                                        <f:label>
                                            <Label text="Padre" />
                                        </f:label>
                                        <f:fields>
                                            <Link
                                                text="{detail>/padre/placa} {detail>/padre/nombre}"
                                                press="onVerPadre" />
                                        </f:fields>
                                    </f:FormElement>
                                    <f:FormElement>
                                        <f:label>
                                            <Label text="Madre" />
                                        </f:label>
                                        <f:fields>
                                            <Link
                                                text="{detail>/madre/placa} {detail>/madre/nombre}"
                                                press="onVerMadre" />
                                        </f:fields>
                                    </f:FormElement>
                                    <f:FormElement>
                                        <f:label>
                                            <Label text="Procedencia" />
                                        </f:label>
                                        <f:fields>
                                            <Input value="{detail>/procedencia}" editable="false" />
                                        </f:fields>
                                    </f:FormElement>
                                    <f:FormElement>
                                        <f:label>
                                            <Label text="Criador" />
                                        </f:label>
                                        <f:fields>
                                            <Input value="{detail>/criador}" editable="false" />
                                        </f:fields>
                                    </f:FormElement>
                                    <f:FormElement
                                        visible="{= ${dashboard>/accesoSuscripcion} &amp;&amp; (${dashboard>/plan} === 'PRUEBA' || ${dashboard>/plan} === 'PRO' || ${dashboard>/plan} === 'PREMIUM') }">
                                        <f:label>
                                            <Label text="Arbol Genealógico"
                                                visible="{= ${dashboard>/accesoSuscripcion} &amp;&amp; (${dashboard>/plan} === 'PRUEBA' || ${dashboard>/plan} === 'PRO' || ${dashboard>/plan} === 'PREMIUM') }" />
                                        </f:label>
                                        <f:fields>
                                            <Button icon="sap-icon://org-chart" type="Emphasized"
                                                press="onVerArbGen" width="5rem"
                                                tooltip="Ver Arbol Genealógico"
                                                visible="{= ${dashboard>/accesoSuscripcion} &amp;&amp; (${dashboard>/plan} === 'PRUEBA' || ${dashboard>/plan} === 'PRO' || ${dashboard>/plan} === 'PREMIUM') }" />
                                        </f:fields>
                                    </f:FormElement>
                                </f:formElements>
                            </f:FormContainer>
                        </f:formContainers>
                    </f:Form>
                </Panel>

                <!-- Pesajes recientes -->
