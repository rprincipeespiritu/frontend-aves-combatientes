                                           ${detail>resultado} === 'DERROTA' ? 'Error' :
                                           ${detail>resultado} === 'EMPATE' ? 'Warning' : 'None'}"/>
                                <Text text="{detail>nombreOponente}"/>
                            </ColumnListItem>
                        </items>
                    </Table>
                </Panel>-->

                <!-- Observaciones -->
                <Panel headerText="Observaciones" expandable="true" expanded="true"
                    class="sapUiSmallMarginTop">
                    <VBox class="sapUiSmallMargin">
                        <TextArea value="{detail>/observaciones}" rows="4" width="100%"
                            editable="false" />
                    </VBox>
                </Panel>

            </VBox>
        </content>
        <footer>
            <Toolbar>
                <ToolbarSpacer />
                <Button text="Editar" icon="sap-icon://edit" type="Emphasized" press="onEditar"
                    visible="{= !${detail>/editMode}}" />
                <Button icon="sap-icon://delete" type="Transparent" tooltip="Eliminar"
                    press="eliminarAve" />
                <Button text="Cancelar" press="onCancelarEdicion" visible="true" />
                <!-- <Button text="Guardar" type="Emphasized" press="onGuardar"/> -->
            </Toolbar>
        </footer>
    </Page>
</mvc:View>
