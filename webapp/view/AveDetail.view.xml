                            <Column>
                                <Text text="Fecha"/>
                            </Column>
                            <Column>
                                <Text text="Lugar"/>
                            </Column>
                            <Column>
                                <Text text="Resultado"/>
                            </Column>
                            <Column>
                                <Text text="Oponente"/>
                            </Column>
                        </columns>
                        <items>
                            <ColumnListItem>
                                <Text text="{detail>fecha}"/>
