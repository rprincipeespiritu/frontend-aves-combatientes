<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <Dialog
        title="Video de la pelea"
        contentWidth="58rem"
        contentHeight="34rem"
        resizable="true"
        draggable="true">
        <content>
            <VBox class="sapUiSmallMargin">
                <ObjectStatus
                    text="{combate>/videoViewer/nombreArchivo}"
                    icon="sap-icon://video"
                    state="Information"
                    class="sapUiTinyMarginBottom" />
                <core:HTML
                    sanitizeContent="false"
                    content="{combate>/videoViewer/html}" />
            </VBox>
        </content>
        <endButton>
            <Button text="Cerrar" press=".onCerrarVideoCombateViewer" />
        </endButton>
    </Dialog>
</core:FragmentDefinition>
