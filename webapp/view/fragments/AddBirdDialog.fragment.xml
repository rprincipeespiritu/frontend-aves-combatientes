<!-- view/fragments/AddBirdDialog.fragment.xml -->
<core:FragmentDefinition xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:l="sap.ui.layout"
    xmlns:f="sap.ui.layout.form">

    <Dialog id="addBirdDialog" title="Agregar Nueva Ave" contentWidth="600px" contentHeight="auto" resizable="true" draggable="true">

        <content>
            <f:SimpleForm id="addBirdForm" editable="true" layout="ResponsiveGridLayout" labelSpanXL="4" labelSpanL="4" labelSpanM="4" labelSpanS="12" adjustLabelSpan="false" emptySpanXL="0" emptySpanL="0" emptySpanM="0" emptySpanS="0" columnsXL="2" columnsL="2" columnsM="1" singleContainerFullSize="false">

                <f:content>
                    <!-- Placa -->
                    <Label text="Placa" required="true"/>
                    <Input id="inputPlaca" value="{newBird>/placa}" placeholder="Ej: CFS-53040" required="true" valueState="{newBird>/placaState}" valueStateText="{newBird>/placaStateText}"/>

                    <!-- Nombre -->
                    <Label text="Nombre" required="true"/>
                    <Input id="inputNombre" value="{newBird>/nombre}" placeholder="Ej: Cangrejo" required="true" valueState="{newBird>/nombreState}" valueStateText="{newBird>/nombreStateText}"/>

                    <!-- Fecha Nacimiento -->
                    <Label text="Fecha Nacimiento" required="true"/>
                    <DatePicker id="inputFechaNacimiento" value="{newBird>/fechaNacimiento}" valueFormat="yyyy-MM-dd" displayFormat="dd/MM/yyyy" required="true" valueState="{newBird>/fechaState}" valueStateText="{newBird>/fechaStateText}"/>

                    <!-- Peso -->
                    <Label text="Peso (kg)" required="true"/>
                    <Input id="inputPeso" value="{newBird>/peso}" type="Number" placeholder="Ej: 4.0" required="true" valueState="{newBird>/pesoState}" valueStateText="{newBird>/pesoStateText}"/>

                    <!-- Color -->
                    <Label text="Color" required="true"/>
                    <Input id="inputColor" value="{newBird>/color}" placeholder="Ej: Ajiseco" required="true" valueState="{newBird>/colorState}" valueStateText="{newBird>/colorStateText}"/>

                    <!-- Propietario -->
                    <Label text="Propietario" required="true"/>
                    <Input id="inputPropietario" value="{newBird>/propietario}" placeholder="Nombre del propietario" required="true" valueState="{newBird>/propietarioState}" valueStateText="{newBird>/propietarioStateText}"/>

                    <!-- Categoría -->
                    <Label text="Categoría" required="true"/>
                    <Select id="selectCategoria" selectedKey="{newBird>/categoria}">
                        <items>
                            <core:Item key="Evento" text="Evento"/>
                            <core:Item key="Pelea" text="Pelea"/>
                            <core:Item key="Cría" text="Cría"/>
                            <core:Item key="Entrenamiento" text="Entrenamiento"/>
                        </items>
                    </Select>

                    <!-- Estado -->
                    <Label text="Estado" required="true"/>
                    <Select id="selectEstado" selectedKey="{newBird>/estado}" forceSelection="true">
                        <items>
                            <core:Item key="activo" text="Activo"/>
                            <core:Item key="inactivo" text="Inactivo"/>
                            <core:Item key="retirado" text="Retirado"/>
                        </items>
                    </Select>

                    <!-- Padre (Opcional) -->
                    <Label text="Padre"/>
                    <Input id="inputPadre" value="{newBird>/padre}" placeholder="ID o nombre del padre" showValueHelp="true" valueHelpRequest=".onValueHelpPadre"/>

                    <!-- Madre (Opcional) -->
                    <Label text="Madre"/>
                    <Input id="inputMadre" value="{newBird>/madre}" placeholder="ID o nombre de la madre" showValueHelp="true" valueHelpRequest=".onValueHelpMadre"/>
                </f:content>
            </f:SimpleForm>
        </content>

        <beginButton>
            <Button text="Guardar" type="Emphasized" press=".onSaveNewBird" icon="sap-icon://save"/>
        </beginButton>

        <endButton>
            <Button text="Cancelar" press=".onCancelAddBird" icon="sap-icon://decline"/>
        </endButton>
    </Dialog>
</core:FragmentDefinition>