<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <Dialog
        title="{imagenAveViewer>/title}"
        contentWidth="48rem"
        contentHeight="32rem"
        stretchOnPhone="true"
        resizable="true"
        draggable="true">
        <content>
            <VBox class="sapUiSmallMargin">
                <ObjectStatus
                    text="{imagenAveViewer>/nombreArchivo}"
                    icon="sap-icon://picture"
                    state="Information"
                    class="sapUiTinyMarginBottom" />
                <core:HTML content="{imagenAveViewer>/html}" />
            </VBox>
        </content>
        <endButton>
            <Button text="Cerrar" press="onCerrarImagenAveDialog" />
        </endButton>
    </Dialog>
</core:FragmentDefinition>
