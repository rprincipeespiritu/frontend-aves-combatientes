<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <Dialog
        title="{detail>/archivoViewer/title}"
        contentWidth="48rem"
        contentHeight="32rem"
        resizable="true"
        draggable="true">
        <content>
            <VBox class="sapUiSmallMargin">
                <ObjectStatus
                    text="{detail>/archivoViewer/nombreArchivo}"
                    icon="{= ${detail>/archivoViewer/tipo} === 'VIDEO' ? 'sap-icon://video' : 'sap-icon://picture'}"
                    state="Information"
                    class="sapUiTinyMarginBottom" />
                <core:HTML content="{detail>/archivoViewer/html}" />
            </VBox>
        </content>
        <beginButton>
            <Button
                text="Usar como imagen principal"
                icon="sap-icon://favorite"
                type="Emphasized"
                visible="{detail>/archivoViewer/puedeUsarComoPrincipal}"
                press=".onUsarArchivoComoImagenPrincipal" />
        </beginButton>
        <endButton>
            <Button text="Cerrar" press=".onCerrarVisorArchivoAve" />
        </endButton>
    </Dialog>
</core:FragmentDefinition>
