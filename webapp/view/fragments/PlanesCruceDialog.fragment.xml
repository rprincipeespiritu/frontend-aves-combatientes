<core:FragmentDefinition
        xmlns="sap.m"
        xmlns:core="sap.ui.core">

    <Dialog title="Seleccionar plan de cruce" contentWidth="42rem">
        <content>
            <VBox class="sapUiMediumMargin">
                <SearchField
                        width="100%"
                        placeholder="Buscar por codigo, placas, riesgo o decision"
                        liveChange=".onSearchPlanesCruce" />

                <List
                        id="listaPlanesCruce"
                        items="{planesCruce>/}"
                        mode="SingleSelectMaster"
                        selectionChange=".onSeleccionarPlanCruceDialog">

                    <ObjectListItem
                            title="{planesCruce>codigoVisual}"
                            number="{planesCruce>porcentaje}"
                            numberUnit="%">
                        <firstStatus>
                            <ObjectStatus
                                    text="{planesCruce>decisionTexto}"
                                    state="{planesCruce>decisionState}" />
                        </firstStatus>
                        <secondStatus>
                            <ObjectStatus
                                    text="{planesCruce>nivelRiesgoTexto}"
                                    state="{planesCruce>nivelRiesgoState}" />
                        </secondStatus>
                        <attributes>
                            <ObjectAttribute text="{planesCruce>descripcionVisual}" />
                            <ObjectAttribute text="{= 'Parentesco: ' + (${planesCruce>tipoParentesco} || 'Sin dato') }" />
                        </attributes>
                    </ObjectListItem>

                </List>
            </VBox>
        </content>

        <endButton>
            <Button text="Cerrar" press=".onCerrarPopupPlanesCruce" />
        </endButton>
    </Dialog>
</core:FragmentDefinition>
