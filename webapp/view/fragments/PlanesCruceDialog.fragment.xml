<core:FragmentDefinition
        xmlns="sap.m"
        xmlns:core="sap.ui.core">

    <Dialog
            title="Seleccionar plan de cruce"
            contentWidth="42rem"
            stretchOnPhone="true"
            class="planCruceDialog">
        <content>
            <VBox class="planCruceDialogContent">
                <SearchField
                        width="100%"
                        class="planCruceDialogSearch"
                        placeholder="Buscar por codigo, placas, riesgo o decision"
                        liveChange=".onSearchPlanesCruce" />

                <List
                        id="listaPlanesCruce"
                        items="{planesCruce>/}"
                        mode="SingleSelectMaster"
                        selectionChange=".onSeleccionarPlanCruceDialog">

                    <CustomListItem type="Active">
                        <HBox class="planCruceOption" alignItems="Start" justifyContent="SpaceBetween">
                            <VBox class="planCruceOptionMain">
                                <Text
                                        text="{planesCruce>codigoVisual}"
                                        class="planCruceCode"
                                        wrapping="true" />
                                <Text
                                        text="{planesCruce>descripcionVisual}"
                                        class="planCrucePair"
                                        wrapping="true" />
                                <Text
                                        text="{planesCruce>parentescoVisual}"
                                        class="planCruceMeta"
                                        wrapping="true" />
                            </VBox>

                            <VBox class="planCruceOptionStatus" alignItems="End">
                                <ObjectStatus
                                        text="{planesCruce>decisionTexto}"
                                        state="{planesCruce>decisionState}" />
                                <ObjectStatus
                                        text="{planesCruce>nivelRiesgoTexto}"
                                        state="{planesCruce>nivelRiesgoState}" />
                                <Text
                                        text="{planesCruce>porcentajeVisual}"
                                        class="planCrucePercent"
                                        visible="{= !!${planesCruce>porcentajeVisual} }" />
                            </VBox>
                        </HBox>
                    </CustomListItem>

                </List>
            </VBox>
        </content>

        <endButton>
            <Button text="Cerrar" press=".onCerrarPopupPlanesCruce" />
        </endButton>
    </Dialog>
</core:FragmentDefinition>
