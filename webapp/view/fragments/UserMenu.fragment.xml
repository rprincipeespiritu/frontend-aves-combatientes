<core:FragmentDefinition
        xmlns="sap.m"
        xmlns:core="sap.ui.core"
        xmlns:f="sap.f">

    <ResponsivePopover
            id="userMenuPopover"
            class="userMenuPopover"
            showHeader="false"
            placement="Bottom"
            contentWidth="20rem"
            horizontalScrolling="false"
            verticalScrolling="false">

        <VBox class="userMenuCard">
            <HBox justifyContent="Center" class="userMenuAvatarWrap">
                <f:Avatar
                        src="{user>/foto}"
                        displaySize="L"
                        displayShape="Circle"
                        class="userMenuAvatar" />
            </HBox>

            <VBox alignItems="Center" class="userMenuIdentity">
                <Title text="{user>/nombre} {user>/apellido}" level="H4" textAlign="Center" class="userMenuName" />
                <Text text="{user>/email}" textAlign="Center" class="userMenuEmail" />
            </VBox>

            <VBox class="userMenuActions">
                <Button
                        text="Configuracion de cuenta"
                        type="Transparent"
                        icon="sap-icon://action-settings"
                        press="onAccountSettings"
                        width="100%"
                        class="userMenuActionButton" />

                <Button
                        text="Cerrar sesion"
                        type="Emphasized"
                        icon="sap-icon://log"
                        press="onLogout"
                        width="100%"
                        class="userMenuLogoutButton" />
            </VBox>
        </VBox>
    </ResponsivePopover>
</core:FragmentDefinition>
