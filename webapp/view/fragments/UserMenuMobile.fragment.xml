<core:FragmentDefinition
        xmlns="sap.m"
        xmlns:core="sap.ui.core"
        xmlns:f="sap.f">

    <ResponsivePopover
            id="userMenuSheet"
            class="userMenuPopover userMenuMobilePopover"
            showHeader="false"
            placement="Bottom"
            contentWidth="20rem"
            horizontalScrolling="false"
            verticalScrolling="true"
            modal="true">

        <VBox class="userMenuCard">
            <VBox alignItems="Center" class="userMenuAvatarWrap">
                <f:Avatar
                        src="{user>/foto}"
                        displaySize="L"
                        displayShape="Circle"
                        press="onVerFotoPerfilAmpliada"
                        tooltip="Ver foto ampliada"
                        class="userMenuAvatar imageClickable" />
                <HBox alignItems="Center" justifyContent="Center" class="userMenuAvatarActions">
                    <Button
                            icon="sap-icon://upload"
                            type="Emphasized"
                            tooltip="Subir imagen desde archivo"
                            press="onSubirFotoPerfil"
                            class="userMenuAvatarActionBtn userMenuAvatarUploadBtn" />
                    <Button
                            icon="sap-icon://camera"
                            type="Emphasized"
                            tooltip="Tomar foto con la cámara"
                            press="onTomarFotoPerfil"
                            class="userMenuAvatarActionBtn userMenuAvatarCameraBtn" />
                    <Button
                            icon="sap-icon://delete"
                            type="Transparent"
                            tooltip="Eliminar foto"
                            press="onEliminarFotoPerfil"
                            visible="{= !!${user>/fotoUrl} }"
                            class="userMenuAvatarActionBtn userMenuAvatarDeleteBtn" />
                </HBox>
            </VBox>

            <VBox alignItems="Center" class="userMenuIdentity">
                <Title text="{user>/nombre} {user>/apellido}" level="H4" textAlign="Center" class="userMenuName" />
                <Text text="{user>/email}" textAlign="Center" class="userMenuEmail" />
                <ObjectStatus
                        text="{= 'Plan ' + ${planIndicator>/text} }"
                        icon="{planIndicator>/icon}"
                        state="{planIndicator>/state}"
                        visible="{planIndicator>/visible}"
                        class="userMenuPlanStatus" />
                <Text
                        text="{= ${planIndicator>/diasRestantes} !== undefined ? ${planIndicator>/diasRestantes} + ' dias restantes' : '' }"
                        visible="{= ${planIndicator>/visible} &amp;&amp; ${planIndicator>/diasRestantes} !== undefined }"
                        textAlign="Center"
                        class="userMenuPlanDays" />
                <Button
                        text="Suscripcion"
                        type="Transparent"
                        icon="sap-icon://credit-card"
                        press="onSubscriptionSettings"
                        class="userMenuSubscriptionLink" />
            </VBox>

            <VBox class="userMenuActions">
                <Button
                        text="Configuracion de cuenta"
                        type="Transparent"
                        icon="sap-icon://action-settings"
                        press="onAccountSettings"
                        width="100%"
                        class="userMenuActionButton" />

                <Button
                        text="Cerrar"
                        type="Transparent"
                        press="onCerrarUserMenu"
                        width="100%"
                        class="userMenuActionButton userMenuDismissButton" />

                <Button
                        text="Cerrar sesion"
                        type="Emphasized"
                        icon="sap-icon://log"
                        press="onLogout"
                        width="100%"
                        class="userMenuLogoutButton" />
            </VBox>
        </VBox>
    </ResponsivePopover>
</core:FragmentDefinition>
