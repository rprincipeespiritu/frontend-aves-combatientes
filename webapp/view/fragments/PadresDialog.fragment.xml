<core:FragmentDefinition
        xmlns="sap.m"
        xmlns:core="sap.ui.core">

    <Dialog title="Seleccionar padre/madre" contentWidth="20%">

        <content>
            <VBox class="sapUiMediumMargin">

                <SearchField
                        id="idSearchPadres"
                        width="100%"
                        placeholder="Buscar por nombre o placa"
                        liveChange="onSearchPadres" />

                <List
                        id="listaPadres"
                        items="{avesPadres>/}"
                        mode="SingleSelectMaster"
                        selectionChange="onSeleccionarPadre">

                    <StandardListItem
                            title="{avesPadres>nombre}"
                            description="{avesPadres>placa}" />

                </List>

            </VBox>
        </content>

        <endButton>
            <Button text="Cerrar" press="onCerrarPopupPadres" />
        </endButton>

    </Dialog>
</core:FragmentDefinition>