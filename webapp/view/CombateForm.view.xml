<mvc:View
  controllerName="com.rprincipees.registroavescombate.controller.CombateForm"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:f="sap.ui.layout.form"
  xmlns:fb="sap.f"
  xmlns:u="sap.ui.unified"
  xmlns:core="sap.ui.core">

  <Page
    title="{= ${combate>/editMode} ? 'Editar combate' : 'Nuevo combate' }"
    showNavButton="true"
    navButtonPress=".onNavBack"
    busy="{combate>/busy}">
    <headerContent>
      <Button icon="sap-icon://home" press=".onNavWelcome" type="Emphasized" />
      <fb:Avatar
        id="userAvatar"
        src="{user>/foto}"
        displaySize="XS"
        press="onUserMenuPress"
        class="sapUiTinyMarginBegin sapUiTinyMarginEnd" />
    </headerContent>

    <content>
      <VBox class="sapUiMediumMargin">
        <Panel headerText="Datos del combate">
          <f:Form editable="true" class="sapUiSmallMargin">
            <f:layout>
              <f:ResponsiveGridLayout
              labelSpanXL="3"
              labelSpanL="3"
              labelSpanM="4"
              labelSpanS="12"
              emptySpanXL="0"
              emptySpanL="0"
              emptySpanM="0"
              emptySpanS="0"
              columnsXL="2"
              columnsL="2"
              columnsM="1"
              singleContainerFullSize="false" />
            </f:layout>
            <f:formContainers>
              <f:FormContainer>
                <f:formElements>
                  <f:FormElement>
                    <f:label>
                      <Label text="Tipo de Pelea" required="true" />
                    </f:label>
                    <f:fields>
                      <Select selectedKey="{combate>/form/tipoCombate}" width="100%"
                        change=".onTipoCombateChange">
                        <core:Item key="PRUEBA" text="Entrenamiento" />
                        <core:Item key="OFICIAL" text="Oficial" />
                      </Select>
                    </f:fields>
                  </f:FormElement>
                  <f:FormElement>
                    <f:label>
                      <Label text="¿Eres propietario de ambas aves?" required="true" />
                    </f:label>
                    <f:fields>
                      <Switch
                        state="{combate>/form/ambosPropios}"
                        customTextOn="Si"
                        customTextOff="No"
                        change=".onAmbosPropiosChange">
                        <layoutData>
                          <FlexItemData growFactor="1" />
                        </layoutData>
                      </Switch>
                    </f:fields>
                  </f:FormElement>
                  <f:FormElement>
                    <f:label>
                      <Label text="¿Tienes los datos obligatorios de las aves?" required="true" />
                    </f:label>
                    <f:fields>
                      <Switch
                        state="{combate>/form/tieneDatosObligatoriosAves}"
                        customTextOn="Si"
                        customTextOff="No"
                        change=".onTieneDatosObligatoriosAvesChange">
                        <layoutData>
                          <FlexItemData growFactor="1" />
                        </layoutData>
                      </Switch>
                    </f:fields>
                  </f:FormElement>
                  <f:FormElement visible="{= !${combate>/form/tieneDatosObligatoriosAves}}">
                    <f:label>
                      <Label text="" visible="{= !${combate>/form/tieneDatosObligatoriosAves}}" />
                    </f:label>
                    <f:fields>
                      <MessageStrip
                        text="Puedes registrar el combate con placa o nombre manual. Si luego completas el ave, podras asociarla desde una edicion posterior."
                        type="Information"
                        showIcon="true"
                        visible="{= !${combate>/form/tieneDatosObligatoriosAves}}" />
                    </f:fields>
                  </f:FormElement>
                  <f:FormElement>
                    <f:label>
                      <Label text="Fecha" required="true" />
                    </f:label>
                    <f:fields>
                      <DatePicker
                        value="{combate>/form/fecha}"
                        valueFormat="yyyy-MM-dd"
                        displayFormat="dd/MM/yyyy"
                        width="100%" />
                    </f:fields>
                  </f:FormElement>
                  <f:FormElement>
                    <f:label>
                      <Label text="Evento" />
                    </f:label>
                    <f:fields>
                      <Input value="{combate>/form/evento}"
                        placeholder="Torneo, entrenamiento, visita" />
                    </f:fields>
                  </f:FormElement>
                </f:formElements>
              </f:FormContainer>
              <f:FormContainer>
                <f:formElements>
                  <f:FormElement>
                    <f:label>
                      <Label text="Lugar" />
                    </f:label>
                    <f:fields>
                      <Input value="{combate>/form/lugar}" placeholder="Galpon, ciudad o recinto" />
                    </f:fields>
                  </f:FormElement>
                  <f:FormElement>
                    <f:label>
                      <Label text="Primer combatiente" required="true" />
                    </f:label>
                    <f:fields>
                      <Input
                        value="{combate>/form/placaCombA}"
                        placeholder="{= ${combate>/form/tieneDatosObligatoriosAves} ? 'Seleccionar ave de tu galpon o criadero' : 'Ingrese placa o nombre del primer combatiente' }"
                        showValueHelp="true"
                        valueHelpOnly="{combate>/form/tieneDatosObligatoriosAves}"
                        valueHelpRequest=".onValueHelpCombatienteA"
                        liveChange=".onCombatienteAManualLiveChange"
                        description="{combate>/form/nombreCombA}" />
                    </f:fields>
                  </f:FormElement>
                  <f:FormElement visible="{combate>/form/ambosPropios}">
                    <f:label>
                      <Label text="Segundo combatiente" required="true"
                        visible="{combate>/form/ambosPropios}" />
                    </f:label>
                    <f:fields>
                      <Input
                        value="{combate>/form/placaCombB}"
                        placeholder="{= ${combate>/form/tieneDatosObligatoriosAves} ? 'Seleccionar ave de tu galpon o criadero' : 'Ingrese placa o nombre del segundo combatiente' }"
                        showValueHelp="true"
                        valueHelpOnly="{combate>/form/tieneDatosObligatoriosAves}"
                        valueHelpRequest=".onValueHelpCombatienteB"
                        liveChange=".onCombatienteBManualLiveChange"
                        visible="{combate>/form/ambosPropios}"
                        description="{combate>/form/nombreCombB}" />
                    </f:fields>
                  </f:FormElement>
                  <f:FormElement visible="{= !${combate>/form/ambosPropios}}">
                    <f:label>
                      <Label text="Combatiente rival"
                        required="{combate>/form/tieneDatosObligatoriosAves}"
                        visible="{= !${combate>/form/ambosPropios}}" />
                    </f:label>
                    <f:fields>
                      <Input value="{combate>/form/nombreOponente}"
                        placeholder="Ingrese nombre o placa del rival externo"
                        visible="{= !${combate>/form/ambosPropios}}" />
                    </f:fields>
                  </f:FormElement>
                  <f:FormElement visible="{= !${combate>/form/ambosPropios}}">
                    <f:label>
                      <Label text="Propietario rival"
                        required="{combate>/form/tieneDatosObligatoriosAves}"
                        visible="{= !${combate>/form/ambosPropios}}" />
                    </f:label>
                    <f:fields>
                      <Input value="{combate>/form/propietarioOponente}"
                        placeholder="Ingrese nombre del propietario rival externo"
                        visible="{= !${combate>/form/ambosPropios}}" />
                    </f:fields>
                  </f:FormElement>
                  <f:FormElement visible="{= !${combate>/form/ambosPropios}}">
                    <f:label>
                      <Label text="Procedencia rival" visible="{= !${combate>/form/ambosPropios}}" />
                    </f:label>
                    <f:fields>
                      <Input value="{combate>/form/procedenciaOponente}"
                        placeholder="Ingrese nombre del criadero rival externo"
                        visible="{= !${combate>/form/ambosPropios}}" />
                    </f:fields>
                  </f:FormElement>
                  <f:FormElement
                    visible="{= !${combate>/form/ambosPropios} &amp;&amp; ${combate>/form/tipoCombate} === 'OFICIAL'}">
                    <f:label>
                      <Label text="Resultado"
                        visible="{= !${combate>/form/ambosPropios} &amp;&amp; ${combate>/form/tipoCombate} === 'OFICIAL'}" />
                    </f:label>
                    <f:fields>
                      <Select selectedKey="{combate>/form/resultado}" width="100%"
                        visible="{= !${combate>/form/ambosPropios} &amp;&amp; ${combate>/form/tipoCombate} === 'OFICIAL'}">
                        <core:Item key="" text="Sin resultado" />
                        <core:Item key="VICTORIA" text="Victoria" />
                        <core:Item key="DERROTA" text="Derrota" />
                        <core:Item key="EMPATE" text="Empate" />
                        <core:Item key="DESCALIFICADO" text="Descalificado" />
                      </Select>
                      <!-- <Label text="Premio" />
                                <Input value="{combate>/form/premioDinero}" type="Number" placeholder="Monto en PEN" /> -->
                      <!-- <Label text="Metodo" />
                                <Input value="{combate>/form/metodoVictoria}" placeholder="Puntos, abandono, decision" /> -->
                    </f:fields>
                  </f:FormElement>
                  <f:FormElement>
                    <f:label>
                      <Label text="Lesiones" />
                    </f:label>
                    <f:fields>
                      <Input value="{combate>/form/lesiones}" placeholder="Sin lesiones, leve, etc." />
                    </f:fields>
                  </f:FormElement>
                  <f:FormElement>
                    <f:label>
                      <Label text="Observaciones" />
                    </f:label>
                    <f:fields>
                      <TextArea value="{combate>/form/observaciones}" rows="3"
                        placeholder="Notas del combate" />
                    </f:fields>
                  </f:FormElement>
                </f:formElements>
              </f:FormContainer>
            </f:formContainers>
          </f:Form>
        </Panel>

        <Panel headerText="Video de la pelea" class="sapUiMediumMarginTop"
          visible="{dashboard>/multimediaPremium}">
          <VBox class="sapUiMediumMargin">
            <HBox wrap="Wrap">
              <VBox class="sapUiSmallMarginEnd sapUiSmallMarginBottom" width="28rem">
                <Label text="Archivo" />
                <u:FileUploader
                  id="videoCombateUploader"
                  width="100%"
                  sameFilenameAllowed="true"
                  fileType="mp4,mov,avi,mkv,webm"
                  mimeType="video/mp4,video/quicktime,video/x-msvideo,video/x-matroska,video/webm"
                  placeholder="Selecciona un video para guardarlo luego en AWS"
                  change=".onVideoSeleccionado" />
              </VBox>
              <VBox class="sapUiSmallMarginEnd sapUiSmallMarginBottom" width="24rem">
                <Label text="Estado" />
                <ObjectStatus
                  text="{path: 'combate>/form/videoEstadoCarga', formatter: '.formatearVideo'}"
                  icon="{= ${combate>/form/videoUrl} || ${combate>/form/videoNombreArchivo} ? 'sap-icon://video' : 'sap-icon://attachment' }"
                  state="{= ${combate>/form/videoUrl} || ${combate>/form/videoNombreArchivo} ? 'Information' : 'None' }" />
                <Text text="{combate>/form/videoNombreArchivo}"
                  visible="{= !!${combate>/form/videoNombreArchivo} }" />
                <Text text="{combate>/form/videoSizeLabel}"
                  visible="{= !!${combate>/form/videoSizeLabel} }" />
                <Link
                  text="Ver video"
                  press=".onAbrirVideoCombateViewer"
                  visible="{= !!${combate>/form/videoUrl} }" />
              </VBox>
              <VBox class="sapUiSmallMarginEnd sapUiSmallMarginBottom" width="10rem"
                justifyContent="End">
                <Button
                  text="Quitar video"
                  icon="sap-icon://decline"
                  visible="{= !!${combate>/form/videoNombreArchivo} || !!${combate>/form/videoUrl} }"
                  press=".onQuitarVideo" />
              </VBox>
            </HBox>
          </VBox>
        </Panel>
      </VBox>
    </content>
    <footer>
      <Toolbar>
        <ToolbarSpacer />
        <Button text="Guardar" type="Emphasized" icon="sap-icon://save" press=".onGuardar" />
        <Button text="Cancelar" press=".onNavBack" />
      </Toolbar>
    </footer>
  </Page>
</mvc:View>