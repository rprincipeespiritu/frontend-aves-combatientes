<mvc:View
        controllerName="com.rprincipees.registroavescombate.controller.ForgotPassword"
        xmlns:mvc="sap.ui.core.mvc"
        xmlns="sap.m">

    <Page title="Recuperar contraseña" showNavButton="true" navButtonPress="onNavBack">
        <content>
            <VBox class="sapUiMediumMargin">
                <Text text="Ingresa tu correo y te enviaremos un enlace para restablecer tu contraseña." />

                <Label text="Correo" class="sapUiSmallMarginTop" />
                <Input id="inputEmail" type="Email" placeholder="usuario@correo.com" />

                <Button
                        text="Enviar enlace"
                        type="Emphasized"
                        press="onEnviarRecuperacion"
                        class="sapUiMediumMarginTop" />
            </VBox>
        </content>
    </Page>
</mvc:View>