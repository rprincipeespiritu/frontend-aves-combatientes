<mvc:View
    controllerName="com.rprincipees.registroavescombate.controller.PollitoDetail"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.ui.layout.form"
    xmlns:form="sap.f">

    <Page title="Detalle del Pollito" showNavButton="true" navButtonPress="onNavBack" busy="{detail>/busy}">
        <headerContent>
            <Button icon="sap-icon://home" press="onNavWelcome" type="Emphasized" />
            <form:Avatar
                id="userAvatar"
                src="{user>/foto}"
                displaySize="XS"
                press="onUserMenuPress"
                class="sapUiTinyMarginBegin sapUiTinyMarginEnd" />
        </headerContent>

        <content>
            <VBox class="sapUiMediumMargin">
                <HBox class="sapUiMediumMarginBottom" alignItems="Center">
                    <Avatar initials="{= ${detail>/cintillo} ? ${detail>/cintillo}.substring(0, 2) : 'CR'}" displaySize="XL" class="sapUiMediumMarginEnd" />
                    <VBox>
                        <Title text="{detail>/identificador}" level="H2" />
                        <Text text="{detail>/nombre}" />
                        <ObjectStatus
                            text="{detail>/estadoTexto}"
                            state="{= ${detail>/estado} === 'REGISTRADA_ADULTA' ? 'Success' : 'Information'}" />
                    </VBox>
                </HBox>

                <Panel headerText="Identificacion" expandable="false">
                    <f:SimpleForm layout="ResponsiveGridLayout" editable="false" columnsL="2" columnsM="1">
                        <f:content>
                            <Label text="Cintillo" />
                            <Text text="{detail>/cintillo}" />

                            <Label text="Color de cintillo" />
                            <Text text="{detail>/colorCintillo}" />                            
                            
                            <Label text="Temporada" />
                            <Text text="{detail>/temporada}" />

                            <Label text="Nombre" />
                            <Text text="{detail>/nombre}" />

                            <Label text="Genero" />
                            <Text text="{path: 'detail>/sexo', formatter: '.formatearSexo'}" />

                            <Label text="Fecha nacimiento" />
                            <Text text="{path: 'detail>/fechaNacimiento', formatter: '.formatearFecha'}" />

                            <Label text="Color del ave" />
                            <Text text="{detail>/color}" />

                            <Label text="Ubicacion" />
                            <Text text="{detail>/ubicacion}" />
                        </f:content>
                    </f:SimpleForm>
                </Panel>

                <Panel headerText="Origen genealogico" expandable="true" expanded="true" class="sapUiSmallMarginTop">
                    <f:SimpleForm layout="ResponsiveGridLayout" editable="false" columnsL="2" columnsM="1">
                        <f:content>
                            <Label text="Padre" />
                            <VBox>
                                <Text text="{detail>/padre/placa}" />
                                <Text text="{detail>/padre/nombre}" />
                            </VBox>

                            <Label text="Madre" />
                            <VBox>
                                <Text text="{detail>/madre/placa}" />
                                <Text text="{detail>/madre/nombre}" />
                            </VBox>

                            <Label text="Ave adulta generada" visible="{= ${detail>/estado} === 'REGISTRADA_ADULTA'}" />                            
                            <Link text="{detail>/aveGenerada/placa} {detail>/aveGenerada/nombre}"
                                press="onVerAve" visible="{= ${detail>/estado} === 'REGISTRADA_ADULTA'}"/>
                            
                        </f:content>
                    </f:SimpleForm>
                </Panel>

                <Panel headerText="Observaciones" expandable="true" expanded="true" class="sapUiSmallMarginTop">
                    <VBox class="sapUiSmallMargin">
                        <Text text="{detail>/observaciones}" />
                    </VBox>
                </Panel>
            </VBox>
        </content>

        <footer>
            <Toolbar>
                <ToolbarSpacer />
                <Button
                    text="Registrar como ave adulta"
                    icon="sap-icon://accept"
                    type="Emphasized"
                    press="onRegistrarComoAveAdulta"
                    visible="{= ${detail>/estado} !== 'REGISTRADA_ADULTA'}" />
                <Button text="Editar" icon="sap-icon://edit" type="Emphasized" press="onEditar"  visible="{= ${detail>/estado} !== 'REGISTRADA_ADULTA'}"/>
                <Button text="Cancelar" press="onNavBack" />
            </Toolbar>
        </footer>
    </Page>
</mvc:View>
