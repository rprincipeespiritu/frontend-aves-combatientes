<mvc:View
    controllerName="com.rprincipees.registroavescombate.controller.AccountSettings"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.ui.layout.form"
    xmlns:fb="sap.f">

    <Page
        title="Configuracion de cuenta"
        showNavButton="true"
        navButtonPress=".onNavBack">
        <headerContent>
            <Button icon="sap-icon://home" press=".onNavWelcome" type="Emphasized" />
            <fb:Avatar
                id="userAvatar"
                src="{user>/foto}"
                displaySize="XS"
                press="onUserMenuPress"
                class="sapUiTinyMarginBegin sapUiTinyMarginEnd" />
        </headerContent>

        <content>
            <VBox class="sapUiMediumMargin" busy="{account>/busy}">
                <HBox wrap="Wrap" alignItems="Center" class="sapUiMediumMarginBottom accountSettingsPhotoRow">
                    <Avatar
                        src="{user>/foto}"
                        displaySize="L"
                        displayShape="Circle"
                        class="sapUiMediumMarginEnd accountSettingsAvatar" />
                    <VBox class="accountSettingsPhotoActions">
                        <Title text="{= ${account>/perfil/nombre} + ' ' + ${account>/perfil/apellido} }" level="H2" />
                        <ObjectStatus text="{account>/perfil/email}" state="Information" class="sapUiTinyMarginBottom" />
                        <HBox wrap="Wrap">
                            <Button
                                text="Subir o cambiar foto"
                                icon="sap-icon://camera"
                                type="Emphasized"
                                press=".onSubirFotoPerfil"
                                class="sapUiTinyMarginEnd sapUiTinyMarginBottom" />
                            <Button
                                text="Eliminar foto"
                                icon="sap-icon://delete"
                                type="Transparent"
                                press=".onEliminarFotoPerfil"
                                visible="{= !!${user>/fotoUrl} }"
                                class="sapUiTinyMarginBottom" />
                        </HBox>
                    </VBox>
                </HBox>

                <Panel headerText="Datos personales">
                    <f:Form editable="true" class="sapUiSmallMargin">
                      <f:layout>
                        <f:ResponsiveGridLayout
                          labelSpanXL="3"
                          labelSpanL="3"
                          labelSpanM="4"
                          labelSpanS="12"
                          emptySpanXL="0"
                          emptySpanL="0"
                          emptySpanM="0"
                          emptySpanS="0"
                          columnsXL="2"
                          columnsL="2"
                          columnsM="1"
                          singleContainerFullSize="false" />
                      </f:layout>
                      <f:formContainers>
                        <f:FormContainer>
                          <f:formElements>
                            <f:FormElement>
                              <f:label>
                                <Label text="Usuario" />
                              </f:label>
                              <f:fields>
                                <Input value="{account>/perfil/username}" maxLength="50" />
                              </f:fields>
                            </f:FormElement>
                            <f:FormElement>
                              <f:label>
                                <Label text="Email" required="true" />
                              </f:label>
                              <f:fields>
                                <Input value="{account>/perfil/email}" type="Email" maxLength="100" />
                              </f:fields>
                            </f:FormElement>
                            <f:FormElement>
                              <f:label>
                                <Label text="Nombre" required="true" />
                              </f:label>
                              <f:fields>
                                <Input value="{account>/perfil/nombre}" maxLength="100" />
                              </f:fields>
                            </f:FormElement>
                            <f:FormElement>
                              <f:label>
                                <Label text="Apellido" required="true" />
                              </f:label>
                              <f:fields>
                                <Input value="{account>/perfil/apellido}" maxLength="200" />
                              </f:fields>
                            </f:FormElement>
                            <f:FormElement>
                              <f:label>
                                <Label text="Telefono" />
                              </f:label>
                              <f:fields>
                                <Input value="{account>/perfil/telefono}" type="Tel" maxLength="20" />
                              </f:fields>
                            </f:FormElement>
                            <f:FormElement>
                              <f:label>
                                <Label text="Direccion" />
                              </f:label>
                              <f:fields>
                                <TextArea value="{account>/perfil/direccion}" rows="3" growing="true" maxLength="300" />
                              </f:fields>
                            </f:FormElement>
                          </f:formElements>
                        </f:FormContainer>
                      </f:formContainers>
                    </f:Form>
                    <Toolbar>
                        <ToolbarSpacer />
                        <Button text="Guardar cambios" icon="sap-icon://save" type="Emphasized" press=".onGuardarPerfil" />
                    </Toolbar>
                </Panel>

                <Panel headerText="Seguridad" class="sapUiMediumMarginTop">
                    <f:Form editable="true" class="sapUiSmallMargin">
                      <f:layout>
                        <f:ResponsiveGridLayout
                          labelSpanXL="3"
                          labelSpanL="3"
                          labelSpanM="4"
                          labelSpanS="12"
                          emptySpanXL="0"
                          emptySpanL="0"
                          emptySpanM="0"
                          emptySpanS="0"
                          columnsXL="2"
                          columnsL="2"
                          columnsM="1"
                          singleContainerFullSize="false" />
                      </f:layout>
                      <f:formContainers>
                        <f:FormContainer>
                          <f:formElements>
                            <f:FormElement>
                              <f:label>
                                <Label text="Contrasena actual" required="true" />
                              </f:label>
                              <f:fields>
                                <Input value="{account>/password/actual}" type="Password" />
                              </f:fields>
                            </f:FormElement>
                            <f:FormElement>
                              <f:label>
                                <Label text="Nueva contrasena" required="true" />
                              </f:label>
                              <f:fields>
                                <Input value="{account>/password/nueva}" type="Password" />
                              </f:fields>
                            </f:FormElement>
                            <f:FormElement>
                              <f:label>
                                <Label text="Confirmar contrasena" required="true" />
                              </f:label>
                              <f:fields>
                                <Input value="{account>/password/confirmacion}" type="Password" />
                              </f:fields>
                            </f:FormElement>
                          </f:formElements>
                        </f:FormContainer>
                      </f:formContainers>
                    </f:Form>
                    <Toolbar>
                        <ToolbarSpacer />
                        <Button text="Actualizar contrasena" icon="sap-icon://key" type="Emphasized" press=".onCambiarPassword" />
                    </Toolbar>
                </Panel>
            </VBox>
        </content>
    </Page>
</mvc:View>
