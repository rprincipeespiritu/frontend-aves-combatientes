<mvc:View controllerName="com.rprincipees.registroavescombate.controller.Register" displayBlock="true"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.ui.layout.form">

    <Page title="Crear Cuenta" showNavButton="true" navButtonPress="onNavBack">
        <content>
            <ScrollContainer height="100%" vertical="true">
                <VBox class="sapUiMediumMargin">
                    <Panel width="100%">
                        <headerToolbar>
                            <Toolbar>
                                <Title text="Registro de Usuario" level="H2"/>
                            </Toolbar>
                        </headerToolbar>

                        <content>
                            <VBox class="sapUiMediumMargin">
                                <MessageStrip id="registerErrorMessage" text="" type="Error" visible="false" class="sapUiMediumMarginBottom"/>

                                <f:Form editable="true" class="sapUiSmallMargin">
                                  <f:layout>
                                    <f:ResponsiveGridLayout
                                      labelSpanXL="3"
                                      labelSpanL="3"
                                      labelSpanM="4"
                                      labelSpanS="12"
                                      emptySpanXL="0"
                                      emptySpanL="0"
                                      emptySpanM="0"
                                      emptySpanS="0"
                                      columnsXL="2"
                                      columnsL="2"
                                      columnsM="1"
                                      singleContainerFullSize="false" />
                                  </f:layout>
                                  <f:formContainers>
                                    <f:FormContainer>
                                      <f:formElements>
                                        <f:FormElement>
                                          <f:fields>
                                            <Title text="Información Básica"/>
                                          </f:fields>
                                        </f:FormElement>
                                        <f:FormElement>
                                          <f:label>
                                            <Label text="Nombre de Usuario" required="true"/>
                                          </f:label>
                                          <f:fields>
                                            <Input id="usernameInput" placeholder="Usuario único" value="{/username}" valueState="{/usernameState}" valueStateText="{/usernameStateText}" change="onUsernameChange"/>
                                          </f:fields>
                                        </f:FormElement>
                                        <f:FormElement>
                                          <f:label>
                                            <Label text="Email" required="true"/>
                                          </f:label>
                                          <f:fields>
                                            <Input id="emailInput" type="Email" placeholder="usuario@ejemplo.com" value="{/email}" valueState="{/emailState}" valueStateText="{/emailStateText}" change="onEmailChange"/>
                                          </f:fields>
                                        </f:FormElement>
                                        <f:FormElement>
                                          <f:label>
                                            <Label text="Contraseña" required="true"/>
                                          </f:label>
                                          <f:fields>
                                            <Input id="passwordInput" type="Password" placeholder="Mínimo 8 caracteres" value="{/password}" valueState="{/passwordState}" valueStateText="{/passwordStateText}" change="onPasswordChange"/>
                                          </f:fields>
                                        </f:FormElement>
                                        <f:FormElement>
                                          <f:label>
                                            <Label text="Confirmar Contraseña" required="true"/>
                                          </f:label>
                                          <f:fields>
                                            <Input id="confirmPasswordInput" type="Password" placeholder="Repite la contraseña" value="{/confirmPassword}" valueState="{/confirmPasswordState}" valueStateText="{/confirmPasswordStateText}" change="onConfirmPasswordChange"/>
                                          </f:fields>
                                        </f:FormElement>
                                      </f:formElements>
                                    </f:FormContainer>
                                  </f:formContainers>
                                </f:Form>

                                <f:Form editable="true" class="sapUiSmallMargin">
                                  <f:layout>
                                    <f:ResponsiveGridLayout
                                      labelSpanXL="3"
                                      labelSpanL="3"
                                      labelSpanM="4"
                                      labelSpanS="12"
                                      emptySpanXL="0"
                                      emptySpanL="0"
                                      emptySpanM="0"
                                      emptySpanS="0"
                                      columnsXL="2"
                                      columnsL="2"
                                      columnsM="1"
                                      singleContainerFullSize="false" />
                                  </f:layout>
                                  <f:formContainers>
                                    <f:FormContainer>
                                      <f:formElements>
                                        <f:FormElement>
                                          <f:fields>
                                            <Title text="Información Personal"/>
                                          </f:fields>
                                        </f:FormElement>
                                        <f:FormElement>
                                          <f:label>
                                            <Label text="Nombre" required="true"/>
                                          </f:label>
                                          <f:fields>
                                            <Input id="nombreInput" placeholder="Tu nombre" value="{/nombre}" valueState="{/nombreState}" valueStateText="{/nombreStateText}" change="onConfirmNombrehange"/>
                                          </f:fields>
                                        </f:FormElement>
                                        <f:FormElement>
                                          <f:label>
                                            <Label text="Apellido" required="true"/>
                                          </f:label>
                                          <f:fields>
                                            <Input id="apellidoInput" placeholder="Tu apellido" value="{/apellido}" valueState="{/apellidoState}" valueStateText="{/apellidoStateText}" change="onConfirmApellidoChange"/>
                                          </f:fields>
                                        </f:FormElement>
                                        <f:FormElement>
                                          <f:label>
                                            <Label text="Teléfono"/>
                                          </f:label>
                                          <f:fields>
                                            <Input id="telefonoInput" type="Tel" placeholder="+51 999 999 999" value="{/telefono}"/>
                                          </f:fields>
                                        </f:FormElement>
                                        <f:FormElement>
                                          <f:label>
                                            <Label text="Dirección"/>
                                          </f:label>
                                          <f:fields>
                                            <TextArea id="direccionInput" placeholder="Tu dirección completa" value="{/direccion}" rows="3"/>
                                          </f:fields>
                                        </f:FormElement>
                                      </f:formElements>
                                    </f:FormContainer>
                                  </f:formContainers>
                                </f:Form>

                                <CheckBox id="termsCheckBox" text="Acepto los términos y condiciones" selected="{/acceptTerms}" class="sapUiMediumMarginTop" select="onConfirmTermsCheckBoxChange"/>

                                <VBox class="sapUiSmallMarginTop">
                                    <Text text="Fortaleza de la contraseña:"/>
                                    <ProgressIndicator id="passwordStrengthIndicator" percentValue="{/passwordStrength}" state="{/passwordStrengthState}" showValue="false" width="100%"/>
                                    <Text text="{/passwordStrengthText}" class="sapUiTinyMarginTop"/>
                                </VBox>

                                <HBox class="sapUiLargeMarginTop" justifyContent="SpaceBetween">
                                    <Button text="Volver al Login" press="onGoToLogin"/>
                                    <Button id="registerButton" text="Crear Cuenta" type="Emphasized" press="onRegister" enabled="{/registerEnabled}"/>
                                </HBox>

                                <BusyIndicator id="registerBusyIndicator" visible="false" class="sapUiMediumMarginTop"/>
                            </VBox>
                        </content>
                    </Panel>
                </VBox>
            </ScrollContainer>
        </content>
    </Page>
</mvc:View>
