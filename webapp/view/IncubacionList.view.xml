<mvc:View controllerName="com.rprincipees.registroavescombate.controller.IncubacionList"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m">

    <Page title="Incubaciones" showNavButton="true" navButtonPress="onNavBack">
        <!-- <headerContent>
            <Button text="Actualizar" icon="sap-icon://refresh" press="onRefresh" />
            <Button text="Nueva Incubación" type="Emphasized" icon="sap-icon://add" press="onCreate" />
        </headerContent> -->

        <content>
            <Table id="tblIncubaciones" items="{view>/incubaciones}" busy="{view>/busy}">
                <headerToolbar>
                    <OverflowToolbar>
                        <Title text="Incubaciones Registradas ({= ${aves>/incubaciones}.length})"/>
                        <ToolbarSpacer/>
                        <Button icon="sap-icon://refresh" enabled="{= ${table>/selectedIndex} >= 0}" press="onRefresh"/>
                        <Button con="sap-icon://add" type="Emphasized" press="onCreate" />
                    </OverflowToolbar>
                </headerToolbar>
                <columns>
                    <Column>
                        <Text text="Código" />
                    </Column>
                    <Column>
                        <Text text="Fecha Inicio" />
                    </Column>
                    <Column>
                        <Text text="Padre" />
                    </Column>
                    <Column>
                        <Text text="Madre" />
                    </Column>
                    <Column minScreenWidth="Tablet" demandPopin="true">
                        <Text text="Huevos" />
                    </Column>
                    <Column minScreenWidth="Tablet" demandPopin="true">
                        <Text text="Estado" />
                    </Column>
                    <Column>
                        <Text text="Acciones" />
                    </Column>
                </columns>

                <items>
                    <ColumnListItem>
                        <cells>
                            <Text text="{view>codigo}" />
                            <Text text="{view>fechaInicio}" />
                            <Text text="{view>padre/nombre}" />
                            <Text text="{view>madre/nombre}" />
                            <ObjectNumber number="{view>cantidadHuevos}" />
                            <ObjectStatus text="{view>estado}" />
                            <HBox>
                                <Button icon="sap-icon://edit" type="Transparent" press="onEdit" />
                                <Button icon="sap-icon://delete" type="Transparent" press="onDelete" />
                            </HBox>
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </content>
    </Page>
</mvc:View>