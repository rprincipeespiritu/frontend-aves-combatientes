<mvc:View controllerName="com.rprincipees.registroavescombate.controller.IncubacionList"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.f"
    xmlns:form="sap.ui.layout.form">

    <Page title="Incubaciones" showNavButton="true" navButtonPress="onNavBack">
        <headerContent>
            <Button icon="sap-icon://home" press="onNavWelcome" type="Emphasized"/>
            <f:Avatar
                    id="userAvatar"
                    src="{user>/foto}"
                    displaySize="XS"
                    press="onUserMenuPress"
                    class="sapUiTinyMarginBegin sapUiTinyMarginEnd" />
        </headerContent>

        <content>
            <Panel headerText="Filtros" expandable="true" expanded="false" width="100%">
                <content>
                    <form:Form editable="true" class="sapUiSmallMargin">
                        <form:layout>
                            <form:ResponsiveGridLayout
                                labelSpanXL="3" labelSpanL="3" labelSpanM="4" labelSpanS="12"
                                emptySpanXL="0" emptySpanL="0" emptySpanM="0" emptySpanS="0"
                                columnsXL="3" columnsL="2" columnsM="2"
                                singleContainerFullSize="false" />
                        </form:layout>
                        <form:formContainers>
                            <form:FormContainer>
                                <form:formElements>
                                    <form:FormElement label="Buscar">
                                        <form:fields>
                                            <SearchField id="searchField" placeholder="Buscar por código o estado" width="100%" search="onBuscar" liveChange="onBuscar" />
                                        </form:fields>
                                    </form:FormElement>
                                    <form:FormElement label="Estado">
                                        <form:fields>
                                            <ComboBox id="estadoFilter" placeholder="Filtrar por estado" width="100%" selectionChange="onFiltrarEstado">
                                                <core:Item key="PROGRAMADA" text="Programada" />
                                                <core:Item key="EN_PROCESO" text="En proceso" />
                                                <core:Item key="COMPLETADA" text="Completada" />
                                                <core:Item key="CANCELADA" text="Cancelada" />
                                            </ComboBox>
                                        </form:fields>
                                    </form:FormElement>
                                </form:formElements>
                            </form:FormContainer>
                            <form:FormContainer>
                                <form:formElements>
                                    <form:FormElement label="Desde">
                                        <form:fields>
                                            <DatePicker id="fechaDesdeFilter" placeholder="Fecha incubación desde" displayFormat="dd/MM/yyyy" valueFormat="yyyy-MM-dd" change="onFiltrarFecha" width="100%" />
                                        </form:fields>
                                    </form:FormElement>
                                    <form:FormElement label="Hasta">
                                        <form:fields>
                                            <DatePicker id="fechaHastaFilter" placeholder="Fecha incubación hasta" displayFormat="dd/MM/yyyy" valueFormat="yyyy-MM-dd" change="onFiltrarFecha" width="100%" />
                                        </form:fields>
                                    </form:FormElement>
                                    <form:FormElement>
                                        <form:fields>
                                            <Button text="Limpiar Filtros" icon="sap-icon://clear-filter" press="onLimpiarFiltros" />
                                        </form:fields>
                                    </form:FormElement>
                                </form:formElements>
                            </form:FormContainer>
                            <!-- <form:FormContainer>
                                <form:formElements>
                                    <form:FormElement>
                                        <form:fields>
                                            <Button text="Limpiar Filtros" icon="sap-icon://clear-filter" press="onLimpiarFiltros" />
                                        </form:fields>
                                    </form:FormElement>
                                </form:formElements>
                            </form:FormContainer> -->
                        </form:formContainers>
                    </form:Form>
                </content>
            </Panel>
            <Table id="tblIncubaciones" items="{view>/incubaciones}" busy="{view>/busy}">
                <headerToolbar>
                    <OverflowToolbar>
                        <Title text="Incubaciones Registradas ({view>/filteredCount})"/>
                        <ToolbarSpacer/>
                        <Button icon="sap-icon://add" type="Emphasized" press="onCreate" />
                        <Button icon="sap-icon://refresh" press="onRefresh"/>
                    </OverflowToolbar>
                </headerToolbar>
                <columns>
                    <Column minScreenWidth="Tablet" demandPopin="true">
                        <Text text="Código" />
                    </Column>
                    <Column >
                        <Text text="Fecha Incubación" />
                    </Column>
                    <Column minScreenWidth="Tablet" demandPopin="true">
                        <Text text="Fecha Pre-Nacimiento" />
                    </Column>
                    <Column minScreenWidth="Tablet" demandPopin="true">
                        <Text text="Fecha Eclosión" />
                    </Column>
                    <!-- <Column>
                        <Text text="Padre" />
                    </Column> -->
                    <!-- <Column>
                        <Text text="Madre" />
                    </Column> -->
                    <!-- <Column minScreenWidth="Tablet" demandPopin="true">
                        <Text text="Total huevos" />
                    </Column> -->
                    <Column minScreenWidth="Tablet" demandPopin="true">
                        <Text text="Estado" />
                    </Column>
                    <Column >
                        <Text text="Acciones" />
                    </Column>
                </columns>

                <items>
                    <ColumnListItem type="Active" press="onDetail">
                        <cells>
                            <Text text="{view>codigo}" />
                            <!-- <Text text="{view>fechaIncubacion}" /> -->
                            <ObjectStatus text="{ path: 'view>fechaIncubacion', formatter: '.formatter.formatDateTime' }" state="Information" />
                            <!-- <Text text="{ path: 'view>fechaIncubacion', formatter: '.formatter.formatDateTime' }" /> -->
                            <Text text="{ path: 'view>fechaPreNacimiento', formatter: '.formatter.formatDateTime' }" />
                            <Text text="{ path: 'view>fechaEclosion', formatter: '.formatter.formatDateTime' }" />
                            <!-- <Text text="{view>padre/placa} {view>padre/nombre}" />
                            <Text text="{view>madre/placa} {view>madre/nombre}" /> -->
                            <!-- <ObjectNumber number="{view>totalHuevos}" /> -->
                            <!-- <ObjectStatus text="{view>estado}" /> -->
                            <ObjectStatus text="{
                                        path: 'view>estado',
                                        formatter: '.formatearEstado'
                                    }" state="{= ${view>estado} === 'EN_PROCESO' ? 'Warning' :
                                             ${view>estado} === 'PROGRAMADA' ? 'Information' :
                                             ${view>estado} === 'COMPLETADA' ? 'Success' :
                                             ${view>estado} === 'CANCELADA' ? 'Error' : 'Error'}"/>
                            <HBox>
                                <Button icon="sap-icon://edit" type="Emphasized" press="onEdit" visible="{= ${view>estado} !== 'COMPLETADA' &amp;&amp; ${view>estado} !== 'CANCELADA' }" />
                                <Button icon="sap-icon://delete" type="Transparent" press="onDelete" />
                                <Button icon="sap-icon://detail-view" type="Emphasized" press="onDetail"/>
                            </HBox>
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </content>
        <footer>
            <Toolbar>
                <ToolbarSpacer/>
                <Button text="Cancelar" press="onNavBack" visible="true"/>
            </Toolbar>
        </footer>
    </Page>
</mvc:View>
