<mvc:View controllerName="com.rprincipees.registroavescombate.controller.IncubacionDetail"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.ui.layout.form"
    xmlns:form="sap.f">

    <Page title="Detalle de Incubación" showNavButton="true" navButtonPress="onNavBack">

        <headerContent>
            <Button icon="sap-icon://home" press="onNavWelcome" type="Emphasized" />
            <form:Avatar
                id="userAvatar"
                src="{user>/foto}"
                displaySize="XS"
                press="onUserMenuPress"
                class="sapUiTinyMarginBegin sapUiTinyMarginEnd" />
        </headerContent>

        <content>
            <VBox class="sapUiMediumMargin" busy="{view>/busy}">
                <!-- <OverflowToolbar class="sapUiTinyMarginTop">
                    <ToolbarSpacer />
                    <Button icon="sap-icon://edit" type="Emphasized" tooltip="Editar" press="onEdit"
                        visible="{= ${view>/incubacion/estado} !== 'COMPLETADA' &amp;&amp; ${view>/incubacion/estado} !== 'CANCELADA' }" />
                </OverflowToolbar>                 -->
                <HBox justifyContent="SpaceBetween" alignItems="Center"
                    class="sapUiMediumMarginBottom">
                    <Title text="{view>/incubacion/codigo}" level="H1" />
                    <ObjectStatus
                        text="{
                            path: 'view>/incubacion/estado',
                            formatter: '.formatearEstado'
                        }"
                        state="{= ${view>/incubacion/estado} === 'EN_PROCESO' ? 'Warning' :
                            ${view>/incubacion/estado} === 'PROGRAMADA' ? 'Information' :
                            ${view>/incubacion/estado} === 'COMPLETADA' ? 'Success' :
                            ${view>/incubacion/estado} === 'CANCELADA' ? 'Error' : 'Error'}" />
                </HBox>

                <f:Form editable="false" class="sapUiMediumMarginTop incubacionDetailForm">
                  <f:layout>
                    <f:ResponsiveGridLayout
                      labelSpanXL="3"
                      labelSpanL="3"
                      labelSpanM="4"
                      labelSpanS="12"
                      emptySpanXL="0"
                      emptySpanL="0"
                      emptySpanM="0"
                      emptySpanS="0"
                      columnsXL="2"
                      columnsL="2"
                      columnsM="1"
                      singleContainerFullSize="false" />
                  </f:layout>
                  <f:formContainers>
                    <f:FormContainer>
                      <f:formElements>
                        <f:FormElement>
                          <f:fields>
                            <Title text="Datos Generales" />
                          </f:fields>
                        </f:FormElement>
                        <f:FormElement>
                          <f:label>
                            <Label text="Código" />
                          </f:label>
                          <f:fields>
                            <Text text="{view>/incubacion/codigo}" />
                            <!-- <Label text="Estado" /> -->
                            <!-- <ObjectStatus text="{view>/incubacion/estado}" /> -->
                            <!-- <ObjectStatus text="{
                                            path: 'view>/incubacion/estado',
                                            formatter: '.formatearEstado'
                                        }" state="{= ${view>/incubacion/estado} === 'EN_PROCESO' ? 'Success' :
                                                 ${view>/incubacion/estado} === 'PROGRAMADA' ? 'Information' :
                                                 ${view>/incubacion/estado} === 'COMPLETADA' ? 'Information' :
                                                 ${view>/incubacion/estado} === 'CANCELADA' ? 'Warning' : 'Error'}"/> -->
                          </f:fields>
                        </f:FormElement>
                        <f:FormElement>
                          <f:label>
                            <Label text="Fecha Incubación" />
                          </f:label>
                          <f:fields>
                            <Text
                                text="{ path: 'view>/incubacion/fechaIncubacion', formatter: '.formatter.formatDateTime' }" />
                          </f:fields>
                        </f:FormElement>
                        <f:FormElement>
                          <f:label>
                            <Label text="Fecha Pre Nacimiento" />
                          </f:label>
                          <f:fields>
                            <Text
                                text="{ path: 'view>/incubacion/fechaPreNacimiento', formatter: '.formatter.formatDateTime' }" />
                          </f:fields>
                        </f:FormElement>
                        <f:FormElement>
                          <f:label>
                            <Label text="Fecha Eclosión Estimada" />
                          </f:label>
                          <f:fields>
                            <Text
                                text="{ path: 'view>/incubacion/fechaEclosion', formatter: '.formatter.formatDateTime' }" />
                          </f:fields>
                        </f:FormElement>
                        <f:FormElement visible="{= ${view>/incubacion/estado} === 'COMPLETADA' }">
                          <f:label>
                            <Label text="Fecha Fin Incubación"
                                visible="{= ${view>/incubacion/estado} === 'COMPLETADA' }" />
                          </f:label>
                          <f:fields>
                            <Text
                                text="{ path: 'view>/incubacion/fechaFinIncubacion', formatter: '.formatter.formatDateTime' }"
                                visible="{= ${view>/incubacion/estado} === 'COMPLETADA' }" />
                          </f:fields>
                        </f:FormElement>
                        <f:FormElement>
                          <f:label>
                            <Label text="Observaciones" />
                          </f:label>
                          <f:fields>
                            <TextArea value="{view>/incubacion/observaciones}" rows="4" editable="false" />
                            <!--<Text
                            text="{view>/incubacion/observaciones}" />-->
                          </f:fields>
                        </f:FormElement>
                        <f:FormElement visible="{= ${view>/incubacion/estado} === 'CANCELADA' }">
                          <f:label>
                            <Label text="Motivo de cancelación"
                                visible="{= ${view>/incubacion/estado} === 'CANCELADA' }" />
                          </f:label>
                          <f:fields>
                            <Text text="{view>/incubacion/motivoCancelacion}"
                                visible="{= ${view>/incubacion/estado} === 'CANCELADA' }" />
                          </f:fields>
                        </f:FormElement>
                      </f:formElements>
                    </f:FormContainer>
                  </f:formContainers>
                </f:Form>

                <Panel
                    headerText="Detalle de Incubación"
                    class="sapUiMediumMarginTop incubacionDetailTablePanel">
                    <Table
                        id="tblIncubacionesDetalle"
                        class="incubacionDetailTable"
                        items="{view>/incubacion/detalles}"
                        busy="{view>/busy}">
                        <columns>
                            <Column width="26%">
                                <Text text="Padre" />
                            </Column>
                            <Column width="26%">
                                <Text text="Madre" />
                            </Column>
                            <Column hAlign="Center" width="12rem">
                                <Text text="Total Huevos" />
                            </Column>
                            <Column hAlign="Center" width="10rem">
                                <Text text="Fértiles" />
                            </Column>
                            <Column hAlign="Center" width="10rem">
                                <Text text="Nacidos" />
                            </Column>
                            <Column hAlign="Center" width="13rem">
                                <Text text="No Eclosionados" />
                            </Column>
                        </columns>
                        <items>
                            <ColumnListItem vAlign="Middle">
                                <cells>
                                    <ObjectIdentifier title="{view>placaPadre}" text="{view>nombrePadre}" />
                                    <ObjectIdentifier title="{view>placaMadre}" text="{view>nombreMadre}" />
                                    <ObjectNumber number="{view>totalHuevos}" textAlign="Center" />
                                    <ObjectNumber number="{view>huevosFertiles}" textAlign="Center" />
                                    <ObjectNumber number="{view>huevosEclosionados}" textAlign="Center" />
                                    <ObjectNumber number="{view>huevosNoEclosionados}" textAlign="Center" />
                                </cells>
                            </ColumnListItem>
                        </items>
                    </Table>
                </Panel>
            </VBox>
        </content>
        <footer>
            <Toolbar class="incubacionDetailFooter">
                <ToolbarSpacer />
                <Button text="Iniciar Incubación" type="Emphasized"
                    visible="{= ${view>/incubacion/estado} === 'PROGRAMADA' }"
                    press=".onConfirmarIniciar" />
                <Button text="Finalizar Incubación" type="Accept"
                    visible="{= ${view>/incubacion/estado} === 'EN_PROCESO' }"
                    press=".onConfirmarFinalizar" />
                <Button text="Cancelar Incubación" type="Reject"
                    visible="{= ${view>/incubacion/estado} !== 'COMPLETADA' &amp;&amp; ${view>/incubacion/estado} !== 'CANCELADA' }"
                    press=".onConfirmarCancelar" />
                    <Button icon="sap-icon://edit" type="Emphasized" tooltip="Editar" press="onEdit"
                    visible="{= ${view>/incubacion/estado} !== 'COMPLETADA' &amp;&amp; ${view>/incubacion/estado} !== 'CANCELADA' }" />
                <Button text="Cancelar" press="onNavBack" />
            </Toolbar>
        </footer>
    </Page>
</mvc:View>
