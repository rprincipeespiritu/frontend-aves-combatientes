        <!-- Genealogía -->
        <Panel headerText="Genealogía" expandable="true" expanded="true"
          class="sapUiSmallMarginTop">
          <f:Form editable="true" class="sapUiSmallMargin">
            <f:layout>
              <f:ResponsiveGridLayout
                labelSpanXL="3"
                labelSpanL="3"
                labelSpanM="4"
                labelSpanS="12"
                emptySpanXL="0"
                emptySpanL="0"
                emptySpanM="0"
                emptySpanS="0"
                columnsXL="2"
                columnsL="2"
                columnsM="1"
                singleContainerFullSize="false" />
            </f:layout>
            <f:formContainers>
              <f:FormContainer>
                <f:formElements>
                  <f:FormElement>
                    <f:label>
                      <Label text="Padre" />
                    </f:label>
                    <f:fields>
                      <Input
                        id="inputPadre"
                        placeholder="Seleccionar Padre"
                        value="{create>/placaPadre}"
                        description="{create>/nombrePadre}"
                        showValueHelp="true"
                        valueHelpOnly="true"
                        valueHelpRequest="onValueHelpPadre"
                        width="100%" />
                      <!--<Input
                                id="idPadre" valueState="{create>/placaPadreState}"
                                textFormatMode="KeyValue" placeholder="Ingrese Padre"
                                showSuggestion="true" suggestionItems="{avesMachos>/}"
                                change=".onSuggestionItemSelectedPlacaPadre">
                                    <suggestionItems>
                                        <core:ListItem key="{avesMachos>placa}" text="{avesMachos>nombre}"
                                additionalText="{avesMachos>placa}" />
                                    </suggestionItems>
                                </Input>-->
                    </f:fields>
                  </f:FormElement>
                  <f:FormElement>
                    <f:label>
                      <Label text="Madre" />
                    </f:label>
                    <f:fields>
                      <Input
                        id="inputMadre"
                        placeholder="Seleccionar Madre"
                        value="{create>/placaMadre}"
                        description="{create>/nombreMadre}"
                        showValueHelp="true"
                        valueHelpOnly="true"
                        valueHelpRequest="onValueHelpMadre"
                        width="100%" />
                      <!--<Input
                                id="idMadre" valueState="{create>/placaMadreState}"
                                textFormatMode="KeyValue" placeholder="Ingrese Madre"
                                showSuggestion="true" suggestionItems="{avesHembras>/}"
                                change=".onSuggestionItemSelectedPlacaMadre">
                                    <suggestionItems>
                                        <core:ListItem key="{avesHembras>placa}" text="{avesHembras>nombre}"
                                additionalText="{avesHembras>placa}" />
                                    </suggestionItems>
                                </Input>-->
                    </f:fields>
                  </f:FormElement>
                </f:formElements> 
              </f:FormContainer>
              <f:FormContainer>
                <f:formElements>
                  <f:FormElement>
                    <f:label>
                      <Label text="Lugar de Procedencia" />
                    </f:label>
                    <f:fields>
                      <Input value="{create>/procedencia}" placeholder="Lugar de procedencia" />
                    </f:fields>
                  </f:FormElement>
                  <f:FormElement>
                    <f:label>
                      <Label text="Criador de Procedencia" />
                    </f:label>
                    <f:fields>
                      <Input value="{create>/criador}" placeholder="Nombre del criador" />
                    </f:fields>
                  </f:FormElement>
                </f:formElements>
              </f:FormContainer>
            </f:formContainers>
          </f:Form>
        </Panel>

        <!-- Información financiera -->
        <Panel headerText="Información Financiera" expandable="true" expanded="true"
          class="sapUiSmallMarginTop">
          <f:Form editable="true" class="sapUiSmallMargin">
            <f:layout>
              <f:ResponsiveGridLayout
                labelSpanXL="3"
                labelSpanL="3"
                labelSpanM="4"
                labelSpanS="12"
                emptySpanXL="0"
                emptySpanL="0"
                emptySpanM="0"
                emptySpanS="0"
                columnsXL="2"
                columnsL="2"
                columnsM="1"
                singleContainerFullSize="false" />
            </f:layout>
            <f:formContainers>
              <f:FormContainer>
                <f:formElements>
                  <f:FormElement>
                    <f:label>
                      <Label text="Valor Compra (S/.)" />
                    </f:label>
                    <f:fields>
                      <Input value="{create>/valorCompra}" type="Number" placeholder="0.00" />
                    </f:fields>
                  </f:FormElement>
                  <f:FormElement>
                    <f:label>
                      <Label text="Valor Actual (S/.)" />
                    </f:label>
                    <f:fields>
                      <Input value="{create>/valorActual}" type="Number" placeholder="0.00" />
                    </f:fields>
                  </f:FormElement>
                </f:formElements>
              </f:FormContainer>
            </f:formContainers>
          </f:Form>
        </Panel>

        <!-- Observaciones -->
        <Panel headerText="Observaciones" expandable="true" expanded="true"
          class="sapUiSmallMarginTop">
          <VBox class="sapUiSmallMargin">
            <TextArea value="{create>/observaciones}" rows="4" width="100%"
              placeholder="Observaciones adicionales..." />
          </VBox>
        </Panel>

      </VBox>
    </content>
    <footer>
      <Toolbar>
        <ToolbarSpacer />
        <Button text="Guardar" type="Emphasized" press="onGuardar" />
        <Button text="Cancelar" press="onNavBack" />
      </Toolbar>
    </footer>
  </Page>
</mvc:View>