<mvc:View controllerName="com.rprincipees.registroavescombate.controller.AveCreate"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:f="sap.ui.layout.form"
  xmlns:core="sap.ui.core"
  xmlns:u="sap.ui.unified"
  xmlns:upload="sap.m.upload"
  xmlns:form="sap.f">

  <Page title="Registrar Nueva Ave" showNavButton="true" navButtonPress="onNavBack">
    <headerContent>
      <Button icon="sap-icon://home" press="onNavWelcome" type="Emphasized" />
      <form:Avatar
        id="userAvatar"
        src="{user>/foto}"
        displaySize="XS"
        press="onUserMenuPress"
        class="sapUiTinyMarginBegin sapUiTinyMarginEnd" />
    </headerContent>
    <content>
      <VBox class="sapUiMediumMargin">

        <!-- Identificación -->
        <Panel headerText="Identificación" expandable="false">
          <f:Form editable="true" class="sapUiSmallMargin">
            <f:layout>
              <f:ResponsiveGridLayout
                labelSpanXL="3"
                labelSpanL="3"
                labelSpanM="4"
                labelSpanS="12"
                emptySpanXL="0"
                emptySpanL="0"
                emptySpanM="0"
                emptySpanS="0"
                columnsXL="2"
                columnsL="2"
                columnsM="1"
                singleContainerFullSize="false" />
            </f:layout>
            <f:formContainers>
              <f:FormContainer>
                <f:formElements>
                  <f:FormElement>
                    <f:label>
                      <Label text="Placa" required="true" />
                    </f:label>
                    <f:fields>
                      <Input id="placa" value="{create>/placa}" placeholder="Ej: GAL-001"
                        valueState="{create>/placaState}"
                        valueStateText="La placa es requerida" />
                    </f:fields>
                  </f:FormElement>
                  <f:FormElement>
                    <f:label>
                      <Label text="Nombre" />
                    </f:label>
                    <f:fields>
                      <Input value="{create>/nombre}" placeholder="Nombre del ave" />
                    </f:fields>
                  </f:FormElement>
                  <f:FormElement>
                    <f:label>
                      <Label text="Apodo" />
                    </f:label>
                    <f:fields>
                      <Input value="{create>/apodo}" placeholder="Apodo" />
                    </f:fields>
                  </f:FormElement>
                  <f:FormElement>
                    <f:label>
                      <Label text="Cría" />
                    </f:label>
                    <f:fields>
                      <CheckBox selected="{create>/cria}" class="formCheckBoxField" />
                    </f:fields>
                  </f:FormElement>
                  <f:FormElement>
                    <f:label>
                      <Label text="Género" required="true" />
                    </f:label>
                    <f:fields>
                      <Select selectedKey="{create>/sexo}">
                        <core:Item key="M" text="Macho" />
                        <core:Item key="H" text="Hembra" />
                      </Select>
                    </f:fields>
                  </f:FormElement>
                </f:formElements>
              </f:FormContainer>
              <f:FormContainer>
                <f:formElements>
                  <f:FormElement>
                    <f:label>
                      <Label text="Estado" />
                    </f:label>
                    <f:fields>
                      <Select selectedKey="{create>/estado}" change=".onEstadoChange">
                        <core:Item key="ACTIVO" text="Activo" />
                        <core:Item key="VENDIDO" text="Vendido" />
                        <core:Item key="PRESTADO" text="Prestado" />
                        <core:Item key="RETIRADO" text="Retirado" />
                        <core:Item key="FALLECIDO" text="Fallecido" />
                      </Select>
                    </f:fields>
                  </f:FormElement>
                  <f:FormElement>
                    <f:label>
                      <Label text="Ubicación" />
                    </f:label>
                    <f:fields>
                      <Input value="{create>/ubicacion}" placeholder="Ubicación actual" />
                    </f:fields>
                  </f:FormElement>
                  <f:FormElement>
                    <f:label>
                      <Label text="Calificación" />
                    </f:label>
                    <f:fields>
                      <Select selectedKey="{create>/categoria}">
                        <core:Item key="PESIMO" text="Pésimo" />
                        <core:Item key="REGULAR" text="Regular" />
                        <core:Item key="BUENO" text="Bueno" />
                        <core:Item key="EXCELENTE" text="Excelente" />
                        <core:Item key="EXTRAORDINARIO" text="Extraordinario" />
                      </Select>
                    </f:fields>
                  </f:FormElement>
                  <f:FormElement>
                    <f:label>
                      <Label text="Padrote" />
                    </f:label>
                    <f:fields>
                      <CheckBox selected="{create>/padrote}" class="formCheckBoxField" />
                    </f:fields>
                  </f:FormElement>
                  <f:FormElement visible="{= ${create>/estado} === 'FALLECIDO' }">
                    <f:label>
                      <Label text="Fecha de fallecimiento" required="true"
                        visible="{= ${create>/estado} === 'FALLECIDO' }" />
                    </f:label>
                    <f:fields>
                      <DatePicker value="{create>/fechaFallecimiento}"
                        valueFormat="yyyy-MM-dd" displayFormat="dd/MM/yyyy"
                        placeholder="Seleccionar fecha"
                        valueState="{create>/fechaFallecimientoState}"
                        valueStateText="La fecha de fallecimiento es requerida"
                        visible="{= ${create>/estado} === 'FALLECIDO' }" />
                    </f:fields>
                  </f:FormElement>
                </f:formElements>
              </f:FormContainer>
            </f:formContainers>
          </f:Form>
        </Panel>

        <!-- Características físicas -->
        <Panel headerText="Características" expandable="true" expanded="true"
          class="sapUiSmallMarginTop">
          <f:Form editable="true" class="sapUiSmallMargin">
            <f:layout>
              <f:ResponsiveGridLayout
                labelSpanXL="3"
                labelSpanL="3"
                labelSpanM="4"
                labelSpanS="12"
                emptySpanXL="0"
                emptySpanL="0"
                emptySpanM="0"
                emptySpanS="0"
                columnsXL="2"
                columnsL="2"
                columnsM="1"
                singleContainerFullSize="false" />
            </f:layout>
            <f:formContainers>
              <f:FormContainer>
                <f:formElements>
                  <f:FormElement>
                    <f:label>
                      <Label text="Raza" />
                    </f:label>
                    <f:fields>
                      <Input value="{create>/raza}" placeholder="Raza" />
                      <!-- <Select id="razaSelect" selectedKey="{create>/raza_ID}"
                                items="{razas>/}">
                                    <core:Item key="{razas>ID}" text="{razas>nombre}"/>
                                </Select> -->
                    </f:fields>
                  </f:FormElement>
                  <f:FormElement>
                    <f:label>
                      <Label text="Color" />
                    </f:label>
                    <f:fields>
                      <Input value="{create>/color}" placeholder="Color" />
                      <!-- <Select id="colorSelect" selectedKey="{create>/color_ID}"
                                items="{colores>/}">
                                    <core:Item key="{colores>ID}" text="{colores>nombre}"/>
                                </Select> -->
                    </f:fields>
                  </f:FormElement>
                  <f:FormElement>
                    <f:label>
                      <Label text="Tipo Ave" />
                    </f:label>
                    <f:fields>
                      <Input value="{create>/tipoAve}" placeholder="Tipo Ave" />
                    </f:fields>
                  </f:FormElement>
                </f:formElements>
              </f:FormContainer>
              <f:FormContainer>
                <f:formElements>
                  <f:FormElement>
                    <f:label>
                      <Label text="Línea principal" />
                    </f:label>
                    <f:fields>
                      <ComboBox
                        selectedKey="{create>/linea_ID}"
                        placeholder="Selecciona una línea"
                        showClearIcon="true"
                        items="{lineas>/}">
                        <core:Item key="{lineas>ID}" text="{lineas>nombre}" />
                      </ComboBox>
                    </f:fields>
                  </f:FormElement>
                  <f:FormElement>
                    <f:label>
                      <Label text="Fecha Nacimiento" required="true" />
                    </f:label>
                    <f:fields>
                      <DatePicker value="{create>/fechaNacimiento}" valueFormat="yyyy-MM-dd"
                        displayFormat="dd/MM/yyyy" valueState="{create>/fecNacState}"
                        valueStateText="La fecha de nacimiento es requerida" />
                    </f:fields>
                  </f:FormElement>
                  <f:FormElement>
                    <f:label>
                      <Label text="Fecha Compra" />
                    </f:label>
                    <f:fields>
                      <DatePicker value="{create>/fechaCompra}" valueFormat="yyyy-MM-dd"
                        displayFormat="dd/MM/yyyy" />
                    </f:fields>
                  </f:FormElement>
                </f:formElements>
              </f:FormContainer>
            </f:formContainers>
          </f:Form>
        </Panel>

