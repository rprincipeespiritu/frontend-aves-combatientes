                            <CustomListItem>
                                <HBox alignItems="Center" justifyContent="SpaceBetween" class="sapUiTinyMargin">
                                    <HBox alignItems="Center">
                                        <ObjectStatus
                                            icon="{= ${create>tipo} === 'IMAGEN' ? 'sap-icon://picture' : 'sap-icon://video'}"
                                            state="Information" />
