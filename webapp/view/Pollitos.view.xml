<mvc:View
    controllerName="com.rprincipees.registroavescombate.controller.Pollitos"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.f">

    <Page title="Gestion de Aves Jóvenes" titleAlignment="Center" showNavButton="true"
        navButtonPress="onNavBack">
        <headerContent>
            <Button icon="sap-icon://home" press="onNavWelcome" type="Emphasized" />
            <f:Avatar
                id="userAvatar"
                src="{user>/foto}"
                displaySize="XS"
                press="onUserMenuPress"
                class="sapUiTinyMarginBegin sapUiTinyMarginEnd" />
        </headerContent>

        <content>
            <VBox width="100%">
                <OverflowToolbar width="100%">
                    <!-- <Title text="Gestion de Pollitos" level="H2" /> -->
                    <ToolbarSpacer />
                    <Button text="Agregar Ave Jóven" icon="sap-icon://add" type="Emphasized"
                        press="onAgregarPollito" />
                    <Button text="Refrescar" icon="sap-icon://refresh" press="onRefrescar" />
                </OverflowToolbar>

                <Panel headerText="Filtros" expandable="true" expanded="false" width="100%">
                    <content>
                        <FlexBox wrap="Wrap" alignItems="Center" renderType="Div">
                            <items>
                                <SearchField
                                    id="searchField"
                                    placeholder="Buscar por cintillo o nombre"
                                    width="100%"
                                    search="onBuscar"
                                    liveChange="onBuscar"
                                    class="sapUiTinyMarginEnd sapUiTinyMarginBottom" />
                                <Input
                                    id="colorFilter"
                                    placeholder="Color de cintillo"
                                    width="100%"
                                    liveChange="onBuscar"
                                    class="sapUiTinyMarginEnd sapUiTinyMarginBottom" />
                                <Input
                                    id="temporadaFilter"
                                    placeholder="Temporada"
                                    type="Number"
                                    width="100%"
                                    liveChange="onBuscar"
                                    class="sapUiTinyMarginEnd sapUiTinyMarginBottom" />
                                <Input
                                    id="padreFilter"
                                    placeholder="Padre"
                                    width="100%"
                                    showValueHelp="true"
                                    valueHelpRequest="onValueHelpFiltroPadre"
                                    liveChange="onBuscar"
                                    class="sapUiTinyMarginEnd sapUiTinyMarginBottom" />
                                <Input
                                    id="madreFilter"
                                    placeholder="Madre"
                                    width="100%"
                                    showValueHelp="true"
                                    valueHelpRequest="onValueHelpFiltroMadre"
                                    liveChange="onBuscar"
                                    class="sapUiTinyMarginEnd sapUiTinyMarginBottom" />
                                <Button text="Limpiar Filtros" press="onLimpiarFiltros"
                                    class="sapUiTinyMarginBottom" />
                            </items>
                        </FlexBox>
                    </content>
                </Panel>
                <Panel>
                    <Table
                        id="pollitosTable"
                        width="100%"
                        inset="false"
                        busy="{table>/busy}"
                        items="{pollitos>/value}"
                        visible="{= !${device>/system/phone} }"
                        class="sapUiMediumMarginTop">

                        <headerToolbar>
                            <OverflowToolbar>
                                <Title text="Pollitos registrados ({= ${pollitos>/value}.length})" />
                                <ToolbarSpacer />
                                <Button text="Exportar a Excel" icon="sap-icon://excel-attachment"
                                    press="onExportarExcel" type="Emphasized" />
                            </OverflowToolbar>
                        </headerToolbar>

                        <columns>
                            <Column width="6rem">
                                <Text text="Cintillo" />
                            </Column>
                            <Column minScreenWidth="Tablet" demandPopin="true" width="6rem">
                                <Text text="Color cintillo" />
                            </Column>
                            <Column width="8rem">
                                <Text text="Placa" />
                            </Column>
                            <Column minScreenWidth="Tablet" demandPopin="true">
                                <Text text="Temporada" />
                            </Column>
                            <Column minScreenWidth="Tablet" demandPopin="true" visible="{= ${device>/system/phone} ? false : true}">
                                <Text text="Nombre" />
                            </Column>
                            <Column minScreenWidth="Tablet" demandPopin="true" visible="{= ${device>/system/phone} ? false : true}">
                                <Text text="Genero" />
                            </Column>
                            <Column minScreenWidth="Tablet" demandPopin="true" visible="{= ${device>/system/phone} ? false : true}">
                                <Text text="Fecha Nac." />
                            </Column>
                            <Column minScreenWidth="Tablet" demandPopin="true">
                                <Text text="Padre" />
                            </Column>
                            <Column minScreenWidth="Tablet" demandPopin="true">
                                <Text text="Madre" />
                            </Column>
                            <Column minScreenWidth="Tablet" demandPopin="true" visible="{= ${device>/system/phone} ? false : true}">
                                <Text text="Estado" />
                            </Column>
                            <Column width="8rem" hAlign="Center">
                                <Text text="Acciones" />
                            </Column>
                        </columns>

                        <items>
                            <ColumnListItem type="Navigation" press="onPollitoPress">
                                <cells>
                                    <ObjectStatus text="{pollitos>cintillo}" state="Information" />
                                    <ObjectStatus text="{pollitos>colorCintillo}" state="Information" />
                                    <ObjectStatus text="{pollitos>aveGenerada/placa}" state="Information" />
                                    <Text text="{pollitos>temporada}" />
                                    <Text text="{pollitos>nombre}" />
                                    <Text
                                        text="{path: 'pollitos>sexo', formatter: '.formatearSexo'}" />
                                    <Text
                                        text="{path: 'pollitos>fechaNacimiento', formatter: '.formatearFecha'}" />
                                    <VBox>
                                        <Text text="{pollitos>padre/placa}" />
                                        <Text text="{pollitos>padre/nombre}" />
                                    </VBox>
                                    <VBox>
                                        <Text text="{pollitos>madre/placa}" />
                                        <Text text="{pollitos>madre/nombre}" />
                                    </VBox>
                                    <ObjectStatus
                                        text="{path: 'pollitos>estado', formatter: '.formatearEstado'}"
                                        state="{= ${pollitos>estado} === 'REGISTRADA_ADULTA' ? 'Success' : 'Information'}" />
                                    <HBox justifyContent="Center" width="100%" renderType="Bare"  visible="{= ${pollitos>estado} === 'REGISTRADA_ADULTA' ? false : true}">
                                        <!-- <Button
                                        icon="sap-icon://accept"
                                        type="Emphasized"
                                        tooltip="Registrar como ave adulta"
                                        press="onRegistrarComoAveAdulta"
                                        visible="{= ${pollitos>estado} !== 'REGISTRADA_ADULTA'}" /> -->
                                        <Button icon="sap-icon://edit" type="Emphasized"
                                            tooltip="Editar" press="onEditarPollito" />
                                        <Button icon="sap-icon://delete" type="Transparent"
                                            tooltip="Eliminar" press="onEliminarPollito" />
                                    </HBox>
                                </cells>
                            </ColumnListItem>
                        </items>
                    </Table>

                    <List
                        id="pollitosMobileList"
                        busy="{table>/busy}"
                        items="{pollitos>/value}"
                        noDataText="Sin datos"
                        visible="{device>/system/phone}"
                        class="pollitosMobileList sapUiSmallMarginTop">
                        <headerToolbar>
                            <OverflowToolbar>
                                <Title text="Pollitos registrados ({= ${pollitos>/value}.length})" />
                                <ToolbarSpacer />
                                <Button
                                    text="Excel"
                                    icon="sap-icon://excel-attachment"
                                    press="onExportarExcel"
                                    type="Emphasized" />
                            </OverflowToolbar>
                        </headerToolbar>
                        <items>
                            <CustomListItem
                                type="Navigation"
                                press="onPollitoPress"
                                class="pollitoMobileItem">
                                <VBox class="pollitoMobileCard">
                                    <HBox
                                        alignItems="Start"
                                        justifyContent="SpaceBetween"
                                        class="pollitoMobileHeader">
                                        <VBox>
                                            <Label text="Cintillo" design="Bold" />
                                            <ObjectStatus text="{pollitos>cintillo}" state="Information" />

                                            <Label text="Placa" design="Bold"/>
                                            <ObjectStatus text="{pollitos>aveGenerada/placa}" state="Information" />

                                            <!-- <Text
                                                text="{pollitos>aveGenerada/placa}"
                                                class="pollitoMobilePlate" /> -->
                                        </VBox>
                                        <HBox
                                            alignItems="Center"
                                            renderType="Bare"
                                            class="pollitoMobileActions"
                                            visible="{= ${pollitos>estado} === 'REGISTRADA_ADULTA' ? false : true}">
                                            <Button
                                                icon="sap-icon://edit"
                                                type="Emphasized"
                                                tooltip="Editar"
                                                press="onEditarPollito" />
                                            <Button
                                                icon="sap-icon://delete"
                                                type="Transparent"
                                                tooltip="Eliminar"
                                                press="onEliminarPollito" />
                                        </HBox>
                                    </HBox>

                                    <FlexBox
                                        wrap="Wrap"
                                        renderType="Div"
                                        class="pollitoMobileGrid">
                                        <VBox class="pollitoMobileField">
                                            <Label text="Color cintillo" />
                                            <ObjectStatus text="{pollitos>colorCintillo}" state="Information" />
                                        </VBox>
                                        <VBox class="pollitoMobileField">
                                            <Label text="Temporada" />
                                            <Text text="{pollitos>temporada}" />
                                        </VBox>
                                        <!--<VBox class="pollitoMobileField">
                                            <Label text="Nombre" />
                                            <Text text="{pollitos>nombre}" />
                                        </VBox>
                                        <VBox class="pollitoMobileField">
                                            <Label text="Genero" />
                                            <Text text="{path: 'pollitos>sexo', formatter: '.formatearSexo'}" />
                                        </VBox>
                                        <VBox class="pollitoMobileField">
                                            <Label text="Fecha Nac." />
                                            <Text text="{path: 'pollitos>fechaNacimiento', formatter: '.formatearFecha'}" />
                                        </VBox>
                                        <VBox class="pollitoMobileField">
                                            <Label text="Estado" />
                                            <ObjectStatus
                                                text="{path: 'pollitos>estado', formatter: '.formatearEstado'}"
                                                state="{= ${pollitos>estado} === 'REGISTRADA_ADULTA' ? 'Success' : 'Information'}" />
                                        </VBox>-->
                                        <VBox class="pollitoMobileField pollitoMobileFieldWide">
                                            <Label text="Padre" />
                                            <Text text="{pollitos>padre/placa}" />
                                            <Text text="{pollitos>padre/nombre}" class="pollitoMobileMuted" />
                                        </VBox>
                                        <VBox class="pollitoMobileField pollitoMobileFieldWide">
                                            <Label text="Madre" />
                                            <Text text="{pollitos>madre/placa}" />
                                            <Text text="{pollitos>madre/nombre}" class="pollitoMobileMuted" />
                                        </VBox>
                                    </FlexBox>
                                </VBox>
                            </CustomListItem>
                        </items>
                    </List>
                </Panel>
            </VBox>
        </content>

        <footer>
            <Toolbar>
                <ToolbarSpacer />
                <Button text="Cancelar" press="onNavBack" />
            </Toolbar>
        </footer>
    </Page>
</mvc:View>
