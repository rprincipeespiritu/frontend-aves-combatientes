<mvc:View
    controllerName="com.rprincipees.registroavescombate.controller.Pollitos"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:form="sap.ui.layout.form"
    xmlns:f="sap.f">

    <Page title="Gestion de Aves Jóvenes o Recién Nacidos" titleAlignment="Center" showNavButton="true"
        navButtonPress="onNavBack">
        <headerContent>
            <Button icon="sap-icon://home" press="onNavWelcome" type="Emphasized" />
            <f:Avatar
                id="userAvatar"
                src="{user>/foto}"
                displaySize="XS"
                press="onUserMenuPress"
                class="sapUiTinyMarginBegin sapUiTinyMarginEnd" />
        </headerContent>

        <content>
            <VBox width="100%">
                <OverflowToolbar width="100%">
                    <!-- <Title text="Gestion de Pollitos" level="H2" /> -->
                    <ToolbarSpacer />
                    <Button text="Agregar Ave Jóven o Recién Nacido" icon="sap-icon://add" type="Emphasized"
                        press="onAgregarPollito" />
                    <Button text="Refrescar" icon="sap-icon://refresh" press="onRefrescar" />
                </OverflowToolbar>

                <Panel headerText="Filtros" expandable="true" expanded="{= ${device>/system/phone} ? 'false' : 'true'}" width="100%">
                    <content>
                        <form:Form editable="true" class="sapUiSmallMargin">
                            <form:layout>
                                <form:ResponsiveGridLayout
                                    labelSpanXL="3" labelSpanL="3" labelSpanM="4" labelSpanS="12"
                                    emptySpanXL="0" emptySpanL="0" emptySpanM="0" emptySpanS="0"
                                    columnsXL="3" columnsL="2" columnsM="2"
                                    singleContainerFullSize="false" />
                            </form:layout>
                            <form:formContainers>
                                <form:FormContainer>
                                    <form:formElements>
                                        <form:FormElement label="Buscar">
                                            <form:fields>
                                                <SearchField id="searchField" placeholder="Buscar por cintillo o nombre" width="100%" search="onBuscar" liveChange="onBuscar" />
                                            </form:fields>
                                        </form:FormElement>
                                        <form:FormElement label="Color de cintillo">
                                            <form:fields>
                                                <Input id="colorFilter" placeholder="Color de cintillo" width="100%" liveChange="onBuscar" />
                                            </form:fields>
                                        </form:FormElement>
                                        <form:FormElement label="Temporada">
                                            <form:fields>
                                                <Input id="temporadaFilter" placeholder="Temporada" type="Number" width="100%" liveChange="onBuscar" />
                                            </form:fields>
                                        </form:FormElement>
                                    </form:formElements>
                                </form:FormContainer>
                                <form:FormContainer>
                                    <form:formElements>
                                        <form:FormElement label="Padre">
                                            <form:fields>
                                                <Input id="padreFilter" placeholder="Padre" width="100%" showValueHelp="true" valueHelpRequest="onValueHelpFiltroPadre" liveChange="onBuscar" />
                                            </form:fields>
                                        </form:FormElement>
                                        <form:FormElement label="Madre">
                                            <form:fields>
                                                <Input id="madreFilter" placeholder="Madre" width="100%" showValueHelp="true" valueHelpRequest="onValueHelpFiltroMadre" liveChange="onBuscar" />
                                            </form:fields>
                                        </form:FormElement>
                                        <form:FormElement label="Estado">
                                            <form:fields>
                                                <ComboBox id="estadoFilter" placeholder="Filtrar por Estado" width="100%" selectionChange="onBuscar">
                                                    <core:Item key="ACTIVO" text="Activo" />
                                                    <core:Item key="FALLECIDO" text="Fallecido" />
                                                    <core:Item key="VENDIDO" text="Vendido" />
                                                    <core:Item key="OBSEQUIADO" text="Obsequiado" />
                                                </ComboBox>
                                            </form:fields>
                                        </form:FormElement>
                                        <form:FormElement>
                                            <form:fields>
                                                <Button text="Limpiar Filtros" icon="sap-icon://clear-filter" press="onLimpiarFiltros" />
                                            </form:fields>
                                        </form:FormElement>
                                    </form:formElements>
                                </form:FormContainer>
                                <!-- <form:FormContainer>
                                    <form:formElements>
                                        <form:FormElement label="Madre">
                                            <form:fields>
                                                <Input id="madreFilter" placeholder="Madre" width="100%" showValueHelp="true" valueHelpRequest="onValueHelpFiltroMadre" liveChange="onBuscar" />
                                            </form:fields>
                                        </form:FormElement>
                                        <form:FormElement>
                                            <form:fields>
                                                <Button text="Limpiar Filtros" icon="sap-icon://clear-filter" press="onLimpiarFiltros" />
                                            </form:fields>
                                        </form:FormElement>
                                    </form:formElements>
                                </form:FormContainer> -->
                            </form:formContainers>
                        </form:Form>
                    </content>
                </Panel>
                <ScrollContainer
                    id="pollitosTableScroll"
                    width="100%"
                    vertical="true"
                    horizontal="true"
                    visible="{= !${device>/system/phone} }"
                    class="listadoTablaScroll sapUiMediumMarginTop">
                    <Table
                        id="pollitosTable"
                        width="100%"
                        inset="false"
                        busy="{table>/busy}"
                        items="{pollitos>/value}"
                        sticky="ColumnHeaders,HeaderToolbar"
                        class="listadoTabla">

                        <headerToolbar>
                            <OverflowToolbar>
                                <Title text="Pollitos registrados ({pollitos>/filteredCount})" />
                                <ToolbarSpacer />
                                <Button text="Exportar a Excel" icon="sap-icon://excel-attachment"
                                    press="onExportarExcel" type="Emphasized" tooltip="Exportar a Excel" />
                            </OverflowToolbar>
                        </headerToolbar>

                        <columns>
                            <Column width="6rem">
                                <Text text="Cintillo" />
                            </Column>
                            <Column minScreenWidth="Tablet" demandPopin="true" width="6rem">
                                <Text text="Color cintillo" />
                            </Column>
                            <Column width="8rem">
                                <Text text="Placa" />
                            </Column>
                            <Column minScreenWidth="Tablet" demandPopin="true">
                                <Text text="Temporada" />
                            </Column>
                            <Column minScreenWidth="Tablet" demandPopin="true" visible="{= ${device>/system/phone} ? false : true}">
                                <Text text="Nombre" />
                            </Column>
                            <Column minScreenWidth="Tablet" demandPopin="true" visible="{= ${device>/system/phone} ? false : true}">
                                <Text text="Genero" />
                            </Column>
                            <Column minScreenWidth="Tablet" demandPopin="true" visible="{= ${device>/system/phone} ? false : true}">
                                <Text text="Fecha Nac." />
                            </Column>
                            <Column minScreenWidth="Tablet" demandPopin="true">
                                <Text text="Padre" />
                            </Column>
                            <Column minScreenWidth="Tablet" demandPopin="true">
                                <Text text="Madre" />
                            </Column>
                            <Column minScreenWidth="Tablet" demandPopin="true" visible="{= ${device>/system/phone} ? false : true}">
                                <Text text="Estado" />
                            </Column>
                        </columns>

                        <items>
                            <ColumnListItem type="Navigation" press="onPollitoPress">
                                <cells>
                                    <ObjectStatus text="{pollitos>cintillo}" state="Information" />
                                    <ObjectStatus text="{pollitos>colorCintillo}" state="Information" />
                                    <ObjectStatus text="{pollitos>aveGenerada/placa}" state="Information" />
                                    <Text text="{pollitos>temporada}" />
                                    <Text text="{pollitos>nombre}" />
                                    <Text
                                        text="{path: 'pollitos>sexo', formatter: '.formatearSexo'}" />
                                    <Text
                                        text="{path: 'pollitos>fechaNacimiento', formatter: '.formatearFecha'}" />
                                    <VBox>
                                        <Text text="{pollitos>padre/placa}" />
                                        <Text text="{pollitos>padre/nombre}" />
                                    </VBox>
                                    <VBox>
                                        <Text text="{pollitos>madre/placa}" />
                                        <Text text="{pollitos>madre/nombre}" />
                                    </VBox>
                                    <ObjectStatus
                                        text="{path: 'pollitos>estado', formatter: '.formatearEstadoAveText'}"
                                        state="{path: 'pollitos>estado', formatter: '.formatearEstadoState'}" />
                                </cells>
                            </ColumnListItem>
                        </items>
                    </Table>
                </ScrollContainer>

                    <List
                        id="pollitosMobileList"
                        busy="{table>/busy}"
                        items="{pollitos>/value}"
                        noDataText="Sin datos"
                        visible="{device>/system/phone}"
                        class="pollitosMobileList sapUiSmallMarginTop">
                        <headerToolbar>
                            <OverflowToolbar>
                                <Title text="Pollitos registrados ({pollitos>/filteredCount})" />
                                <ToolbarSpacer />
                                <Button
                                    text=""
                                    icon="sap-icon://excel-attachment"
                                    press="onExportarExcel"
                                    type="Emphasized"
                                    tooltip="Exportar a Excel" />
                            </OverflowToolbar>
                        </headerToolbar>
                        <items>
                            <CustomListItem
                                type="Navigation"
                                press="onPollitoPress"
                                class="pollitoMobileItem">
                                <VBox class="pollitoMobileCard">
                                    <HBox
                                        alignItems="Start"
                                        justifyContent="SpaceBetween"
                                        class="pollitoMobileHeader">
                                        <VBox>
                                            <Label text="Cintillo" design="Bold" />
                                            <ObjectStatus text="{pollitos>cintillo}" state="Information" />

                                            <Label text="Placa" design="Bold"/>
                                            <ObjectStatus text="{pollitos>aveGenerada/placa}" state="Information" />
                                        </VBox>
                                        <VBox alignItems="End" class="pollitoMobileEstado">
                                            <Label text="Estado" design="Bold" />
                                            <ObjectStatus
                                                text="{path: 'pollitos>estado', formatter: '.formatearEstadoAveText'}"
                                                state="{path: 'pollitos>estado', formatter: '.formatearEstadoState'}" />
                                        </VBox>
                                    </HBox>

                                    <FlexBox
                                        wrap="Wrap"
                                        renderType="Div"
                                        class="pollitoMobileGrid">
                                        <VBox class="pollitoMobileField">
                                            <Label text="Color cintillo" />
                                            <ObjectStatus text="{pollitos>colorCintillo}" state="Information" />
                                        </VBox>
                                        <VBox class="pollitoMobileField">
                                            <Label text="Temporada" />
                                            <Text text="{pollitos>temporada}" />
                                        </VBox>
                                        <VBox class="pollitoMobileField">
                                            <Label text="Padre" />
                                            <Text text="{pollitos>padre/placa}" />
                                            <Text text="{pollitos>padre/nombre}" class="pollitoMobileMuted" />
                                        </VBox>
                                        <VBox class="pollitoMobileField">
                                            <Label text="Madre" />
                                            <Text text="{pollitos>madre/placa}" />
                                            <Text text="{pollitos>madre/nombre}" class="pollitoMobileMuted" />
                                        </VBox>
                                    </FlexBox>
                                </VBox>
                            </CustomListItem>
                        </items>
                    </List>
            </VBox>
        </content>

        <footer>
            <Toolbar>
                <ToolbarSpacer />
                <Button text="Cancelar" press="onNavBack" />
            </Toolbar>
        </footer>
    </Page>
</mvc:View>
